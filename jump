# Validate a netifrename action section.
# Required keys: target (filesystem action reference), interface (network
# interface name or %variable% reference), name (new interface name).
# The MAC address is auto-determined at runtime from the specified interface.
validate_action_netifrename() {
   local section="$1"
   local valid=0

   validate_instance_name "$section" "netifrename" || ((valid++))

   validate_target_reference "$section" || ((valid++))

   if ! has_key "$section" "interface"; then
      printf '%s\n' "error: [${section}] missing required key 'interface'" >&2
      ((valid++))
   fi

   # If interface is a %variable% reference, validate the variable exists
   if has_key "$section" "interface"; then
      local iface_val
      iface_val="$(get_value "$section" "interface")"
      local ref
      ref="$(parse_single_reference "$iface_val")" || ref=""
      if [[ -n "$ref" ]]; then
         # Built-in references: %active% and %mac:XX:XX:XX:XX:XX:XX%
         if [[ "$ref" == "active" ]]; then
            : # valid built-in
         elif [[ "$ref" =~ ^mac:([0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5})$ ]]; then
            : # valid built-in
         else
            # Extract base variable name (strip array index if present)
            local varname="$ref"
            if [[ "$ref" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)\[([0-9]+)\]$ ]]; then
               varname="${BASH_REMATCH[1]}"
            fi
            if ! validate_variable "$varname" "netinterface"; then
               printf '%s\n' "error: [${section}] 'interface' references variable '${varname}' \
                  which is not defined by a [userinput.netinterface.*] section" >&2
               ((valid++))
            fi
         fi
      fi
   fi

   if ! has_key "$section" "name"; then
      printf '%s\n' "error: [${section}] missing required key 'name'" >&2
      ((valid++))
   fi

   # Validate name is a valid Linux network interface name
   if has_key "$section" "name"; then
      local name_val
      name_val="$(get_value "$section" "name")"
      if [[ ! "$name_val" =~ ^[a-zA-Z][a-zA-Z0-9_]*$ ]]; then
         printf '%s\n' "error: [${section}] 'name' must be a valid network interface name \
            (alphanumeric and underscore, starting with a letter)" >&2
         ((valid++))
      fi
   fi

   return $valid
}

# Runtime sanity check for netifrename action.
# Verifies the target filesystem tools exist and the specified interface
# is present on the running system with a readable MAC address.
sanity_check_netifrename() {
   local section="$1"

   if has_key "$section" "target"; then
      local target
      target="$(get_value "$section" "target")"
      sanity_check_target_filesystem "$target" "$section" || return 1
   fi

   # Check that the referenced interface exists on the running system
   if has_key "$section" "interface"; then
      local iface_val
      iface_val="$(get_value "$section" "interface")"
      local ref
      ref="$(parse_single_reference "$iface_val")" || ref=""
      local iface_name="$iface_val"
      # Resolve variable references and built-in references
      if [[ -n "$ref" ]]; then
         if [[ "$ref" == "active" ]]; then
            expand_value "$iface_val"; iface_name="$_expand_value_result"
         elif [[ "$ref" =~ ^mac:[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}$ ]]; then
            expand_value "$iface_val"; iface_name="$_expand_value_result"
         else
            # Variable reference — resolve if ANSWERS is populated
            local varname="$ref"
            if [[ "$ref" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)\[([0-9]+)\]$ ]]; then
               varname="${BASH_REMATCH[1]}"
            fi
            if [[ -n "$varname" ]] && [[ -n "${ANSWERS[$varname]+x}" ]]; then
               expand_value "$iface_val"; iface_name="$_expand_value_result"
            fi
         fi
      fi

      # Only check if the interface name is known (not still a %var% reference)
      if [[ ! "$iface_name" == %* ]]; then
         if [[ ! -d "/sys/class/net/${iface_name}" ]]; then
            msg_error "Interface '${iface_name}' not found on this system."
            return 1
         fi
         if [[ ! -r "/sys/class/net/${iface_name}/address" ]]; then
            msg_error "Cannot read MAC address for interface '${iface_name}'."
            return 1
         fi
      fi
   fi

   return 0
}

# Callback body for run_action_netifrename via with_target_mount.
_do_netifrename() {
   local mount_point="$1" resolved_name="$2" target_type="$3" \
      section="$4" orig_name="$5" mac_addr="$6" new_name="$7"

   # Create /etc/systemd/network/ directory if needed
   local net_dir="${mount_point}/etc/systemd/network"
   log "  Ensuring ${net_dir} exists"
   mkdir -p "$net_dir" || die "[${section}] failed to create ${net_dir}"

   # Write the .link file
   local link_file="${net_dir}/10-${new_name}.link"
   log "  Writing ${link_file}"
   if ! cat > "$link_file" <<-EOF
		[Match]
		MACAddress=${mac_addr}
		OriginalName=${orig_name}

		[Link]
		Name=${new_name}
	EOF
   then
      die "[${section}] failed to write ${link_file}"
   fi
}

# Create a systemd .link file on a target filesystem to rename a network interface.
run_action_netifrename() {
   local section="$1"
   local instance_name="${section#action.netifrename.}"
   if [[ "$instance_name" == "$section" ]]; then
      die "[${section}] has no instance name"
   fi

   if ! has_key "$section" "target"; then
      die "[${section}] missing required key 'target'"
   fi
   local target
   target="$(get_value "$section" "target")"

   if ! has_key "$section" "interface"; then
      die "[${section}] missing required key 'interface'"
   fi
   local iface_val
   iface_val="$(get_value "$section" "interface")"

   if ! has_key "$section" "name"; then
      die "[${section}] missing required key 'name'"
   fi
   local new_name
   new_name="$(get_value "$section" "name")"

   # Resolve interface name (expand %variable% references)
   local orig_name
   expand_value "$iface_val"; orig_name="$_expand_value_result"

   # Read MAC address from the running system
   local mac_addr
   if [[ -r "/sys/class/net/${orig_name}/address" ]]; then
      mac_addr="$(cat "/sys/class/net/${orig_name}/address")"
   else
      die "[${section}] cannot read MAC address for interface '${orig_name}'"
   fi

   with_target_mount "$section" "$target" \
      "Creating .link file for ${orig_name} → ${new_name} on" \
      _do_netifrename "$orig_name" "$mac_addr" "$new_name" \
      || die "[${section}] failed to create .link file"

   log "Network interface rename .link file created: ${orig_name} → ${new_name}"
}

# --- action.crypt (LUKS) ------------------------------------------------

# Validate an action.crypt section.
# Required keys: drive (partition or whole-disk ref / literal), passphrase
# (must contain at least one %variable% reference, like action.password).
# Optional: options (extra cryptsetup luksFormat args).
# Parameters: $1 - section name
# Returns: number of errors found
validate_action_crypt() {
   local section="$1"
   local valid=0

   validate_instance_name "$section" "crypt" || ((valid++))

   validate_drive_reference "$section" "drive" || ((valid++))

   if ! has_key "$section" "passphrase"; then
      printf '%s\n' "error: [${section}] missing required key 'passphrase'" >&2
      ((valid++))
   else
      # Require at least one variable reference so a literal passphrase is
      # never stored in the config or written to logs.
      local passphrase_val refs
      passphrase_val="$(get_value "$section" "passphrase")"
      refs="$(extract_references "$passphrase_val")"
      if [[ -z "$refs" ]]; then
         printf '%s\n' "error: [${section}] 'passphrase' must reference a userinput variable" \
            "(e.g. %varname%), got '${passphrase_val}'" >&2
         ((valid++))
      else
         local ref
         while IFS= read -r ref; do
            [[ -z "$ref" ]] && continue
            if ! validate_variable "$ref"; then
               printf '%s\n' "error: [${section}] 'passphrase' references variable '${ref}'" \
                  "which is not defined by any [userinput.*] section" >&2
               ((valid++))
            fi
         done <<< "$refs"
      fi
   fi

   return $valid
}

# Runtime sanity check for action.crypt.
# Verifies cryptsetup is available and the referenced drive exists (or will be
# created by an earlier action).
# Parameters: $1 - section name
# Returns: 0 if ok, 1 if cryptsetup missing or device absent
sanity_check_crypt() {
   local section="$1"

   if ! command -v cryptsetup &>/dev/null; then
      msg_error "cryptsetup is required but not found on this system."
      return 1
   fi

   if has_key "$section" "drive"; then
      local drive_val
      drive_val="$(get_value "$section" "drive")"
      check_drive_ref_exists "$drive_val" "$section" || return 1
   fi

   return 0
}

# Create a LUKS-encrypted device (cryptsetup luksFormat). The device is NOT
# opened here; it is opened lazily by ensure_crypt_open the first time a later
# action references it via a crypt.<instance> back-reference.
# Parameters: $1 - section name
run_action_crypt() {
   local section="$1"
   local instance_name="${section#action.crypt.}"
   if [[ "$instance_name" == "$section" ]]; then
      die "[${section}] has no instance name"
   fi

   if ! has_key "$section" "drive"; then
      die "[${section}] missing required key 'drive'"
   fi
   if ! has_key "$section" "passphrase"; then
      die "[${section}] missing required key 'passphrase'"
   fi

   local drive_val passphrase_val drive passphrase
   drive_val="$(get_value "$section" "drive")"
   passphrase_val="$(get_value "$section" "passphrase")"
   # Resolve drive (no crypt nesting expected, but reuse the helper anyway).
   resolve_drive_value "$drive_val"; drive="$_resolve_drive_value"
   local -a _d=()
   read -ra _d <<< "$drive"
   drive="${_d[0]:-}"
   if [[ -z "$drive" ]]; then
      die "[${section}] 'drive' resolves to an empty device path"
   fi
   expand_value "$passphrase_val"; passphrase="$_expand_value_result"
   if [[ -z "$passphrase" ]]; then
      die "[${section}] 'passphrase' resolves to an empty value"
   fi

   # Feed the passphrase via a temp key-file so it never appears in argv.
   local keyfile
   keyfile="$(mktemp)"
   TEMP_FILES+=("$keyfile")
   chmod 600 "$keyfile"
   printf '%s' "$passphrase" > "$keyfile"

   local -a cmd=(cryptsetup luksFormat --key-file "$keyfile")
   if has_key "$section" "options"; then
      local options
      options="$(get_value "$section" "options")"
      local -a opts=()
      read -ra opts <<< "$options"
      cmd+=("${opts[@]}")
   fi
   cmd+=("$drive")

   log "Creating LUKS device '${instance_name}' on ${drive}"
   log "  Command: ${cmd[*]}"
   run_cmd --stdin /dev/null -- "${cmd[@]}"

   log "LUKS device '${instance_name}' created (not opened)."
}

# Validate an md action section has required keys.
# Parameters: $1 - section name
# Returns: number of errors found
validate_action_md() {
   local section="$1"
   local valid=0

   validate_instance_name "$section" "md" || ((valid++))

   if ! has_key "$section" "device"; then
      printf '%s\n' "error: [${section}] missing required key 'device'" >&2
      ((valid++))
   fi

   if ! has_key "$section" "level"; then
      printf '%s\n' "error: [${section}] missing required key 'level'" >&2
      ((valid++))
   fi

   if ! has_key "$section" "numdevices"; then
      printf '%s\n' "error: [${section}] missing required key 'numdevices'" >&2
      ((valid++))
   else
      local numdevices_val
      numdevices_val="$(get_value "$section" "numdevices")"
      if ! [[ "$numdevices_val" =~ ^[0-9]+$ ]] || ((numdevices_val < 1)); then
         printf '%s\n' "error: [${section}] 'numdevices' must be a positive integer, \
            got '${numdevices_val}'" >&2
         ((valid++))
      fi
   fi

   if ! has_key "$section" "drives"; then
      printf '%s\n' "error: [${section}] missing required key 'drives'" >&2
      ((valid++))
   else
      local drives_val
      drives_val="$(get_value "$section" "drives")"
      # Validate that variable references in drives are defined by sections.
      # userinput.drives
      # Literal device paths and 'missing' keyword are allowed.
      local refs
      refs="$(extract_references "$drives_val")" || refs=""
      while IFS= read -r ref; do
         [[ -z "$ref" ]] && continue
         # Skip built-in references (active, mac:..., diskid:..., disksize:...)
         if [[ "$ref" == "active" ]] || \
            [[ "$ref" == mac:* ]] || \
            [[ "$ref" == diskid:* ]] || \
            [[ "$ref" == disksize:* ]]; then
            continue
         fi
         # Extract variable name from references like varname[idx]part
         # or varname[idx]
         local varname
         if [[ "$ref" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)\[ ]]; then
            varname="${BASH_REMATCH[1]}"
         else
            varname="$ref"
         fi
         if ! validate_variable "$varname" "drives"; then
            printf '%s\n' "error: [${section}] 'drives' refs undefined drive var '${varname}'" >&2
            ((valid++))
         fi
      done <<< "$refs"

      # Validate crypt.<instance> back-reference tokens (literal, not %...%).
      # Scan the raw value to avoid resolving unanswerable drive refs during
      # --validate without an answers file.
      local _tok _arr=()
      read -ra _arr <<< "$drives_val"
      for _tok in "${_arr[@]}"; do
         if is_crypt_ref "$_tok"; then
            validate_crypt_reference "$section" "$_tok" || ((valid++))
         fi
      done
   fi

   return $valid
}

# Runtime sanity check for md action.
# Verifies mdadm is available and referenced devices exist.
# Parameters: $1 - section name
# Returns: 0 if ok, 1 if mdadm missing or device absent
sanity_check_md() {
   local section="$1"

   if ! command -v mdadm &>/dev/null; then
      msg_error "mdadm is required but not found on this system."
      return 1
   fi

   if ! command -v zpool &>/dev/null; then
      msg_error "zpool is required but not found on this system."
      return 1
   fi

   local drives_val
   if ! has_key "$section" "drives"; then
      return 0
   fi
   drives_val="$(get_value "$section" "drives")"

   # Drive references require ANSWERS to be populated; skip the device
   # existence check if any referenced variable is not yet answered.
   # ANSWERS is populated by collect_user_input, which runs after
   # sanity_check in interactive mode.
   if ! refs_resolvable "$drives_val"; then
      return 0
   fi

   # Resolve and check each device reference.
   # Skip literals that are 'missing' — those are valid mdadm device keywords.
   local expanded
   expand_value "$drives_val"; expanded="$_expand_value_result"
   local -a devices=()
   read -ra devices <<< "$expanded"

   for device in "${devices[@]}"; do
      [[ "$device" == "missing" ]] && continue
      # crypt.<instance> back-reference: the mapper is created at runtime by
      # an earlier action.crypt step; skip the existence check.
      if is_crypt_ref "$device"; then
         continue
      fi
      if [[ ! -e "$device" ]]; then
         if is_action_device "$device"; then
            : # Skip check — device will be created by an action
         else
            # Partition devices may not exist yet if action.partition
            # will create them later. Only error if the base device
            # is also missing.
            local base_dev
            base_dev="$(strip_partition "$device")"
            if [[ "$base_dev" != "$device" ]]; then
               local real_base
               real_base="$(readlink -f "$base_dev" 2>/dev/null || \
                  printf '%s' "$base_dev")"
               if [[ -e "$real_base" ]]; then
                  continue
               fi
            fi
            msg_error "Device ${device} referenced in [${section}] does not exist."
            return 1
         fi
      fi
   done

   return 0
}

# Create an MD RAID device as configured.
# Parameters: $1 - section name
# Build the mdadm create command array for an action.md section.
# Sets _cmd_result (array) and _md_device, _md_level, _md_numdevices,
# _md_drives_display (strings) for use by callers.
# Parameters: $1 = section
build_md_cmd() {
   local section="$1"
   _md_device=""
   _md_level=""
   _md_numdevices=""
   _md_drives_display=""
   _cmd_result=()

   if has_key "$section" "device"; then
      _md_device="$(get_value "$section" "device")"
   fi
   if has_key "$section" "level"; then
      _md_level="$(get_value "$section" "level")"
   fi
   if has_key "$section" "numdevices"; then
      _md_numdevices="$(get_value "$section" "numdevices")"
   fi

   local drives_val=""
   if has_key "$section" "drives"; then
      drives_val="$(get_value "$section" "drives")"
   fi

   local expanded
   expand_value "$drives_val"; expanded="$_expand_value_result"
   _md_drives_display="$expanded"
   # Resolve crypt.<instance> back-references (opens the LUKS device on first
   # use) while preserving the display string above.
   resolve_drive_value "$drives_val"; expanded="$_resolve_drive_value"
   local -a devices=()
   read -ra devices <<< "$expanded"

   _cmd_result=(mdadm --create "/dev/${_md_device}" \
      --level="${_md_level}" --raid-devices="${_md_numdevices}" \
      --force --run)

   # Bitmap: default to 'none' to suppress mdadm's interactive prompt.
   if has_key "$section" "bitmap"; then
      local bitmap
      bitmap="$(get_value "$section" "bitmap")"
      _cmd_result+=("--bitmap=${bitmap}")
   else
      _cmd_result+=("--bitmap=none")
   fi

   if has_key "$section" "options"; then
      local options
      options="$(get_value "$section" "options")"
      local -a opts=()
      read -ra opts <<< "$options"
      _cmd_result+=("${opts[@]}")
   fi

   _cmd_result+=("${devices[@]}")
}

run_action_md() {
   local section="$1"

   if ! has_key "$section" "device"; then
      die "[${section}] missing required key 'device'"
   fi
   if ! has_key "$section" "level"; then
      die "[${section}] missing required key 'level'"
   fi
   if ! has_key "$section" "numdevices"; then
      die "[${section}] missing required key 'numdevices'"
   fi
   if ! has_key "$section" "drives"; then
      die "[${section}] missing required key 'drives'"
   fi

   build_md_cmd "$section"

   log "Creating MD RAID device /dev/${_md_device}" \
      "(level=${_md_level}, raid-devices=${_md_numdevices})"
   log "  Command: ${_cmd_result[*]}"
   # Redirect stdin from /dev/null so mdadm fails instead of prompting
   # (e.g. metadata version suggestions). --force suppresses some prompts
   # but not all; without this the command hangs waiting for input.
   run_cmd --stdin /dev/null -- "${_cmd_result[@]}"

   log "MD RAID device /dev/${_md_device} created."

   # Track created MD devices so they can be stopped on exit.
   CREATED_MD_DEVICES+=("/dev/${_md_device}")
}

# Validate an mdadm action section.
# Required key: target (filesystem action reference, e.g. zfs.root_debian)
validate_action_mdadm() {
   local section="$1"
   local valid=0

   validate_instance_name "$section" "mdadm" || ((valid++))

   validate_target_reference "$section" || ((valid++))

