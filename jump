# Write a file to a filesystem previously created by another action.
# The target filesystem is mounted, the file is written with variable
# expansion applied to the content, and the filesystem is unmounted.
# Callback body for run_action_file via with_target_mount.
_do_file() {
   local mount_point="$1" resolved_name="$2" target_type="$3" \
      section="$4" file_path="$5" content="$6"

   # Write the file
   local full_file_path="${mount_point}${file_path}"
   log "  Writing ${full_file_path}"
   # Create parent directory if needed
   mkdir -p "$(dirname "$full_file_path")" \
      || die "failed to create directory $(dirname "$full_file_path")"
   printf '%s\n' "$content" > "$full_file_path" \
      || die "failed to write ${full_file_path}"
}

# Write a file to a target filesystem.
run_action_file() {
   local section="$1"

   if ! has_key "$section" "target"; then
      die "[${section}] missing required key 'target'"
   fi
   local target
   target="$(get_value "$section" "target")"

   if ! has_key "$section" "file"; then
      die "[${section}] missing required key 'file'"
   fi
   local file_path
   file_path="$(get_value "$section" "file")"

   if ! has_key "$section" "content"; then
      die "[${section}] missing required key 'content'"
   fi
   local content
   content="$(get_value "$section" "content")"

   # Expand variable references (%varname% and %%)
   expand_value "$content"; content="$_expand_value_result"

   with_target_mount "$section" "$target" \
      "Writing file ${file_path} to" _do_file "$file_path" "$content" \
      || die "[${section}] failed to write file ${file_path}"

   log "File ${file_path} written successfully."
}

# Validate a filemodify action section.
# Required keys: target, file, action (prepend|append|insert), content.
# Required for insert: anchor.
# Target must reference a supported filesystem action (zfs, ext4, vfat).
validate_action_filemodify() {
   local section="$1"
   local valid=0

   validate_instance_name "$section" "filemodify" || ((valid++))

   validate_target_reference "$section" || ((valid++))

   if ! has_key "$section" "file"; then
      printf '%s\n' "error: [${section}] missing required key 'file'" >&2
      ((valid++))
   fi

   if ! has_key "$section" "action"; then
      printf '%s\n' "error: [${section}] missing required key 'action'" >&2
      ((valid++))
   else
      local action_type
      action_type="$(get_value "$section" "action")"
      if [[ "$action_type" != "prepend" && "$action_type" != "append" &&  \
         "$action_type" != "insert" ]]; then
         printf '%s\n' "error: [${section}] 'action' must be 'prepend', 'append',  \
            or 'insert', got '${action_type}'" >&2
         ((valid++))
      fi
      if [[ "$action_type" == "insert" ]]; then
         if ! has_key "$section" "anchor"; then
            printf '%s\n' "error: [${section}] 'anchor' is required when action is 'insert'" \
               >&2
            ((valid++))
         fi
      fi
   fi

   if ! has_key "$section" "content"; then
      printf '%s\n' "error: [${section}] missing required key 'content'" >&2
      ((valid++))
   fi

   return $valid
}

# Runtime sanity check for filemodify action.
# Verifies target filesystem tools exist and referenced devices are present.
sanity_check_filemodify() {
   local section="$1"

   if has_key "$section" "target"; then
      local target
      target="$(get_value "$section" "target")"
      sanity_check_target_filesystem "$target" "$section" || return 1
   fi

   return 0
}

# Callback body for run_action_filemodify via with_target_mount.
_do_filemodify() {
   local mount_point="$1" resolved_name="$2" target_type="$3" \
      section="$4" file_path="$5" modify_action="$6" content="$7" anchor="$8"

   local full_file_path="${mount_point}${file_path}"

   # Verify the file exists
   if [[ ! -f "$full_file_path" ]]; then
      die "[${section}] file ${file_path} does not exist on target filesystem"
   fi

   # Capture file properties before modification
   local orig_mode=""
   local orig_uid=""
   local orig_gid=""
   orig_mode="$(stat -c '%a' "$full_file_path" 2>/dev/null)" || orig_mode=""
   orig_uid="$(stat -c '%u' "$full_file_path" 2>/dev/null)" || orig_uid=""
   orig_gid="$(stat -c '%g' "$full_file_path" 2>/dev/null)" || orig_gid=""

   # Modify the file based on action type
   log "  Modifying ${full_file_path} (action: ${modify_action})"
   local tmp_file
   tmp_file="$(mktemp)"
   TEMP_FILES+=("$tmp_file")

   case "$modify_action" in
      prepend)
         # Prepend content before existing file
         printf '%s\n' "$content" > "$tmp_file"
         cat "$full_file_path" >> "$tmp_file"
         ;;
      append)
         # Append content after existing file
         cat "$full_file_path" > "$tmp_file"
         # Separate existing content from appended content with a newline
         # tail -c 1 returns the last byte; if non-empty, the file has content
         # that may not end with a newline
         local last_byte
         last_byte="$(tail -c 1 "$tmp_file" 2>/dev/null)"
         if [[ -n "$last_byte" ]]; then
            printf '\n' >> "$tmp_file"
         fi
         printf '%s\n' "$content" >> "$tmp_file"
         ;;
      insert)
         # Insert content after the first line matching the anchor
         local anchor_found=false
         while IFS= read -r line || [[ -n "$line" ]]; do
            printf '%s\n' "$line" >> "$tmp_file"
            if [[ "$anchor_found" == "false" ]] && \
               [[ "$line" == *"${anchor}"* ]]; then
               printf '%s\n' "$content" >> "$tmp_file"
               anchor_found=true
            fi
         done < "$full_file_path"
         if [[ "$anchor_found" == "false" ]]; then
            rm -f "$tmp_file"
            die "[${section}] anchor '${anchor}' not found in ${file_path}"
         fi
         ;;
      *)
         rm -f "$tmp_file"
         die "[${section}] unsupported action '${modify_action}'"
         ;;
   esac

   # Write the modified file back
   if ! mv "$tmp_file" "$full_file_path"; then
      rm -f "$tmp_file"
      die "[${section}] failed to write modified file ${file_path}"
   fi

   # Restore file properties
   if [[ -n "$orig_mode" ]]; then
      chmod "$orig_mode" "$full_file_path" 2>/dev/null || \
         log "WARNING: failed to restore mode ${orig_mode} on ${file_path}"
   fi
   if [[ -n "$orig_uid" ]] && [[ -n "$orig_gid" ]]; then
      chown "${orig_uid}:${orig_gid}" "$full_file_path" 2>/dev/null || \
         log "WARNING: failed to restore ownership ${orig_uid}:${orig_gid} on ${file_path}"
   fi
}

# Modify an existing file on a target filesystem.
# Preserves file properties (mode, ownership).
# Supports: prepend, append, insert (after anchor line).
run_action_filemodify() {
   local section="$1"

   if ! has_key "$section" "target"; then
      die "[${section}] missing required key 'target'"
   fi
   local target
   target="$(get_value "$section" "target")"

   if ! has_key "$section" "file"; then
      die "[${section}] missing required key 'file'"
   fi
   local file_path
   file_path="$(get_value "$section" "file")"

   if ! has_key "$section" "action"; then
      die "[${section}] missing required key 'action'"
   fi
   local modify_action
   modify_action="$(get_value "$section" "action")"

   if ! has_key "$section" "content"; then
      die "[${section}] missing required key 'content'"
   fi
   local content
   content="$(get_value "$section" "content")"

   # Expand variable references (%varname% and %%)
   expand_value "$content"; content="$_expand_value_result"

   local anchor=""
   if [[ "$modify_action" == "insert" ]]; then
      if ! has_key "$section" "anchor"; then
         die "[${section}] 'anchor' is required when action is 'insert'"
      fi
      anchor="$(get_value "$section" "anchor")"
   fi

   with_target_mount "$section" "$target" "Modifying file ${file_path} on" \
      _do_filemodify "$file_path" "$modify_action" "$content" "$anchor" \
      || die "[${section}] failed to modify file ${file_path}"

   log "File ${file_path} modified successfully (action: ${modify_action})."
}

# Validate an sshhostkeys action section.
# Required key: target (filesystem action reference, e.g. zfs.ROOT/debian)
# Optional key: types (space-separated list of key types to generate:
#   rsa, ecdsa, ed25519; default: generate all standard types)
validate_action_sshhostkeys() {
   local section="$1"
   local valid=0

   validate_instance_name "$section" "sshhostkeys" || ((valid++))

   validate_target_reference "$section" || ((valid++))

   if has_key "$section" "types"; then
      local types_val
      types_val="$(get_value "$section" "types")"
      local -a type_list=()
      read -ra type_list <<< "$types_val"
      for kt in "${type_list[@]}"; do
         if [[ "$kt" != "rsa" && "$kt" != "ecdsa" && "$kt" != "ed25519" ]]; then
            printf '%s\n' "error: [${section}] unsupported key type '${kt}' (supported: rsa,  \
               ecdsa, ed25519)" >&2
            ((valid++))
         fi
      done
      if [[ ${#type_list[@]} -eq 0 ]]; then
         printf '%s\n' "error: [${section}] 'types' must not be empty if specified" >&2
         ((valid++))
      fi
   fi

   return $valid
}

# Runtime sanity check for sshhostkeys action.
# Verifies ssh-keygen is available and the target filesystem tools exist.
sanity_check_sshhostkeys() {
   local section="$1"

   if ! command -v ssh-keygen &>/dev/null; then
      msg_error "ssh-keygen is required but not found on this system."
      return 1
   fi

   if has_key "$section" "target"; then
      local target
      target="$(get_value "$section" "target")"
      sanity_check_target_filesystem "$target" "$section" || return 1
   fi

   return 0
}

# Callback body for run_action_sshhostkeys via with_target_mount.
_do_sshhostkeys() {
   local mount_point="$1" resolved_name="$2" target_type="$3" section="$4"

   # Ensure /etc/ssh directory exists in the target filesystem
   local ssh_dir="${mount_point}/etc/ssh"
   log "  Ensuring ${ssh_dir} exists"
   mkdir -p "$ssh_dir" || die "[${section}] failed to create ${ssh_dir}"

   # Generate host keys.
   # We do NOT use ssh-keygen -A -f <prefix> because the -f flag acts
   # as a prefix to the FULL default path (e.g. /etc/ssh/ssh_host_rsa_key),
   # producing a doubled path like <prefix>/etc/ssh/ssh_host_rsa_key.
   # Using explicit -t/-f per key type is unambiguous and portable.
   local -a type_list
   if has_key "$section" "types"; then
      read -ra type_list <<< "$(get_value "$section" "types")"
   else
      type_list=(rsa ecdsa ed25519)
   fi
   for kt in "${type_list[@]}"; do
      local key_file="${ssh_dir}/ssh_host_${kt}_key"
      if [[ ! -f "$key_file" ]]; then
         log "  Generating ${kt} host key"
         if ! ssh-keygen -t "$kt" -f "$key_file" -N '' -q; then
            die "[${section}] failed to generate ${kt} host key"
         fi
      else
         log "  ${kt} host key already exists, skipping"
      fi
   done
}

