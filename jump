# Check if a section exists in the parsed configuration.
# Parameters: $1 - section name
# Returns: 0 if found, 1 if not
has_section() {
   local section="$1"
   for s in "${SECTIONS[@]}"; do
      [[ "$s" == "$section" ]] && return 0
   done
   return 1
}

# Check if a key exists within a section.
# Parameters: $1 - section name, $2 - key name
# Returns: 0 if found, 1 if not
has_key() {
   local section="$1" key="$2"
   [[ -v "CONFIG[${section}:${key}]" ]]
}

# Retrieve the value of a key within a section.
# Parameters: $1 - section name, $2 - key name
# Returns: value via stdout, or returns 1 if key not found
get_value() {
   local section="$1" key="$2"
   if has_key "$section" "$key"; then
      printf '%s' "${CONFIG["${section}:${key}"]}"
   else
      return 1
   fi
}

# Evaluate a `when` predicate used to make an action conditional.
# Predicate grammar (whitespace is not trimmed around the value):
#   !PRED          negation
#   type:<type>    true if any [action.<type>.<instance>] section exists
#   section:<name> true if a section named <name> exists
#   true | false   constant
#   <other>        treated as a value: %...% references are expanded
#                  (leniently, so references not yet resolvable — e.g. an
#                  uncollected userinput answer during validation — are left
#                  verbatim) and the predicate is true if the result is
#                  non-empty and not one of {false, 0, no, off} (case-
#                  insensitive). A verbatim leftover %ref% counts as true so
#                  the action is still validated; the real skip decision is
#                  made again at run time when answers are available.
# Parameters: $1 - predicate string
# Returns: 0 if the predicate is true, 1 if false
eval_when_predicate() {
   local pred="$1"
   local negate=false
   if [[ "$pred" == !* ]]; then
      negate=true
      pred="${pred#!}"
   fi

   local result=false
   case "$pred" in
      type:*)
         local t="${pred#type:}"
         local s
         for s in "${SECTIONS[@]}"; do
            if [[ "$s" == "action.${t}."* ]]; then
               result=true
               break
            fi
         done
         ;;
      section:*)
         if has_section "${pred#section:}"; then
            result=true
         fi
         ;;
      true)
         result=true ;;
      false)
         result=false ;;
      *)
         local val low
         expand_prompt "$pred"; val="$_expand_value_result"
         low="${val,,}"
         if [[ -n "$val" ]] && [[ "$low" != "false" ]] && \
            [[ "$low" != "0" ]] && [[ "$low" != "no" ]] && \
            [[ "$low" != "off" ]]; then
            result=true
         fi
         ;;
   esac

   if [[ "$negate" == true ]]; then
      if [[ "$result" == true ]]; then result=false; else result=true; fi
   fi

   if [[ "$result" == true ]]; then return 0; else return 1; fi
}

# Decide whether an action section is active (should be validated/run) based
# on its optional `when` key. Actions without `when` are always active.
# Parameters: $1 - section name
# Returns: 0 if active, 1 if inactive (should be skipped)
is_action_active() {
   local section="$1"
   if ! has_key "$section" "when"; then
      return 0
   fi
   local pred
   pred="$(get_value "$section" "when")"
   eval_when_predicate "$pred"
}

# Check if a variable name is defined by a [userinput.*] section.
# Optionally verify the type matches (drives, netinterface, password,
# generic, ipv4address, ipv4netmask).
# Returns 0 if found (and type matches), 1 otherwise.
validate_variable() {
   local varname="$1"
   local expected_type="${2:-}"
   local sec
   for sec in "${SECTIONS[@]}"; do
      if [[ "$sec" == userinput.* ]] && has_key "$sec" "variable"; then
         if [[ "$(get_value "$sec" "variable")" == "$varname" ]]; then
            if [[ -z "$expected_type" ]]; then
               return 0
            fi
            local suffix="${sec#userinput.}"
            local type="${suffix%%.*}"
            [[ "$type" == "$expected_type" ]] && return 0
            return 1
         fi
      fi
   done
   return 1
}

# Parse a config value that must be a single %reference%.
# If the value is exactly %ref%, prints "ref" (without delimiters)
# and returns 0.  Otherwise returns 1.
parse_single_reference() {
   local value="$1"
   if [[ "$value" =~ ^%([^%]+)%$ ]]; then
      printf '%s' "${BASH_REMATCH[1]}"
      return 0
   fi
   return 1
}

# Extract all %...% references from a config value.
# Prints each reference (without delimiters) on its own line.
# Returns 0 on success, 1 if an unmatched % is found.
extract_references() {
   local text="$1"
   local remaining="$text"

   while [[ -n "$remaining" ]]; do
      # Skip %% (escaped literal)
      if [[ "$remaining" == %%* ]]; then
         remaining="${remaining:2}"
         continue
      fi

      # Extract %...% reference
      if [[ "$remaining" =~ ^%([^%]+)% ]]; then
         printf '%s\n' "${BASH_REMATCH[1]}"
         remaining="${remaining:${#BASH_REMATCH[0]}}"
         continue
      fi

      # Check for unmatched %
      if [[ "$remaining" =~ ^% ]]; then
         return 1
      fi

      # Consume text up to next %
      local before_pct="${remaining%%\%*}"
      if [[ "$before_pct" == "$remaining" ]]; then
         break
      fi
      remaining="${remaining:${#before_pct}}"
   done

   return 0
}

# Determine whether a value can be safely expanded right now.
# Returns 0 (true) if every user-input %variable% reference in the value is
# already populated in ANSWERS, or the value contains only built-in
# references (active, mac:..., diskid:..., disksize:..., memory:...) and
# literals. Returns 1 (false) if any user-input variable reference is not
# yet populated — which happens in interactive mode before collect_user_input
# has run. In that case, sanity checks that need resolved device paths must
# be skipped, since the referenced drives/interfaces cannot be known yet.
# Parameters: $1 - value to check
refs_resolvable() {
   local value="$1"
   local refs
   refs="$(extract_references "$value")" || refs=""
   local ref
   while IFS= read -r ref; do
      [[ -z "$ref" ]] && continue
      # Built-in references are always resolvable from system state.
      if [[ "$ref" == "active" ]] || \
         [[ "$ref" == mac:* ]] || \
         [[ "$ref" == diskid:* ]] || \
         [[ "$ref" == disksize:* ]] || \
         [[ "$ref" == memory:* ]]; then
         continue
      fi
      # Variable reference: varname, varname[idx], or varname[idx]part.
      local varname="$ref"
      if [[ "$ref" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)\[ ]]; then
         varname="${BASH_REMATCH[1]}"
      fi
      if [[ -z "${ANSWERS[$varname]+x}" ]]; then
         return 1
      fi
   done <<< "$refs"
   return 0
}

# Return the network interface name with the default IPv4 route.
# Dies if no default route is found.
get_active_interface() {
   local iface
   iface="$(ip -4 route show default 0.0.0.0/0 2>/dev/null | \
      awk '/dev/{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}' | head -1)"
   if [[ -z "$iface" ]]; then
      _resolve_fail "no default IPv4 route found; cannot determine active interface" \
         || return 1
   fi
   _resolve_result="$iface"
}

# Resolve a MAC address to a network interface name.
# Parameters: $1 - MAC address (e.g. aa:bb:cc:dd:ee:ff)
# Dies if no interface matches.
resolve_mac_to_interface() {
   local mac="$1"
   local mac_lower="${mac,,}"
   local iface iface_mac
   for iface in /sys/class/net/*/; do
      iface="$(basename "$iface")"
      [[ "$iface" == "lo" ]] && continue
      iface_mac="$(cat "/sys/class/net/${iface}/address" 2>/dev/null)" || continue
      if [[ "${iface_mac,,}" == "$mac_lower" ]]; then
         _resolve_result="$iface"
         return 0
      fi
   done
   _resolve_fail "no interface found with MAC address '${mac}'" || return 1
}

# Resolve a disk ID glob pattern to one or more /dev/disk/by-id device paths.
# Parameters: $1 - glob pattern to match against /dev/disk/by-id symlink names
#             (e.g. "ata-WDC*" matches ata-WDC-WD5000LPCX-xx)
# Skips partition entries (symlinks ending in -partN).
# Sets _resolve_result with space-separated matching paths, sorted. Dies if no
# matches found.
resolve_diskid_to_devices() {
   local pattern="$1"
   local -a matches=()
   local link

   for link in /dev/disk/by-id/${pattern}; do
      [[ ! -e "$link" ]] && continue
      # Skip partition entries (e.g. ata-xxx-part1)
      [[ "$link" =~ -part[0-9]+$ ]] && continue
      matches+=("$link")
   done

   if [[ ${#matches[@]} -eq 0 ]]; then
      _resolve_fail "no disks found matching disk ID pattern '${pattern}' in \
         /dev/disk/by-id/" || return 1
   fi

   # Sort for deterministic ordering
   local -a sorted=()
   local sorted_raw
   sorted_raw="$(printf '%s\n' "${matches[@]}" | sort)"
   while IFS= read -r link; do
      [[ -n "$link" ]] && sorted+=("$link")
   done <<< "$sorted_raw"

   _resolve_result="${sorted[*]}"
}

# Resolve a disk size specification to matching /dev/disk/by-id device paths.
# Parameters: $1 - size specification (e.g. "512GB", "2TiB", "400G").
#             Supported suffixes (case-insensitive):
#             B, KB/KiB, MB/MiB, GB/GiB, TB/TiB.
#             Bare number is treated as GiB.
# Matching tolerance: ±10% or ±10GiB of requested size, whichever is larger.
# Sets _resolve_result with space-separated matching paths, sorted.
resolve_disksize_to_devices() {
   local size_spec="$1"
   local size_lower="${size_spec,,}"

   # Parse the size specification into bytes
   local num unit requested_bytes
   if [[ "$size_lower" =~ \
      ^([0-9]+(\.[0-9]+)?)(kib|mib|gib|tib|kb|mb|gb|tb|k|m|g|t|b)?$ ]]; then
      num="${BASH_REMATCH[1]}"
      unit="${BASH_REMATCH[3]:-gib}"  # bare number defaults to GiB
      unit_to_bytes "$unit" || return 1
      requested_bytes="$(awk "BEGIN{printf \"%.0f\", ${num} * \
         ${_unit_to_bytes_result}}")"
   else
      _resolve_fail "invalid size specification '${size_spec}'" \
         "(expected e.g. 512GB, 2TiB, 400G)" || return 1
   fi

   # Iterate all disks, find matches within ±10% tolerance
   local -a match_devs=()
   local -a match_sizes=()
   local disk_output
   if ! disk_output="$(lsblk -dbno SIZE,NAME,TYPE 2>/dev/null)"; then
      _resolve_fail "lsblk failed; cannot enumerate disks for size matching" \
         || return 1
   fi

   while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      local disk_bytes disk_name disk_type
      read -r disk_bytes disk_name disk_type <<< "$line"
      [[ "$disk_type" != "disk" ]] && continue

      # Check tolerance: within ±10% or ±10GiB, whichever is larger
      local diff
      diff=$(awk "BEGIN{printf \"%.0f\", ${disk_bytes} - ${requested_bytes}}")
      # Use absolute difference via string manipulation to avoid awk abs issues
      local abs_diff
      if [[ "$diff" =~ ^- ]]; then
         abs_diff="${diff#-}"
      else
         abs_diff="$diff"
      fi
      # 10GiB in bytes
      local ten_gib
      ten_gib=$(awk "BEGIN{printf \"%.0f\", 10 * 1073741824}")
      # Threshold is the larger of 10% of requested_bytes or 10GiB
      local pct_threshold
      pct_threshold=$(awk "BEGIN{printf \"%.0f\", ${requested_bytes} * 0.10}")
      local threshold
      if (( pct_threshold >= ten_gib )); then
         threshold="$pct_threshold"
      else
         threshold="$ten_gib"
      fi
      if (( abs_diff <= threshold )); then
         # Find /dev/disk/by-id symlink (prefer non-partition entry)
         local by_id=""
         local link
         for link in /dev/disk/by-id/*; do
            [[ ! -e "$link" ]] && continue
            [[ "$link" =~ -part[0-9]+$ ]] && continue
            local target
            target="$(readlink -f "$link" 2>/dev/null)" || continue
            if [[ "$(basename "$target")" == "$disk_name" ]]; then
               by_id="$link"
               break
            fi
         done
         [[ -z "$by_id" ]] && by_id="/dev/${disk_name}"

         match_devs+=("$by_id")
         match_sizes+=("$disk_bytes")
      fi
   done <<< "$disk_output"

   if [[ ${#match_devs[@]} -eq 0 ]]; then
      # Show helpful error with available disk sizes
      local avail_info
      avail_info="$(lsblk -dbno SIZE,NAME,TYPE 2>/dev/null | \
         awk '$3=="disk"{printf "  %s (%s bytes)\n", $2, $1}')"
      _resolve_fail "no disks found matching size '${size_spec}' (${requested_bytes} bytes). \
Available disks:
${avail_info}" || return 1
   fi

   # Check for ambiguous match: multiple different sizes within tolerance
   if [[ ${#match_sizes[@]} -gt 1 ]]; then
      local first_size="${match_sizes[0]}"
      local ambiguous=false
      local s
      for s in "${match_sizes[@]}"; do
         # If sizes differ by more than 1%, it's ambiguous
         local size_diff
         size_diff=$(awk "BEGIN{printf \"%.0f\", (${s} - ${first_size})}")
         local abs_size_diff
         if [[ "$size_diff" =~ ^- ]]; then
            abs_size_diff="${size_diff#-}"
         else
            abs_size_diff="$size_diff"
         fi
         if (( abs_size_diff > 0 )); then
            # Two different actual sizes matched — ambiguous
            ambiguous=true
            break
         fi
      done
      if [[ "$ambiguous" == "true" ]]; then
         local size_list=""
         local i
         for (( i=0; i<${#match_devs[@]}; i++ )); do
            size_list+="$(printf '\n  %s (%s bytes)' \
               "${match_devs[$i]}" "${match_sizes[$i]}")"
         done
         _resolve_fail "ambiguous disk size match for '${size_spec}': multiple disks with different \
sizes fall within matching tolerance (±10%% or ±10GiB):${size_list}" || return 1
      fi
   fi

   # Sort for deterministic ordering
   local -a sorted=()
   local sorted_raw
   sorted_raw="$(printf '%s\n' "${match_devs[@]}" | sort)"
   while IFS= read -r link; do
      [[ -n "$link" ]] && sorted+=("$link")
   done <<< "$sorted_raw"

   _resolve_result="${sorted[*]}"
}

# Resolve a memory reference to a numeric value.
# Parameters: $1 - specification in the format <factor>[,<unit>]
#             factor: positive decimal number (e.g. 0.9, 1.5)
#             unit: B, K/KB/KiB, M/MB/MiB, G/GB/GiB, T/TB/TiB (case-insensitive)
#             If unit is omitted, result is in bytes.
#             Unit suffixes follow the same convention as %disksize:...%:
#             Single-letter (K, M, G, T) = SI units (10³, 10⁶, etc.)
#             iB suffixes (KiB, MiB, GiB, TiB) = binary (2¹⁰ = 1024, etc.)
# Reads total memory from /proc/meminfo (MemTotal in KiB).
# Sets _resolve_result with the computed integer value.
resolve_memory_to_value() {
   local spec="$1"
   local spec_lower="${spec,,}"

   local factor unit
   if [[ "$spec_lower" =~ ^([0-9]+(\.[0-9]+)?),([a-z]+)$ ]]; then
      factor="${BASH_REMATCH[1]}"
      unit="${BASH_REMATCH[3]}"
   elif [[ "$spec_lower" =~ ^([0-9]+(\.[0-9]+)?)$ ]]; then
      factor="${BASH_REMATCH[1]}"
      unit="b"
   else
      _resolve_fail "invalid memory specification '${spec}' (expected e.g. 0.9, 0.9,GiB, 1.5)" \
         || return 1
   fi

   # Validate factor is positive
   local factor_check
   factor_check="$(awk "BEGIN{print ($factor <= 0) ? \"invalid\" : \"valid\"}")"
   if [[ "$factor_check" == "invalid" ]]; then
      _resolve_fail "memory factor must be positive, got '${factor}'" || return 1
   fi

   # Read total memory from /proc/meminfo (in KiB)
   local memtotal_kib
   memtotal_kib="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)"
   if [[ -z "$memtotal_kib" ]]; then
      _resolve_fail "could not read MemTotal from /proc/meminfo" || return 1
   fi

   # Convert to bytes: KiB * 1024
   local total_bytes
   total_bytes="$(awk "BEGIN{printf \"%.0f\", ${memtotal_kib} * 1024}")"

   # Compute result: factor * total_bytes
   local result_bytes
   result_bytes="$(awk "BEGIN{printf \"%.0f\", ${factor} * ${total_bytes}}")"

   # If unit specified, convert result to that unit
   local result
   if [[ "$unit" == "b" ]]; then
      result="$result_bytes"
   else
      convert_value_to_unit "$result_bytes" "$unit" || return 1
      result="$_convert_value_result"
   fi

   _resolve_result="$result"
}

# Return the byte multiplier for a unit string.
# Parameters: $1 - unit (case-insensitive). Recognized:
#             b, k/kb, kib, m/mb, mib, g/gb, gib, t/tb, tib.
#             Single-letter suffixes (k, m, g, t) are SI (10^n).
#             iB-suffixed names (KiB, MiB, GiB, TiB) are binary (2^(10n)).
#             B alone is bytes.
# Sets _unit_to_bytes_result with the integer multiplier.
# Dies on unrecognized unit.
unit_to_bytes() {
   local unit="${1,,}"
   case "$unit" in
      b)   _unit_to_bytes_result=1 ;;
      k|kb)  _unit_to_bytes_result=1000 ;;
      kib) _unit_to_bytes_result=1024 ;;
      m|mb)  _unit_to_bytes_result=1000000 ;;
      mib) _unit_to_bytes_result=1048576 ;;
      g|gb)  _unit_to_bytes_result=1000000000 ;;
      gib) _unit_to_bytes_result=1073741824 ;;
      t|tb)  _unit_to_bytes_result=1000000000000 ;;
      tib) _unit_to_bytes_result=1099511627776 ;;
      *)   _resolve_fail "unrecognized unit '${1}'" || return 1 ;;
   esac
}

# Convert a byte count to a different unit and return the integer result.
# Parameters: $1 - byte count (integer or integer-valued decimal).
#             $2 - target unit (same vocabulary as unit_to_bytes).
# Sets _convert_value_result with the integer result.
# Division is performed in awk to avoid bash integer overflow on large values.
# Dies on unrecognized target unit.
convert_value_to_unit() {
   local bytes="$1"
   local target="$2"
   unit_to_bytes "$target" || return 1  # validates $target
   _convert_value_result="$(awk "BEGIN{printf \"%.0f\", \
      ${bytes} / ${_unit_to_bytes_result}}")"
}

# Resolve a reference (text between %...% delimiters).
# Sets the global variable _resolve_result with the resolved value.
# This avoids running in a subshell (which would prevent die() from exiting
# the main process).
# varname            → scalar ANSWERS value
# varname[idx]n      → drive device path with partition suffix
# varname[idx]       → drive device path (whole drive, no partition)
# active             → network interface with the default IPv4 route
# mac:XX:XX:XX:XX:XX:XX → network interface matching the MAC address
# diskid:<glob>      → disk(s) matching a glob pattern in /dev/disk/by-id
# disksize:<spec>    → disk(s) matching a size specification
#                      (near-match ±10% or ±10GiB, whichever is larger)
# memory:<factor>[,<unit>] → portion of total memory
#                           (factor e.g. 0.9, 1.5; unit e.g. GiB, MB; default B)
# _resolve_result is set by resolve_reference() and its helpers (declared at
# script top).
resolve_reference() {
   local ref="$1"

   if [[ "$ref" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)\[([0-9]+)\]([0-9]+)$ ]]; then
      # Drive reference with partition: varname[index]partnum
      resolve_drive_ref "$ref" || return 1
   elif [[ "$ref" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)\[([0-9]+)\]$ ]]; then
      # Drive reference without partition: varname[index]
      local varname="${BASH_REMATCH[1]}"
      local index="${BASH_REMATCH[2]}"
      if [[ -z "${ANSWERS[$varname]+x}" ]]; then
         _resolve_fail "undefined variable '${varname}'" || return 1
      fi
      local -a drives_arr=()
      read -ra drives_arr <<< "${ANSWERS[$varname]}"
      if [[ $index -ge ${#drives_arr[@]} ]]; then
         _resolve_fail "drive variable '${varname}' index ${index} out of range (has ${#drives_arr[@]} \
            drive(s))" || return 1
      fi
      _resolve_result="${drives_arr[$index]}"
   elif [[ "$ref" == "active" ]]; then
      # Built-in: interface with the default IPv4 route
      get_active_interface || return 1
   elif [[ "$ref" =~ ^mac:([0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5})$ ]]; then
      # Built-in: interface matching a MAC address
      resolve_mac_to_interface "${BASH_REMATCH[1]}" || return 1
   elif [[ "$ref" =~ ^diskid:(.+)$ ]]; then
      # Built-in: disks matching a glob pattern in /dev/disk/by-id
      resolve_diskid_to_devices "${BASH_REMATCH[1]}" || return 1
   elif [[ "$ref" =~ ^disksize:(.+)$ ]]; then
      # Built-in: disks matching a size specification
      #          (near-match ±10% or ±10GiB, whichever is larger)
      resolve_disksize_to_devices "${BASH_REMATCH[1]}" || return 1
   elif [[ "$ref" =~ ^memory:([0-9]+(\.[0-9]+)?(,[a-zA-Z]+)?)$ ]]; then
      # Built-in: portion of total system memory
      resolve_memory_to_value "${BASH_REMATCH[1]}" || return 1
   elif [[ "$ref" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
      # Scalar variable reference
      if [[ -z "${ANSWERS[$ref]+x}" ]]; then
         _resolve_fail "undefined variable '${ref}'" || return 1
      fi
      _resolve_result="${ANSWERS[$ref]}"
   else
      _resolve_fail "invalid variable reference '%${ref}%'" || return 1
   fi
}

# Expand all %...% variable references and %% escapes in a string.
# %varname%                → scalar or array variable value
# %varname[idx]part%       → resolved drive device path with partition
# %varname[idx]%           → resolved drive device path (whole drive)
# %active%                 → network interface with the default IPv4 route
# %mac:XX:XX:XX:XX:XX:XX% → network interface matching the MAC address
# %diskid:<glob>%          → disk(s) matching glob pattern in /dev/disk/by-id
# %disksize:<spec>%        → disk(s) matching size specification
#                           (near-match ±10% or ±10GiB, whichever is larger)
# %memory:<factor>[,<unit>]% → portion of total system memory
#                                (e.g. %memory:0.9,GiB%)
# %%                       → literal %
#
# The state machine is implemented by _expand_value_loop.
# The resolver callback (_expand_resolve) resolves %ref% references via
# resolve_reference. Sets _expand_value_result (not stdout) so that
# die() called from resolve_reference can exit the main process.

# Resolver for expand_value: resolves %ref% via resolve_reference.
_expand_resolve() {
   local ref="$1"
   _resolve_result=""
   resolve_reference "$ref"
}

# Internal: expand %...% references in text using a resolver callback.
# Sets _expand_value_result with the expanded string.
# $1 text, $2 resolver function name, $3 die_on_unmatched (1=die, 0=append literal %)
_expand_value_loop() {
   local text="$1" resolver="$2" die_on_unmatched="${3:-0}"
   local result="" remaining="$text" ref
   while [[ -n "$remaining" ]]; do
      # Check for %% (escaped literal percent)
      if [[ "$remaining" == %%* ]]; then
         result+="%"
         remaining="${remaining:2}"
         continue
      fi

      # Check for %...% reference
      if [[ "$remaining" =~ ^%([^%]+)% ]]; then
         ref="${BASH_REMATCH[1]}"
         local match_len=${#BASH_REMATCH[0]}
         "$resolver" "$ref"
         result+="$_resolve_result"
         remaining="${remaining:${match_len}}"
         continue
      fi

      # Check for unmatched %
      if [[ "$remaining" =~ ^% ]]; then
         if [[ "$die_on_unmatched" -eq 1 ]]; then
            die "unmatched '%' in config value - use '%%' for a literal percent sign"
         fi
         result+="%"
         remaining="${remaining:1}"
         continue
      fi

      # Consume text up to the next % or end of string
      local before_pct="${remaining%%\%*}"
      if [[ "$before_pct" == "$remaining" ]]; then
         result+="$remaining"
         break
      fi
      result+="$before_pct"
      remaining="${remaining:${#before_pct}}"
   done
   _expand_value_result="$result"
}

# Expand all %...% references and %% escapes in a string.
# Sets _expand_value_result (not stdout) so die() from resolve_reference
# can exit the main process. Callers must use:
#   expand_value "$arg"; var="$_expand_value_result"
expand_value() {
   _expand_value_loop "$1" _expand_resolve 1
}

# Lenient resolver for prompt expansion: like _expand_resolve, but
# unresolvable %ref% references are left verbatim ("%ref%") instead of
# aborting. Temporarily enables _resolve_lenient so resolve_reference and
# its helpers return 1 (rather than die) on failure.
_expand_resolve_lenient() {
   local ref="$1"
   _resolve_result=""
   _resolve_lenient=true
   resolve_reference "$ref"
   local rc=$?
   _resolve_lenient=false
   if (( rc != 0 )); then
      _resolve_result="%${ref}%"
   fi
}

# Expand %variable% references in a userinput prompt leniently. Resolvable
# references (user-input variables collected by earlier userinput sections,
# plus built-ins such as %active%, %mac:..%, %diskid:..%, %disksize:..% and
# %memory:..%) are expanded; references that cannot be resolved (e.g. a
# variable not yet collected, or an unknown name) are left as literal %ref%
# text so input collection is not aborted. An unmatched '%' is also left
# literal rather than treated as an error. User-defined [var.*] variables are
# already expanded earlier by process_user_vars, so this only handles
# user-input/built-in references.
# Sets _expand_value_result. Callers must use:
#   expand_prompt "$prompt"; prompt="$_expand_value_result"
expand_prompt() {
   _expand_value_loop "$1" _expand_resolve_lenient 0
}

# Validate that a 'target' key in a section references a valid filesystem action.
# Checks: target key exists, target section exists, target type is supported,
# and the target section has the required keys (pool for zfs, drive for ext4/vfat).
# Parameters: $1 - section name
# Returns: number of errors found
validate_target_reference() {
   local section="$1"
   local valid=0

   if ! has_key "$section" "target"; then
      printf '%s\n' "error: [${section}] missing required key 'target'" >&2
      ((valid++))
   else
      local target
      target="$(get_value "$section" "target")"
      local target_type="${target%%.*}"
      local target_section="action.${target}"
      local found=false
      for section2 in "${SECTIONS[@]}"; do
         if [[ "$section2" == "$target_section" ]]; then
            found=true
            break
         fi
      done
      if [[ "$found" == "false" ]]; then
         printf '%s\n' "error: [${section}] 'target' references '${target}' \
            which does not match any action section" >&2
         ((valid++))
      fi
      if [[ "$target_type" != "zfs" && "$target_type" != "ext4" && \
         "$target_type" != "vfat" ]]; then
         printf '%s\n' "error: [${section}] 'target' type '${target_type}' not supported" >&2
         ((valid++))
      fi
      if [[ "$target_type" == "zfs" ]]; then
         if ! has_key "$target_section" "dataset"; then
            printf '%s\n' "error: [${section}] target '${target}' references a zfs action \
               without a 'dataset' key" >&2
            ((valid++))
         fi
         if ! has_key "$target_section" "pool"; then
            printf '%s\n' "error: [${section}] target '${target}' references a zfs action \
               without a 'pool' key" >&2
            ((valid++))
         fi
      fi
      if [[ "$target_type" == "ext4" ]]; then
         if ! has_key "$target_section" "drive"; then
            printf '%s\n' "error: [${section}] target '${target}' refs ext4 without 'drive' key" >&2
            ((valid++))
         fi
      fi
      if [[ "$target_type" == "vfat" ]]; then
         if ! has_key "$target_section" "drive"; then
            printf '%s\n' "error: [${section}] target '${target}' references a vfat action \
               without a 'drive' key" >&2
            ((valid++))
         fi
      fi
   fi

   return $valid
}

# Validate that a 'crypt.<instance>' token refers to an existing
# [action.crypt.<instance>] section. Prints an error and returns 1 if the
# referenced crypt instance is not defined.
# Parameters: $1 - section name (for error messages)
#             $2 - the crypt reference token (e.g. 'crypt.root')
# Returns: 0 if the instance exists, 1 otherwise
validate_crypt_reference() {
   local section="$1" ref="$2"
   local instance="${ref#crypt.}"
   local target_section="action.crypt.${instance}"
   local s found=false
   for s in "${SECTIONS[@]}"; do
      if [[ "$s" == "$target_section" ]]; then
         found=true
         break
      fi
   done
   if [[ "$found" == false ]]; then
      printf '%s\n' "error: [${section}] crypt reference '${ref}' does not match" \
         "any [action.crypt.*] section" >&2
      return 1
   fi
   return 0
}

# Detect a crypt back-reference token. A token is a crypt reference when it
# starts with the literal 'crypt.' prefix (it is never a %variable% — those
# are expanded before this check — nor a /dev/ path).
# Parameters: $1 - token to test
# Returns: 0 if the token is a 'crypt.<instance>' reference, 1 otherwise
is_crypt_ref() {
   [[ "$1" == crypt.* ]]
}

# Extract the instance name from a 'crypt.<instance>' token.
# Parameters: $1 - crypt reference token
# Prints: the instance name (everything after 'crypt.')
crypt_ref_instance() {
   printf '%s' "${1#crypt.}"
}

# Validate that a drive key in a section references a valid drives variable
# or a literal device path (e.g. /dev/sda1).
# Parameters: $1 - section name
#             $2 - key name (e.g. "drive")
#             $3 - optional: "require_partition" to require a partition number
# Returns: number of errors found
validate_drive_reference() {
   local section="$1"
   local key="$2"
   local require_partition="${3:-}"
   local valid=0

   if ! has_key "$section" "$key"; then
      printf '%s\n' "error: [${section}] missing required key '${key}'" >&2
      ((valid++))
   else
      local val
      val="$(get_value "$section" "$key")"

      # Literal device path — accept as-is
      if [[ "$val" == /dev/* ]]; then
         if [[ "$require_partition" == "require_partition" ]]; then
            local partnum
            partnum="$(extract_partition_number "$val")"
            if [[ -z "$partnum" ]]; then
               printf '%s\n' "error: [${section}] '${key}' literal path '${val}' \
                  does not include a partition number" >&2
               ((valid++))
            fi
         fi
         return $valid
      fi

      # Crypt back-reference (crypt.<instance>) — the mapper device is
      # always whole-device, so the partition requirement does not apply.
      if is_crypt_ref "$val"; then
         validate_crypt_reference "$section" "$val" || ((valid++))
         return $valid
      fi

      local ref
      ref="$(parse_single_reference "$val")" || {
         if [[ "$require_partition" == "require_partition" ]]; then
            printf '%s\n' "error: [${section}] '${key}' must be a single drive reference \
               with partition (e.g. %varname[0]3% or /dev/sda1)," \
               "got '${val}'" >&2
         else
            printf '%s\n' "error: [${section}] '${key}' must be a single drive reference \
               (e.g. %varname[0]1% or /dev/sda1), got '${val}'" >&2
         fi
         ((valid++))
         ref=""
      }
      if [[ -n "$ref" ]]; then
         if [[ "$ref" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)\[([0-9]+)\]([0-9]+)$ ]]; then
            local varname="${BASH_REMATCH[1]}"
            if ! validate_variable "$varname" "drives"; then
               printf '%s\n' "error: [${section}] '${key}' refs unknown drive var '${varname}'" >&2
               ((valid++))
            fi
         elif [[ "$require_partition" != "require_partition" ]] && \
            [[ "$ref" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)\[([0-9]+)\]$ ]]; then
            local varname="${BASH_REMATCH[1]}"
            if ! validate_variable "$varname" "drives"; then
               printf '%s\n' "error: [${section}] '${key}' refs unknown drive var '${varname}'" >&2
               ((valid++))
            fi
         else
            if [[ "$require_partition" == "require_partition" ]]; then
               printf '%s\n' "error: [${section}] '${key}' ref '%${ref}%' needs partition, got '${val}'" >&2
            else
               printf '%s\n' "error: [${section}] '${key}' reference '%${ref}%' is not \
                  a valid drive reference" \
                  "(expected %varname[idx]part% or %varname[idx]%)" >&2
            fi
            ((valid++))
         fi
      fi
   fi

   return $valid
}

# Validate that an action section has an instance suffix (e.g. [action.zpool.main]).
# Parameters: $1 section, $2 type (e.g. "zpool", "zfs")
# Returns: 0 if valid, 1 if missing instance name
validate_instance_name() {
   local section="$1" type="$2"
   local suffix="${section#action."${type}".}"
   if [[ "$suffix" == "$section" ]]; then
      printf '%s\n' "error: [${section}] missing instance name \
         (use e.g. [action.${type}.name])" >&2
      return 1
   fi
   return 0
}

# Strip the partition suffix from a device path.
# Handles /dev/sdXN, /dev/nvmeXnYpZ, /dev/mdXpY, /dev/disk/by-id/*-partN patterns.
# Parameters: $1 - device path with partition (e.g. /dev/sda1, /dev/nvme0n1p1)
# Prints: base device path without partition suffix
strip_partition() {
   local dev="$1"
   # NVMe: /dev/nvme0n1p1 -> /dev/nvme0n1
   if [[ "$dev" =~ ^(/dev/nvme[0-9]+n[0-9]+)p[0-9]+$ ]]; then
      printf '%s' "${BASH_REMATCH[1]}"
   # MD: /dev/md0p1 -> /dev/md0
   elif [[ "$dev" =~ ^(/dev/md[0-9]+)p[0-9]+$ ]]; then
      printf '%s' "${BASH_REMATCH[1]}"
   # disk/by-id: ata-WDC-xxx-part1 -> ata-WDC-xxx
   elif [[ "$dev" == /dev/disk/by-id/*-part[0-9]* ]]; then
      printf '%s' "${dev%-part*}"
   # MD whole device: /dev/md0 -> /dev/md0 (no partition to strip)
   elif [[ "$dev" =~ ^/dev/md[0-9]+$ ]]; then
      printf '%s' "$dev"
   # SD/VD: /dev/sda1 -> /dev/sda (strip trailing digits)
   elif [[ "$dev" =~ ^/dev/[a-z]+[0-9]+$ ]]; then
      printf '%s' "${dev%%[0-9]*}"
   else
      printf '%s' "$dev"
   fi
}

# Extract the partition number from a device path.
# Handles /dev/sdXN, /dev/nvmeXnYpZ, /dev/mdXpY, /dev/disk/by-id/*-partN patterns.
# Parameters: $1 - device path with partition
# Prints: partition number (empty string if no partition found)
extract_partition_number() {
   local dev="$1"
   # NVMe: /dev/nvme0n1p1
   if [[ "$dev" =~ ^/dev/nvme[0-9]+n([0-9]+)p([0-9]+)$ ]]; then
      printf '%s' "${BASH_REMATCH[2]}"
   # MD: /dev/md0p1
   elif [[ "$dev" =~ ^/dev/md([0-9]+)p([0-9]+)$ ]]; then
      printf '%s' "${BASH_REMATCH[2]}"
   # disk/by-id: *-part1
   elif [[ "$dev" == /dev/disk/by-id/*-part[0-9]* ]]; then
      local stripped="${dev##*-part}"
      printf '%s' "${stripped%%[!0-9]*}"
   # MD whole device: /dev/md0 (no partition)
   elif [[ "$dev" =~ ^/dev/md[0-9]+$ ]]; then
      printf ''
   # SD-style: /dev/sda1, /dev/vda1 (trailing digits are partition)
   elif [[ "$dev" =~ ^/dev/[a-z]+([0-9]+)$ ]]; then
      printf '%s' "${BASH_REMATCH[1]}"
   else
      printf ''
   fi
}

# Check that a drive reference value resolves to an existing device.
# Parameters: $1 - drive value string (e.g. "%drives[0]3%")
#             $2 - section name for error messages
#             $3 - optional: "base_only" for efibootmgr
#             (no partition suffix, use readlink)
# Returns: 0 if device exists or cannot be resolved yet, 1 if device missing
check_drive_ref_exists() {
   local drive_val="$1"
   local error_section="$2"
   local mode="${3:-}"

   # Crypt back-reference: the mapper device is created at runtime by an
   # earlier action.crypt step, so it cannot be verified at sanity-check
   # time (before any action runs). Treat it as an action device and skip.
   if is_crypt_ref "$drive_val"; then
      local instance
      instance="$(crypt_ref_instance "$drive_val")"
      if [[ -n "${ACTION_DEVICES[/dev/mapper/${instance}]+x}" ]]; then
         return 0
      fi
      return 0
   fi

   # Literal device path — check existence of base device.
   # The partition may not exist yet if created by a later action,
   # so only check the base device exists.
   # Skip check entirely if the base device will be created by an action.
   if [[ "$drive_val" == /dev/* ]]; then
      local base_dev
      base_dev="$(strip_partition "$drive_val")"
      if is_action_device "$base_dev"; then
         return 0
      fi
      local real_base
      real_base="$(readlink -f "$base_dev" 2>/dev/null || printf '%s' "$base_dev")"
      if [[ ! -e "$real_base" ]]; then
         msg_error "Device ${drive_val} referenced in [${error_section}] does not exist" \
            "and base device ${real_base} not found."
         return 1
      fi
      return 0
   fi

   local ref
   ref="$(parse_single_reference "$drive_val")" || ref=""

   if [[ -z "$ref" ]]; then
      return 0
   fi

   if [[ "$ref" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)\[([0-9]+)\]([0-9]+)$ ]]; then
      local varname="${BASH_REMATCH[1]}"
      local index="${BASH_REMATCH[2]}"
      local partnum="${BASH_REMATCH[3]}"

      if [[ -z "${ANSWERS[$varname]+x}" ]]; then
         return 0
      fi

      local -a drives_arr=()
      read -ra drives_arr <<< "${ANSWERS[$varname]}"
      if [[ $index -lt ${#drives_arr[@]} ]]; then
         local dev="${drives_arr[$index]}"
         if [[ "$mode" == "base_only" ]]; then
            if is_action_device "$dev"; then
               : # Skip check — device will be created by an action
            else
               local real_dev
               real_dev="$(readlink -f "$dev")"
               if [[ ! -e "$real_dev" ]]; then
                  msg_error "Device ${real_dev} referenced in" \
                     "[${error_section}] does not exist."
                  return 1
               fi
            fi
         else
            local base_dev="$dev"
            if [[ "$dev" == /dev/disk/by-id/* ]]; then
               dev="${dev}-part${partnum}"
            else
               dev="${dev}${partnum}"
            fi
            if [[ ! -e "$dev" ]]; then
               # Partition device may not exist yet if an action.partition
               # step will create it later. Only error if the base drive
               # itself is also missing.
               if is_action_device "$base_dev"; then
                  : # Skip check — base device will be created by an action
               else
                  local real_base
                  real_base="$(readlink -f "$base_dev" 2>/dev/null || \
                     printf '%s' "$base_dev")"
                  if [[ ! -e "$real_base" ]]; then
                     msg_error "Device ${dev} referenced in [${error_section}] does not exist" \
                        "and base device ${real_base} not found."
                     return 1
                  fi
               fi
            fi
         fi
      fi
   elif [[ "$ref" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)\[([0-9]+)\]$ ]]; then
      local varname="${BASH_REMATCH[1]}"
      local index="${BASH_REMATCH[2]}"

      if [[ -z "${ANSWERS[$varname]+x}" ]]; then
         return 0
      fi

      local -a drives_arr=()
      read -ra drives_arr <<< "${ANSWERS[$varname]}"
      if [[ $index -lt ${#drives_arr[@]} ]]; then
         local dev="${drives_arr[$index]}"
         if [[ ! -e "$dev" ]]; then
            if is_action_device "$dev"; then
               : # Skip check — device will be created by an action
            else
               msg_error "Device ${dev} referenced in [${error_section}]" \
                  "does not exist."
               return 1
            fi
         fi
      fi
   fi

   return 0
}

# Find the action.zpool section for a given pool name.
# Sets _find_result to the section name, or empty if not found.
find_zpool_section() {
   local pool_name="$1"
   _find_result=""
   for __section in "${SECTIONS[@]}"; do
      if [[ "$__section" == action.zpool.* ]]; then
         local __pool="${__section#action.zpool.}"
         if [[ "$__pool" == "$pool_name" ]]; then
            _find_result="$__section"
            return
         fi
      fi
   done
}

# Parameters: $1 - pool name (optional; if empty, only checks zfs command
# availability)
#             $2 - section name for error messages
# Returns: 0 if available, 1 if not
check_zfs_pool_available() {
   local pool_name="${1:-}"
   local section="$2"

   if ! command -v zfs &>/dev/null; then
      msg_error "zfs is required but not found on this system."
      return 1
   fi

   if [[ -n "$pool_name" ]]; then
      find_zpool_section "$pool_name"
      if [[ -z "$_find_result" ]] && \
         ! zpool list "$pool_name" &>/dev/null; then
         msg_error "ZFS pool '${pool_name}' referenced in [${section}]" \
            "does not exist."
         return 1
      fi
   fi

   return 0
}

# Run sanity checks for a target filesystem reference.
# Checks that the filesystem tools are available and referenced pools or devices
# exist.
# Parameters: $1 - target string (e.g. "zfs.ROOT/debian")
#             $2 - section name for error messages
# Returns: 0 if ok, 1 if not
sanity_check_target_filesystem() {
   local target="$1"
   local section="$2"

   local target_type="${target%%.*}"
   local target_section="action.${target}"

   case "$target_type" in
      zfs)
         if has_key "$target_section" "pool"; then
            local pool_name
            pool_name="$(get_value "$target_section" "pool")"
            check_zfs_pool_available "$pool_name" "$section" || return 1
         else
            check_zfs_pool_available "" "$section" || return 1
         fi
         ;;
      ext4)
         if ! command -v mkfs.ext4 &>/dev/null; then
            msg_error "mkfs.ext4 is required but not found on this system."
            return 1
         fi
         if has_key "$target_section" "drive"; then
            local drive_val
            drive_val="$(get_value "$target_section" "drive")"
            check_drive_ref_exists "$drive_val" "$section" || return 1
         fi
         ;;
      vfat)
         if ! command -v mkfs.vfat &>/dev/null; then
            msg_error "mkfs.vfat is required but not found on this system."
            return 1
         fi
         if has_key "$target_section" "drive"; then
            local drive_val
            drive_val="$(get_value "$target_section" "drive")"
            check_drive_ref_exists "$drive_val" "$section" || return 1
         fi
         ;;
      *)
         ;;
   esac

   return 0
}

# Mount a target filesystem at the given mount point.
# Resolves the target reference (pool/dataset or drive device) and mounts it.
# Parameters: $1 - target reference string (e.g. "zfs.ROOT/debian")
#             $2 - mount point directory
# Prints: resolved name (dataset or device path) for use in log messages
mount_target_filesystem() {
   local target="$1"
   local mount_point="$2"

   local target_type="${target%%.*}"
   local target_section="action.${target}"
   local resolved_name=""

   case "$target_type" in
      zfs)
         if ! has_key "$target_section" "dataset"; then
            die "[${target_section}] missing required key 'dataset'"
         fi
         local dataset_name
         dataset_name="$(get_value "$target_section" "dataset")"
         if ! has_key "$target_section" "pool"; then
            die "[${target_section}] missing required key 'pool'"
         fi
         local pool_name
         pool_name="$(get_value "$target_section" "pool")"
         resolved_name="${pool_name}/${dataset_name}"
         log "  Mounting dataset '${resolved_name}' at ${mount_point}"
         run_cmd mount -t zfs -o zfsutil "${resolved_name}" "${mount_point}"
         ;;
      ext4)
         if ! has_key "$target_section" "drive"; then
            die "[${target_section}] missing required key 'drive'"
         fi
         local drive_ref
         drive_ref="$(get_value "$target_section" "drive")"
         local device
         resolve_drive_value "$drive_ref"; device="$_resolve_drive_value"
         local -a _mdevs=()
         read -ra _mdevs <<< "$device"
         device="${_mdevs[0]:-}"
         resolved_name="${device}"
         log "  Mounting ${resolved_name} at ${mount_point}"
         run_cmd mount -t ext4 "${device}" "${mount_point}"
         ;;
      vfat)
         if ! has_key "$target_section" "drive"; then
            die "[${target_section}] missing required key 'drive'"
         fi
         local drive_ref
         drive_ref="$(get_value "$target_section" "drive")"
         local device
         resolve_drive_value "$drive_ref"; device="$_resolve_drive_value"
         local -a _mdevs=()
         read -ra _mdevs <<< "$device"
         device="${_mdevs[0]:-}"
         resolved_name="${device}"
         log "  Mounting ${resolved_name} at ${mount_point}"
         run_cmd mount -t vfat "${device}" "${mount_point}"
         ;;
      *)
         die "unsupported target type '${target_type}'"
         ;;
   esac

   printf '%s' "$resolved_name"
}

# Unmount a target filesystem and clean up the mount point.
# Parameters: $1 - mount point directory
unmount_target_filesystem() {
   local mount_point="$1"
   log "  Unmounting ${mount_point}"
   run_cmd umount "${mount_point}"
   rmdir "$mount_point" 2>/dev/null || true
}

# Unmount an updateinitramfs chroot in correct order: pseudofilesystems
# (last mounted first), then user bind mounts (last mounted first), then the
# root filesystem. Used by run_action_updateinitramfs for both error and
# success paths so unmount order is defined in exactly one place.
# Parameters: $1 - root mount point
#             $2..$N - bind mount points (in mount order)
unmount_chroot_stack() {
   local root="$1"
   shift
   local -a pseudo=( "$root/proc" "$root/sys" \
      "$root/sys/firmware/efi/efivars" "$root/dev" )
   local -a user_mounts=( "$@" )
   local m i

   # Pseudofilesystems: last mounted = first unmounted.
   for (( i=${#pseudo[@]}-1; i>=0; i-- )); do
      m="${pseudo[$i]}"
      umount "$m" 2>/dev/null || log "WARNING: failed to unmount $m"
   done

   # User-supplied bind mounts in reverse mount order.
   for (( i=${#user_mounts[@]}-1; i>=0; i-- )); do
      m="${user_mounts[$i]}"
      umount "$m" 2>/dev/null || log "WARNING: failed to unmount $m"
   done

   unmount_target_filesystem "$root"
}

# Mount a target filesystem, run a callback, and unmount.
# Parameters: $1 - section name, $2 - target value, $3 - log verb (e.g.
#             "Creating directory /foo on"), $4 - callback function name,
#             $5..$N - extra arguments forwarded to the callback.
# The callback receives: $1=mount_point, $2=resolved_name, $3=target_type,
#             $4=section, $5..$N=extra arguments from with_target_mount.
# Logs a standard message describing the target filesystem.
# On callback success: unmounts and returns 0.
# On callback failure (return 1): unmounts and returns 1.
# On callback die(): the EXIT trap handles cleanup via TEMP_DIRS.
with_target_mount() {
   local section="$1" target="$2" log_verb="$3" callback="$4"
   shift 4
   local target_type="${target%%.*}"
   local mount_point resolved_name rc

   mount_point="$(mktemp -d)"
   TEMP_DIRS+=("$mount_point")
   resolved_name="$(mount_target_filesystem "$target" "$mount_point")"

   case "$target_type" in
      zfs)  log "${log_verb} ZFS dataset '${resolved_name}'" ;;
      ext4) log "${log_verb} ext4 filesystem '${resolved_name}'" ;;
      vfat) log "${log_verb} vfat filesystem '${resolved_name}'" ;;
      *)    die "unsupported target type '${target_type}'" ;;
   esac

   rc=0
   "$callback" "$mount_point" "$resolved_name" \
      "$target_type" "$section" "$@" || rc=$?

   unmount_target_filesystem "$mount_point"

   return $rc
}

# Build and run a filesystem creation command.
# Parameters: $1 - section name
#             $2 - description for log messages (e.g. "ext4 filesystem")
#             $3 - base command (e.g. "mkfs.ext4")
#             $4 - label flag (e.g. "-L" or "-n"), or "" for no label support
#             $5 - device path
run_mkfs_command() {
   local section="$1"
   local description="$2"
   local base_cmd="$3"
   local label_flag="${4:-}"
   local device="$5"

   local -a cmd=("$base_cmd")

   if [[ -n "$label_flag" ]] && has_key "$section" "label"; then
      local label
      label="$(get_value "$section" "label")"
      cmd+=("$label_flag" "$label")
   fi

   if has_key "$section" "options"; then
      local options
      options="$(get_value "$section" "options")"
      local -a opts=()
      read -ra opts <<< "$options"
      cmd+=("${opts[@]}")
   fi

   cmd+=("$device")

   log "Creating ${description} on ${device}"
   log "  Command: ${cmd[*]}"
   run_cmd "${cmd[@]}"

   log "${description} created on ${device}."
}

# Prompt the user for a password using whiptail, with confirmation.
# Parameters: $1 - section name (userinput.password.*)
# Stores result in ANSWERS array
ask_password() {
   local section="$1"
   local variable
   variable="$(get_value "$section" "variable")"
   local prompt
   prompt="$(get_value "$section" "prompt")"
   expand_prompt "$prompt"; prompt="$_expand_value_result"

   while true; do
      local pass1=""
      pass1="$(whiptail --passwordbox "$prompt" 10 60 3>&1 1>&2 2>&3)" || {
         whiptail --msgbox "Password entry cancelled." 8 40
         continue
      }

      if [[ -z "$pass1" ]]; then
         whiptail --msgbox "Password cannot be empty. Please try again." 8 40
         continue
      fi

      local pass2=""
      pass2="$(whiptail --passwordbox "Confirm: $prompt" 10 60 3>&1 1>&2 2>&3)" || {
         whiptail --msgbox "Confirmation cancelled." 8 40
         continue
      }

      if [[ "$pass1" == "$pass2" ]]; then
         ANSWERS["$variable"]="$pass1"
         return
      else
         whiptail --msgbox "Passwords do not match. Please try again." 8 40
      fi
   done
}

# Detect the terminal width (columns) of the controlling terminal that
# whiptail draws on. Sets _term_cols_result. Tries /dev/tty first (the
# controlling terminal whiptail renders on), falling back to 80.
get_terminal_cols() {
   local sz
   if sz="$(stty size </dev/tty 2>/dev/null)" && [[ "$sz" == *' '* ]]; then
      _term_cols_result="${sz#* }"
   else
      _term_cols_result=80
   fi
   [[ -z "$_term_cols_result" || ! "$_term_cols_result" =~ ^[0-9]+$ ]] \
      && _term_cols_result=80
   (( _term_cols_result < 20 )) && _term_cols_result=80
}

# Prompt the user to select drives using whiptail checklist.
# Parameters: $1 - section name (userinput.drives.*)
# Stores result in ANSWERS array
ask_drives() {
   local section="$1"
   local variable
   variable="$(get_value "$section" "variable")"
   local prompt
   prompt="$(get_value "$section" "prompt")"
   expand_prompt "$prompt"; prompt="$_expand_value_result"
   local required_num
   required_num="$(get_value "$section" "number")"

   local -a disk_names=()
   local disk_output
   disk_output="$(lsblk -dno NAME,TYPE | awk '$2 == "disk" {print $1}')"
   while IFS= read -r name; do
      [[ -n "$name" ]] && disk_names+=("$name")
   done <<< "$disk_output"

   if [[ ${#disk_names[@]} -eq 0 ]]; then
      whiptail --msgbox "No drives detected on this system." 8 40
      die "no drives detected on this system"
   fi

   # Use the short kernel device name (e.g. "sda") as the checklist tag so
   # rows stay narrow, and map each back to its stable /dev/disk/by-id path.
   declare -A name_to_byid=()
   local -a checklist_items=()

   # whiptail clamps the window to the terminal size and wraps long rows.
   get_terminal_cols
   local win_width=$_term_cols_result
   (( win_width < 60 )) && win_width=60

   for name in "${disk_names[@]}"; do
      local size vendor model
      size="$(lsblk -dno SIZE "/dev/$name" 2>/dev/null | sed 's/^\s*//;s/\s*$//')" ||  \
         size="unknown"
      vendor="$(lsblk -dno VENDOR "/dev/$name" 2>/dev/null | sed 's/^\s*//;s/\s*$//')" ||  \
         vendor=""
      model="$(lsblk -dno MODEL "/dev/$name" 2>/dev/null | \
         sed 's/^\s*//;s/\s*$//')" || model=""

      local by_id=""
      for link in /dev/disk/by-id/*; do
         [[ ! -e "$link" ]] && continue
         local target
         target="$(readlink -f "$link")"
         if [[ "$(basename "$target")" == "$name" ]]; then
            by_id="$link"
            break
         fi
      done

      if [[ -z "$by_id" ]]; then
         by_id="/dev/${name}"
      fi

      name_to_byid["$name"]="$by_id"

      local display="${size}"
      [[ -n "$vendor" && "$vendor" != "0x"* ]] && display+=" ${vendor}"
      [[ -n "$model" ]] && display+=" ${model}"
      display+="  (${by_id})"
      display="$(printf '%s\n' "$display" | sed 's/^\s*//;s/\s*$//;s/\s\+/ /g')"

      checklist_items+=("$name" "$display" "OFF")
   done

   while true; do
      local selected
      selected="$(whiptail --title "$prompt" --checklist \
         "Select exactly ${required_num} drive(s). Use SPACE to toggle, ENTER to confirm." \
         $(( 8 + ${#disk_names[@]} )) $win_width ${#disk_names[@]} \
         "${checklist_items[@]}" \
         3>&1 1>&2 2>&3)" || {
         whiptail --msgbox "Drive selection cancelled." 8 40
         continue
      }

      local -a chosen_names=()
      # whiptail --checklist wraps each selected item in double quotes.
      # Strip the surrounding quotes before splitting on whitespace.
      local dequoted_selected="${selected//\"/}"
      read -ra chosen_names <<< "$dequoted_selected"

      if [[ ${#chosen_names[@]} -ne "$required_num" ]]; then
         whiptail --msgbox "You must select exactly ${required_num} drive(s). You selected \
            ${#chosen_names[@]}." 8 50
         continue
      fi

      # Map selected short names back to their stable /dev/disk/by-id paths.
      local -a chosen=()
      local n
      for n in "${chosen_names[@]}"; do
         chosen+=("${name_to_byid[$n]}")
      done

      ANSWERS["$variable"]="${chosen[*]}"
      return
   done
}

# Prompt the user for generic text input using whiptail.
# Parameters: $1 - section name (userinput.generic.*)
# Stores result in ANSWERS array
ask_generic() {
   local section="$1"
   local variable
   variable="$(get_value "$section" "variable")"
   local prompt
   prompt="$(get_value "$section" "prompt")"
   expand_prompt "$prompt"; prompt="$_expand_value_result"
   local max_length=""
   local input_type="any"

   if has_key "$section" "length"; then
      max_length="$(get_value "$section" "length")"
   fi

   if has_key "$section" "type"; then
      input_type="$(get_value "$section" "type")"
   fi

   while true; do
      local input=""
      input="$(whiptail --inputbox "$prompt" 10 60 3>&1 1>&2 2>&3)" || {
         whiptail --msgbox "Input cancelled." 8 40
         continue
      }

      if [[ -n "$max_length" ]] && [[ ${#input} -gt $max_length ]]; then
         whiptail --msgbox "Input too long. Maximum ${max_length} character(s). You entered \
            ${#input}." 8 50
         continue
      fi

      if [[ "$input_type" == "numeric" ]] && ! [[ "$input" =~ ^[0-9]*$ ]]; then
         whiptail --msgbox "Input must contain only numbers." 8 40
         continue
      fi

      ANSWERS["$variable"]="$input"
      return
   done
}

# Prompt the user for an IPv4 address using whiptail, with validation.
# Parameters: $1 - section name (userinput.ipv4address.*)
# Stores result in ANSWERS array
ask_ipv4address() {
   local section="$1"
   local variable
   variable="$(get_value "$section" "variable")"
   local prompt
   prompt="$(get_value "$section" "prompt")"
   expand_prompt "$prompt"; prompt="$_expand_value_result"

   while true; do
      local input=""
      input="$(whiptail --inputbox "$prompt" 10 60 3>&1 1>&2 2>&3)" || {
         whiptail --msgbox "Input cancelled." 8 40
         continue
      }

      if [[ -z "$input" ]]; then
         whiptail --msgbox "IPv4 address cannot be empty. Please try again." 8 40
         continue
      fi

      # Validate IPv4 address: four octets 0-255 separated by dots
      if ! [[ "$input" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]]; then
         whiptail --msgbox \
            "Invalid IPv4 address format. Expected format: X.X.X.X (e.g. 192.168.1.1)" 8 50
         continue
      fi

      local valid_ip=1
      local i
      for i in 1 2 3 4; do
         local octet="${BASH_REMATCH[$i]}"
         # Remove leading zeros for comparison (but allow '0' itself)
         octet="$((10#$octet))"
         if (( octet > 255 )); then
            valid_ip=0
            break
         fi
      done

      if [[ "$valid_ip" -eq 0 ]]; then
         whiptail --msgbox \
            "Invalid IPv4 address: each octet must be 0-255. Please try again." 8 50
         continue
      fi

      ANSWERS["$variable"]="$input"
      return
   done
}

# Convert a CIDR prefix length (0-32) to a dotted-decimal netmask.
# Parameters: $1 - prefix length (integer 0-32)
# Prints dotted-decimal netmask to stdout (e.g. "255.255.255.0").
cidr_to_netmask() {
   local prefix="$1"
   local mask=$(( (prefix == 0) ? 0 : (0xFFFFFFFF << (32 - prefix)) & 0xFFFFFFFF ))
   printf '%d.%d.%d.%d\n' \
      $(( (mask >> 24) & 0xFF )) \
      $(( (mask >> 16) & 0xFF )) \
      $(( (mask >> 8) & 0xFF )) \
      $(( mask & 0xFF ))
}

# Prompt the user for an IPv4 netmask using whiptail, with validation.
# Accepts dotted-decimal notation (e.g. 255.255.255.0) or a CIDR prefix
# length, with or without a leading slash (e.g. 24 or /24). Dotted-decimal
# values are validated as proper netmasks; CIDR prefix lengths are converted
# to dotted-decimal for storage.
# Parameters: $1 - section name (userinput.ipv4netmask.*)
# Stores result in ANSWERS array
ask_ipv4netmask() {
   local section="$1"
   local variable
   variable="$(get_value "$section" "variable")"
   local prompt
   prompt="$(get_value "$section" "prompt")"
   expand_prompt "$prompt"; prompt="$_expand_value_result"

   while true; do
      local input=""
      input="$(whiptail --inputbox "$prompt" 10 60 3>&1 1>&2 2>&3)" || {
         whiptail --msgbox "Input cancelled." 8 40
         continue
      }

      if [[ -z "$input" ]]; then
         whiptail --msgbox "IPv4 netmask cannot be empty. Please try again." 8 40
         continue
      fi

      # Check if input is a CIDR prefix length (0-32), with an optional
      # leading slash (e.g. "24" or "/24").
      if [[ "$input" =~ ^/?([0-9]+)$ ]]; then
         local prefix=$((10#${BASH_REMATCH[1]}))
         if (( prefix < 0 || prefix > 32 )); then
            whiptail --msgbox "CIDR prefix must be 0-32. You entered ${prefix}." 8 50
            continue
         fi
         input="$(cidr_to_netmask "$prefix")"
      fi

      # Validate dotted-decimal format: four octets 0-255 separated by dots
      if ! [[ "$input" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]]; then
         whiptail --msgbox \
            "Invalid IPv4 netmask format. Expected dotted-decimal \
            (e.g. 255.255.255.0) or CIDR prefix (e.g. 24 or /24)." 8 60
         continue
      fi

      local -a octets=()
      local valid_ip=1
      local i
      for i in 1 2 3 4; do
         local octet="${BASH_REMATCH[$i]}"
         octet="$((10#$octet))"
         if (( octet > 255 )); then
            valid_ip=0
            break
         fi
         octets+=("$octet")
      done

      if [[ "$valid_ip" -eq 0 ]]; then
         whiptail --msgbox \
            "Invalid IPv4 netmask: each octet must be 0-255. Please try again." 8 50
         continue
      fi

      # Validate that the octets form a proper netmask.
      # A valid netmask has contiguous 1-bits from the MSB, i.e., no '0'
      # bit appears before a '1' bit. We check this per-octet:
      # 1) Each octet must be a valid netmask value
      #    (0, 128, 192, 224, 240, 248, 252, 254, 255)
      # 2) Octets must be in non-increasing order, and once an octet
      #    is less than 255 and greater than 0, all subsequent must be 0.

      # Valid netmask octets: contiguous 1-bits from the left
      local -a valid_octet_values=(0 128 192 224 240 248 252 254 255)
      for i in 0 1 2 3; do
         local found=0
         local vo
         for vo in "${valid_octet_values[@]}"; do
            if [[ "${octets[$i]}" -eq "$vo" ]]; then
               found=1
               break
            fi
         done
         if [[ "$found" -eq 0 ]]; then
            whiptail --msgbox \
               "Invalid IPv4 netmask: each octet must be a valid netmask value \
               (contiguous 1-bits from the left)." 8 60
            valid_ip=0
            break
         fi
      done
      [[ "$valid_ip" -eq 0 ]] && continue

      # Check ordering: once we see an octet that is < 255 and > 0,
      # all subsequent octets must be 0.
      local seen_partial=0
      for i in 0 1 2 3; do
         if (( octets[i] > 0 && octets[i] < 255 )); then
            if [[ "$seen_partial" -eq 1 ]]; then
               valid_ip=0
               break
            fi
            seen_partial=1
         elif [[ "$seen_partial" -eq 1 ]] && (( octets[i] != 0 )); then
            valid_ip=0
            break
         fi
      done
      if [[ "$valid_ip" -eq 0 ]]; then
         whiptail --msgbox \
            "Invalid IPv4 netmask: bits must be contiguous (1s then 0s). \
            E.g. 255.255.255.0" 8 60
         continue
      fi

      ANSWERS["$variable"]="$input"
      return
   done
}

# Prompt the user to select network interfaces using whiptail checklist.
# Parameters: $1 - section name (userinput.netinterface.*)
# Stores result in ANSWERS array as a space-separated list
ask_netinterface() {
   local section="$1"
   local variable
   variable="$(get_value "$section" "variable")"
   local prompt
   prompt="$(get_value "$section" "prompt")"
   expand_prompt "$prompt"; prompt="$_expand_value_result"
   local required_num
   required_num="$(get_value "$section" "number")"

   local -a iface_names=()
   local -A iface_addrs=()
   local iface_output
   # Get non-loopback interfaces with their status and IPv4 addresses.
   # `ip -br addr` columns: <name> <state> <addrs...>; we collect IPv4 only.
   iface_output="$(ip -br addr 2>/dev/null)" || iface_output=""
   if [[ -n "$iface_output" ]]; then
      local _name _state _addrs
      # NOTE: default IFS (not "IFS=") so the line splits into name, state,
      # and the remaining address fields. With "IFS=" read would put the
      # whole line into _name, leaking state/IPv6/lo into iface_names and
      # making the checklist tag multi-word (which broke selection counting).
      while read -r _name _state _addrs; do
         [[ -z "$_name" || "$_name" == "lo" ]] && continue
         iface_names+=("$_name")
         # Keep only IPv4 entries (skip any IPv6 that slipped in).
         local _ipv4=()
         local _a
         for _a in $_addrs; do
            [[ "$_a" == *.* ]] && _ipv4+=("$_a")
         done
         [[ ${#_ipv4[@]} -gt 0 ]] && iface_addrs["$_name"]="${_ipv4[*]}"
      done <<< "$iface_output"
   fi
   # Fallback to /sys/class/net if ip is not available
   if [[ ${#iface_names[@]} -eq 0 ]]; then
      local iface
      for iface in /sys/class/net/*/; do
         iface="$(basename "$iface")"
         [[ "$iface" == "lo" ]] && continue
         iface_names+=("$iface")
      done
   fi

   if [[ ${#iface_names[@]} -eq 0 ]]; then
      whiptail --msgbox "No network interfaces detected on this system." 8 40
      die "no network interfaces detected on this system"
   fi

   local -a checklist_items=()
   for name in "${iface_names[@]}"; do
      local operstate="unknown"
      local mac=""
      local speed=""

      if [[ -f "/sys/class/net/${name}/operstate" ]]; then
         operstate="$(cat "/sys/class/net/${name}/operstate" \
            2>/dev/null)" || operstate="unknown"
      fi

      if [[ -f "/sys/class/net/${name}/address" ]]; then
         mac="$(cat "/sys/class/net/${name}/address" 2>/dev/null)" || mac=""
      fi

      if [[ -f "/sys/class/net/${name}/speed" ]]; then
         speed="$(cat "/sys/class/net/${name}/speed" 2>/dev/null)" || speed=""
      fi

      local addrs="${iface_addrs[$name]:-}"
      local display="${name}"
      [[ -n "$addrs" ]] && display+="  ${addrs}"
      display+="  ${operstate}"
      [[ -n "$mac" ]] && display+="  ${mac}"
      [[ -n "$speed" ]] && display+="  ${speed}Mbps"

      checklist_items+=("$name" "$display" "OFF")
   done

   # Compute a window width that fits the longest entry AND uses the
   # available terminal width. whiptail clamps to the terminal size, so
   # requesting a generous width is safe. The checklist row layout is
   # "[ ] <tag>  <display>", so the window must hold tag + display plus
   # borders/checkbox/separators; only accounting for the display left the
   # tag eating into the display column and truncating MAC/speed text.
   local term_cols
   get_terminal_cols
   term_cols=$_term_cols_result
   local max_tag=0 max_display=0 _i
   for (( _i=0; _i<${#checklist_items[@]}; _i+=3 )); do
      ((${#checklist_items[_i]}   > max_tag))     && max_tag=${#checklist_items[_i]}
      ((${#checklist_items[_i+1]} > max_display)) && max_display=${#checklist_items[_i+1]}
   done
   local content_need=$(( max_tag + max_display + 14 ))
   local win_width=$content_need
   (( win_width < 60 )) && win_width=60
   # Use the full terminal width when it exceeds the content need so the
   # dialog does not leave ample room unused on wide terminals. whiptail
   # clamps to the terminal width on narrow ones.
   (( term_cols > win_width )) && win_width=$term_cols

   while true; do
      local selected
      selected="$(whiptail --title "$prompt" --checklist \
         "Select exactly ${required_num} interface(s). Use SPACE to toggle, ENTER to confirm." \
         $(( 8 + ${#iface_names[@]} )) $win_width ${#iface_names[@]} \
         "${checklist_items[@]}" \
         3>&1 1>&2 2>&3)" || {
         whiptail --msgbox "Interface selection cancelled." 8 40
         continue
      }

      local -a chosen=()
      # whiptail --checklist wraps each selected item in double quotes.
      # Strip the surrounding quotes before splitting on whitespace.
      local dequoted_selected="${selected//\"/}"
      read -ra chosen <<< "$dequoted_selected"

      if [[ ${#chosen[@]} -ne "$required_num" ]]; then
         whiptail --msgbox "You must select exactly ${required_num} interface(s). You selected \
            ${#chosen[@]}." 8 50
         continue
      fi

      ANSWERS["$variable"]="${chosen[*]}"
      return
   done
}

# Show a whiptail yes/no dialog to confirm the configuration before proceeding.
confirm_config() {
   local description
   description="$(get_value "global" "description")"
   if ! whiptail --yesno "Configuration:\n\n${description}\n\nProceed with this configuration?" 12 \
      60; then
      die "configuration cancelled by user"
   fi
}

# Iterate through userinput sections and prompt the user for each one.
collect_user_input() {
   for section in "${SECTIONS[@]}"; do
      if [[ "$section" != userinput.* ]]; then
         continue
      fi

      local suffix="${section#userinput.}"
      local type="${suffix%%.*}"

      case "$type" in
         password)     ask_password "$section" ;;
         drives)       ask_drives "$section" ;;
         generic)      ask_generic "$section" ;;
         ipv4address)  ask_ipv4address "$section" ;;
         ipv4netmask) ask_ipv4netmask "$section" ;;
         netinterface) ask_netinterface "$section" ;;
      esac
   done
}

# Collect devices that will be created by actions in the config.
# Populates ACTION_DEVICES associative array with device paths as keys.
# Must be called after parse_ini and before sanity_check.
collect_action_devices() {
   ACTION_DEVICES=()

   for section in "${SECTIONS[@]}"; do
      if [[ "$section" != action.* ]]; then
         continue
      fi
      # Don't register devices for inactive (when=false) actions; they won't
      # be created, so later sanity checks must not treat them as action devices.
      if ! is_action_active "$section"; then
         continue
      fi
      if [[ "$section" == action.md.* ]]; then
         if has_key "$section" "device"; then
            local device
            device="$(get_value "$section" "device")"
            # Store with /dev/ prefix to normalize
            if [[ "$device" != /dev/* ]]; then
               device="/dev/${device}"
            fi
            ACTION_DEVICES["$device"]=1
         fi
      elif [[ "$section" == action.crypt.* ]]; then
         # The instance name is the mapper name: /dev/mapper/<instance>.
         local instance="${section#action.crypt.}"
         ACTION_DEVICES["/dev/mapper/${instance}"]=1
      fi
   done
}

# Check if a device path will be created by an action in the config.
# Checks both the device itself and its base (parent) device.
# For example, /dev/md1p1 returns true if /dev/md1 is an ACTION_DEVICES member.
# Parameters: $1 - device path
# Returns: 0 if device will be created by an action, 1 if not
is_action_device() {
   local dev="$1"

   # Direct match
   if [[ -n "${ACTION_DEVICES[$dev]+x}" ]]; then
      return 0
   fi

   # Check if base device is an action device (e.g. /dev/md1p1 → /dev/md1)
   local base_dev
   base_dev="$(strip_partition "$dev")"
   if [[ "$base_dev" != "$dev" ]] && [[ -n "${ACTION_DEVICES[$base_dev]+x}" ]]; then
      return 0
   fi

   # Also check readlink -f resolved path for both
   local real_dev
   real_dev="$(readlink -f "$dev" 2>/dev/null || printf '%s' "$dev")"
   if [[ "$real_dev" != "$dev" ]]; then
      if [[ -n "${ACTION_DEVICES[$real_dev]+x}" ]]; then
         return 0
      fi
      local real_base
      real_base="$(strip_partition "$real_dev")"
      if [[ "$real_base" != "$real_dev" ]] && \
         [[ -n "${ACTION_DEVICES[$real_base]+x}" ]]; then
         return 0
      fi
   fi

   return 1
}

# Run runtime sanity checks for all userinput and action sections.
# Returns: exits via die() if checks fail
sanity_check() {
   local failed=0

   for section in "${SECTIONS[@]}"; do
      if [[ "$section" == userinput.* ]]; then
         local suffix="${section#userinput.}"
         local type="${suffix%%.*}"

         case "$type" in
            drives)       sanity_check_drives "$section" || ((failed++)) ;;
            netinterface) sanity_check_netinterface "$section" || ((failed++)) ;;
         esac
      elif [[ "$section" == action.* ]]; then
         # Skip inactive (when=false) actions; their dependencies may not
         # exist on this hardware and they won't run anyway.
         if ! is_action_active "$section"; then
            continue
         fi
         dispatch_action sanity_check "$section" || ((failed++))
      fi
   done

   if [[ $failed -gt 0 ]]; then
      die "sanity check failed - this configuration" \
         "is not suitable for this hardware"
   fi
}

# Verify enough drives are available on the system for a drives userinput.
# Parameters: $1 - section name
# Returns: 0 if ok, 1 if not enough drives
sanity_check_drives() {
   local section="$1"
   local required_num
   required_num="$(get_value "$section" "number")"
   local prompt
   prompt="$(get_value "$section" "prompt")"

   local available_count
   available_count="$(lsblk -dno NAME,TYPE | awk '$2 == "disk"' | wc -l)"

   if [[ $available_count -lt $required_num ]]; then
      msg_error "Drive requirement not met: '${prompt}' requires ${required_num} \
         drive(s), but only ${available_count} available on this system."
      return 1
   fi

   return 0
}

# Verify enough network interfaces are available on the system for a userinput.
# netinterface
# Parameters: $1 - section name
# Returns: 0 if ok, 1 if not enough interfaces
sanity_check_netinterface() {
   local section="$1"
   local required_num
   required_num="$(get_value "$section" "number")"
   local prompt
   prompt="$(get_value "$section" "prompt")"

   local available_count=0
   local iface_output
   iface_output="$(ip -br link 2>/dev/null | \
      grep -v '^lo[[:space:]]' | awk '{print $1}')" || iface_output=""
   if [[ -n "$iface_output" ]]; then
      while IFS= read -r _name; do
         ((available_count++))
      done <<< "$iface_output"
   else
      local iface
      for iface in /sys/class/net/*/; do
         [[ "$(basename "$iface")" == "lo" ]] && continue
         ((available_count++))
      done
   fi

   if [[ $available_count -lt $required_num ]]; then
      msg_error "Network interface requirement not met: '${prompt}' requires ${required_num} \
         interface(s), but only ${available_count} available on this system."
      return 1
   fi

   return 0
}

# Verify zfs command and referenced pool availability.
# Parameters: $1 - section name
# Returns: 0 if ok, 1 if zfs missing or pool absent
sanity_check_zfs() {
   local section="$1"

   if has_key "$section" "pool"; then
      local pool_name
      pool_name="$(get_value "$section" "pool")"
      check_zfs_pool_available "$pool_name" "$section" || return 1
   else
      check_zfs_pool_available "" "$section" || return 1
   fi

   return 0
}

# Verify extract action dependencies and target filesystem availability.
# Parameters: $1 - section name
# Returns: 0 if ok, 1 if dependencies missing
sanity_check_extract() {
   local section="$1"

   if has_key "$section" "target"; then
      local target
      target="$(get_value "$section" "target")"
      sanity_check_target_filesystem "$target" "$section" || return 1
   fi

   return 0
}

# Verify file action target filesystem and dependencies.
# Parameters: $1 - section name
# Returns: 0 if ok, 1 if dependencies missing
sanity_check_file() {
   local section="$1"

   if has_key "$section" "target"; then
      local target
      target="$(get_value "$section" "target")"
      sanity_check_target_filesystem "$target" "$section" || return 1
   fi

   return 0
}

# Shared sanity check for mkfs-style actions (ext4, vfat, swap).
# Verifies the mkfs tool is available and the referenced device exists.
sanity_check_mkfs() {
   local section="$1" mkfs_cmd="$2"
   if ! command -v "$mkfs_cmd" &>/dev/null; then
      msg_error "${mkfs_cmd} is required but not found on this system."
      return 1
   fi
   if has_key "$section" "drive"; then
      local drive_val
      drive_val="$(get_value "$section" "drive")"
      check_drive_ref_exists "$drive_val" "$section" || return 1
   fi
   return 0
}

sanity_check_ext4() { sanity_check_mkfs "$1" mkfs.ext4; }
sanity_check_vfat() { sanity_check_mkfs "$1" mkfs.vfat; }

# Verify that drives referenced in a wipe action exist on the system.
# Parameters: $1 - section name
# Returns: 0 if ok, 1 if drive not found
sanity_check_wipe() {
   local section="$1"
   local drives_val
   drives_val="$(get_value "$section" "drives")"

   # Drive references require ANSWERS to be populated; skip if not yet available.
   # ANSWERS is populated by collect_user_input, which runs after sanity_check.
   local ref
   ref="$(parse_single_reference "$drives_val")" || ref=""
   if [[ -z "$ref" ]]; then
      return 0
   fi
   if [[ "$ref" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
      # Scalar variable - check if ANSWERS is populated for this variable
      if [[ -z "${ANSWERS[$ref]+x}" ]]; then
         return 0
      fi
   elif [[ "$ref" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)\[ ]]; then
      local varname="${BASH_REMATCH[1]}"
      if [[ -z "${ANSWERS[$varname]+x}" ]]; then
         return 0
      fi
   fi

   local expanded
   expand_value "$drives_val"; expanded="$_expand_value_result"
   local -a drives=()
   read -ra drives <<< "$expanded"

   for drive in "${drives[@]}"; do
      if [[ ! -e "$drive" ]]; then
         if is_action_device "$drive"; then
            : # Skip check — device will be created by an action
         else
            msg_error "Drive ${drive} referenced in [${section}] does not exist."
            return 1
         fi
      fi
   done

   return 0
}

# Verify partitioning dependencies and that referenced drives exist.
# Parameters: $1 - section name
# Returns: 0 if ok, 1 if dependencies missing
sanity_check_partition() {
   local section="$1"
   local drives_val
   drives_val="$(get_value "$section" "drives")"

   # Drive references require ANSWERS to be populated; skip if not yet available.
   local ref
   ref="$(parse_single_reference "$drives_val")" || ref=""
   if [[ -z "$ref" ]]; then
      return 0
   fi
   if [[ "$ref" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
      if [[ -z "${ANSWERS[$ref]+x}" ]]; then
         return 0
      fi
   elif [[ "$ref" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)\[ ]]; then
      local varname="${BASH_REMATCH[1]}"
      if [[ -z "${ANSWERS[$varname]+x}" ]]; then
         return 0
      fi
   fi

   local expanded
   expand_value "$drives_val"; expanded="$_expand_value_result"
   local -a drives=()
   read -ra drives <<< "$expanded"

   for drive in "${drives[@]}"; do
      if [[ ! -e "$drive" ]]; then
         if is_action_device "$drive"; then
            : # Skip check — device will be created by an action
         else
            msg_error "Drive ${drive} referenced in [${section}] does not exist."
            return 1
         fi
      fi
   done

   local ptype="gpt"
   if has_key "$section" "type"; then
      ptype="$(get_value "$section" "type")"
   fi

   if [[ "$ptype" == "gpt" ]] &&  \
      ! command -v sgdisk &>/dev/null; then
      msg_error "sgdisk is required for GPT partitioning" \
         "but not found on this system."
      return 1
   fi

   return 0
}

# Verify zpool command and referenced drive devices exist.
# Parameters: $1 - section name
# Returns: 0 if ok, 1 if dependencies missing
sanity_check_zpool() {
   local section="$1"
   local vdev_val
   if ! has_key "$section" "vdev"; then
      return 0
   fi
   vdev_val="$(get_value "$section" "vdev")"

   # Extract and check each drive reference in the vdev specification.
   # References like %drives[0]3% may point to partitions that don't exist
   # yet (created by action.partition earlier in the run). check_drive_ref_exists
   # handles this by only failing if the base drive itself is missing.
   local refs
   refs="$(extract_references "$vdev_val")" || refs=""
   while IFS= read -r ref; do
      [[ -z "$ref" ]] && continue
      # Reconstruct the %ref% syntax expected by check_drive_ref_exists
      check_drive_ref_exists "%${ref}%" "$section" || return 1
   done <<< "$refs"

   if ! command -v zpool &>/dev/null; then
      msg_error "zpool is required but not found on this system."
      return 1
   fi

   return 0
}

# Execute all action sections in config order.
run_actions() {
   for section in "${SECTIONS[@]}"; do
      if [[ "$section" != action.* ]]; then
         continue
      fi
      if ! is_action_active "$section"; then
         log "Skipping [${section}] (when condition is false)"
         continue
      fi
      dispatch_action run_action "$section"
   done
}

# Convert a human-readable size string (e.g. 512MB, 1GB) to MiB.
# Parameters: $1 - size string (e.g. 512MB, 1.5GB)
#             Recognized unit suffixes (case-insensitive):
#             B, K/KB/KiB, M/MB/MiB, G/GB/GiB, T/TB/TiB.
# SI suffixes (K, M, G, T; KB, MB, GB, TB) and binary suffixes (KiB, MiB, GiB,
# TiB)
#             are converted to bytes then to MiB. Bare numbers are treated as MiB.
# Returns: size in MiB via stdout (integer, rounded toward zero).
# Result is suitable for sgdisk/sfdisk 'M' (mebibyte) suffixes.
size_to_mib() {
   local size_str="$1"
   local size_lower="${size_str,,}"

   local num unit bytes
   if [[ "$size_lower" =~ \
      ^([0-9]+(\.[0-9]+)?)(kib|mib|gib|tib|kb|mb|gb|tb|k|m|g|t|b)?$ ]]; then
      num="${BASH_REMATCH[1]}"
      unit="${BASH_REMATCH[3]:-mib}"  # bare number defaults to MiB
      unit_to_bytes "$unit"
      bytes="$(awk "BEGIN{printf \"%.0f\", ${num} * ${_unit_to_bytes_result}}")"
   else
      die "invalid size string '${size_str}' (expected e.g. 512MB, 1.5GB)"
   fi

   convert_value_to_unit "$bytes" "mib"
   printf '%s\n' "$_convert_value_result"
}

# Partition drives according to the configuration.
# Parameters: $1 - section name
run_action_partition() {
   local section="$1"
   local drives_val
   drives_val="$(get_value "$section" "drives")"
   local expanded
   expand_value "$drives_val"; expanded="$_expand_value_result"
   local -a drives=()
   read -ra drives <<< "$expanded"

   local ptype="gpt"
   if has_key "$section" "type"; then
      ptype="$(get_value "$section" "type")"
   fi

   local -a part_nums=()
   local -a part_sizes=()
   local -a part_types=()

   for key in "${!CONFIG[@]}"; do
      local sec="${key%%:*}"
      local k="${key#*:}"
      if [[ "$sec" == "$section" ]] && [[ "$k" =~ ^part-([0-9]+)$ ]]; then
         local num="${BASH_REMATCH[1]}"
         local val="${CONFIG[$key]}"
         local expanded_val
         expand_value "$val"; expanded_val="$_expand_value_result"
         local size="${expanded_val%% *}"
         local typecode="${expanded_val##* }"

         part_nums+=("$num")
         part_sizes+=("$size")
         part_types+=("$typecode")
      fi
   done

   local -a sorted_indices
   readarray -t sorted_indices <<< "$(for i in "${!part_nums[@]}"; do \
      printf '%s %s\n' "${part_nums[$i]}" "$i"; done | sort -n | awk '{print $2}')"

   local size_for_sfdisk=""
   size_for_sfdisk+=","

   log "Partitioning drives: ${drives[*]} with ${ptype} table"

   for drive in "${drives[@]}"; do
      log "Creating partition table on ${drive}..."

      if [[ "$ptype" == "gpt" ]]; then
         if ! command -v sgdisk &>/dev/null; then
            die "sgdisk is required for GPT partitioning but not found"
         fi

         run_cmd sgdisk --clear "${drive}"

         for idx in "${sorted_indices[@]}"; do
            local pnum="${part_nums[$idx]}"
            local psize="${part_sizes[$idx]}"
            local ptypecode="${part_types[$idx]}"

            if [[ "$psize" == "remain" ]]; then
               log "  Partition ${pnum}: remaining space (type ${ptypecode})"
               run_cmd sgdisk --new "${pnum}::0" \
                  --typecode "${pnum}:${ptypecode}" "${drive}"
            else
               local mib
               mib="$(size_to_mib "$psize")"
               log "  Partition ${pnum}: ${psize} (${mib}MiB, type ${ptypecode})"
               run_cmd sgdisk --new "${pnum}::+${mib}M" --typecode "${pnum}:${ptypecode}" \
                  "${drive}"
            fi
         done
      else
         local sfdisk_script=""
         sfdisk_script="label: dos\n"

         for idx in "${sorted_indices[@]}"; do
            local pnum="${part_nums[$idx]}"
            local psize="${part_sizes[$idx]}"
            local ptypecode="${part_types[$idx]}"

            local mib
            if [[ "$psize" == "remain" ]]; then
               mib=""
               log "  Partition ${pnum}: remaining space (type ${ptypecode})"
            else
               mib="$(size_to_mib "$psize")"
               log "  Partition ${pnum}: ${psize} (${mib}MiB, type ${ptypecode})"
            fi

            sfdisk_script+="type=${ptypecode}"
            if [[ -n "$mib" ]]; then
               sfdisk_script+=", size=${mib}MiB"
            fi
            sfdisk_script+="\n"
         done

         run_cmd bash -c "printf '%b' '${sfdisk_script}' | sfdisk ${drive}"
      fi

   done
   # Probe new partitioning
   run_cmd_allow_fail partprobe "${drive}"
   run_cmd_allow_fail udevadm settle

   log "Partitioning complete."
}

# Create a ZFS pool as configured.
# Parameters: $1 - section name
# Build the zpool create command array for an action.zpool section.
# Sets _cmd_result (array) and _zpool_name, _zpool_vdev_display (strings).
# Parameters: $1 = section
build_zpool_cmd() {
   local section="$1"
   local pool_name="${section#action.zpool.}"
   _zpool_name="$pool_name"
   _zpool_vdev_display=""
   _cmd_result=()

   local vdev_val=""
   if has_key "$section" "vdev"; then
      vdev_val="$(get_value "$section" "vdev")"
   fi

   local expanded
   expand_value "$vdev_val"; expanded="$_expand_value_result"
   _zpool_vdev_display="$expanded"
   # Resolve crypt.<instance> back-references (opens the LUKS device on first
   # use) while preserving the display string above.
   resolve_drive_value "$vdev_val"; expanded="$_resolve_drive_value"

   _cmd_result=(zpool create)

   if has_key "$section" "fsoptions"; then
      local fsoptions
      fsoptions="$(get_value "$section" "fsoptions")"
      local -a fsopts=()
      read -ra fsopts <<< "$fsoptions"
      for opt in "${fsopts[@]}"; do
         _cmd_result+=(-o "$opt")
      done
   fi

   if has_key "$section" "options"; then
      local options
      options="$(get_value "$section" "options")"
      local -a mopts=()
      read -ra mopts <<< "$options"
      for opt in "${mopts[@]}"; do
         _cmd_result+=(-O "$opt")
      done
   fi

   _cmd_result+=("$pool_name")
   local -a vdev_tokens=()
   read -ra vdev_tokens <<< "$expanded"
   _cmd_result+=("${vdev_tokens[@]}")
}

run_action_zpool() {
   local section="$1"
   local pool_name="${section#action.zpool.}"
   if [[ "$pool_name" == "$section" ]]; then
      die "[${section}] has no instance name"
   fi
   if ! has_key "$section" "vdev"; then
      die "[${section}] missing required key 'vdev'"
   fi

   build_zpool_cmd "$section"

   log "Creating ZFS pool '${pool_name}'"
   log "  Command: ${_cmd_result[*]}"
   run_cmd "${_cmd_result[@]}"
   IMPORTED_POOLS+=("$pool_name")

   # Record the root dataset mountpoint so it can be cleaned up on export.
   # The default ZFS mountpoint is /<pool_name>, but it can be overridden
   # via -O mountpoint=... in the 'options' config key.
   local mount_dir
   mount_dir="$(zfs get -H -o value mountpoint "${pool_name}" 2>/dev/null)" || true
   if [[ -n "$mount_dir" ]] && \
      [[ "$mount_dir" != "none" ]] && \
      [[ "$mount_dir" != "-" ]]; then
      IMPORTED_POOL_MOUNTPOINTS["$pool_name"]="$mount_dir"
      log "  Root dataset mountpoint: ${mount_dir}"
   fi

   log "ZFS pool '${pool_name}' created."
}

# Create a ZFS dataset as configured.
# Parameters: $1 - section name
run_action_zfs() {
   local section="$1"
   local instance_name="${section#action.zfs.}"
   if [[ "$instance_name" == "$section" ]]; then
      die "[${section}] has no instance name"
   fi

   if ! has_key "$section" "dataset"; then
      die "[${section}] missing required key 'dataset'"
   fi
   local dataset_name
   dataset_name="$(get_value "$section" "dataset")"

   if ! has_key "$section" "pool"; then
      die "[${section}] missing required key 'pool'"
   fi
   local pool_name
   pool_name="$(get_value "$section" "pool")"

   local full_name="${pool_name}/${dataset_name}"

   local -a zfs_cmd=(zfs create -u -p)

   if has_key "$section" "properties"; then
      local properties
      properties="$(get_value "$section" "properties")"
      local -a props=()
      read -ra props <<< "$properties"
      for prop in "${props[@]}"; do
         zfs_cmd+=(-o "$prop")
      done
   fi

   zfs_cmd+=("$full_name")

   log "Creating ZFS dataset '${full_name}'"
   log "  Command: ${zfs_cmd[*]}"
   run_cmd "${zfs_cmd[@]}"

   log "ZFS dataset '${full_name}' created."
}

# Callback body for run_action_extract via with_target_mount.
_do_extract() {
   local mount_point="$1" resolved_name="$2" target_type="$3" section="$4"
      source="$5"

