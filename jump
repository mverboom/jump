# Shared runner for mkfs-style actions (ext4, vfat, swap).
# $2 description, $3 mkfs command, $4 label flag.
run_action_mkfs() {
   local section="$1" description="$2" base_cmd="$3" label_flag="$4"
   if ! has_key "$section" "drive"; then
      die "[${section}] missing required key 'drive'"
   fi
   local drive_val
   drive_val="$(get_value "$section" "drive")"
   local device
   resolve_drive_value "$drive_val"; device="$_resolve_drive_value"
   # A mkfs 'drive' is a single device; reject a multi-token result.
   local -a _devs=()
   read -ra _devs <<< "$device"
   if [[ ${#_devs[@]} -gt 1 ]]; then
      die "[${section}] 'drive' must reference a single device, got '${drive_val}'"
   fi
   run_mkfs_command "$section" "$description" "$base_cmd" "$label_flag" "${_devs[0]:-}"
}

run_action_ext4() { run_action_mkfs "$1" "ext4 filesystem" mkfs.ext4 -L; }
run_action_vfat() { run_action_mkfs "$1" "vfat filesystem" mkfs.vfat -n; }

# Validate a swap action section.
