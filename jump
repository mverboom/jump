   expand_value "$content"; content="$_expand_value_result"

   with_target_mount "$section" "$target" \
      "Adding authorized_keys entry on" _do_authorizedkeys "$content" \
      || die "[${section}] failed to add authorized_keys entry"

   log "authorized_keys entry added successfully."
}

