# Callback body for run_action_authorizedkeys via with_target_mount.
# Creates /root/.ssh (mode 0700, owned by root) if needed and appends the
# content (one key per line) to /root/.ssh/authorized_keys (mode 0600, owned
# by root), skipping entries already present (idempotent).
_do_authorizedkeys() {
   local mount_point="$1" resolved_name="$2" target_type="$3" \
      section="$4" content="$5"

   # Ensure /root/.ssh exists in the target filesystem
   local ssh_dir="${mount_point}/root/.ssh"
   log "  Ensuring ${ssh_dir} exists"
   mkdir -p "$ssh_dir" \
      || die "[${section}] failed to create ${ssh_dir}"
   chmod 0700 "$ssh_dir" \
      || die "[${section}] failed to set mode 0700 on /root/.ssh"

   local auth_keys="${ssh_dir}/authorized_keys"

   # Collect existing non-empty lines for duplicate detection (idempotent
   # append: skip entries already present in the file).
   local -A existing=()
   if [[ -f "$auth_keys" ]]; then
      local line
      while IFS= read -r line || [[ -n "$line" ]]; do
         [[ -n "$line" ]] && existing["$line"]=1
      done < "$auth_keys"
   fi

   # Build the list of new entries from content (one key per line), skipping
   # blank lines and entries already present (in the file or earlier in this
   # content block).
   local -a new_entries=()
   local content_line
   while IFS= read -r content_line || [[ -n "$content_line" ]]; do
      [[ -z "$content_line" ]] && continue
      if [[ -z "${existing["$content_line"]+set}" ]]; then
         new_entries+=("$content_line")
         existing["$content_line"]=1
      fi
   done <<< "$content"

   if (( ${#new_entries[@]} == 0 )); then
      log "  All authorized_keys entries already present, nothing added"
   else
      # Ensure the existing file ends with a newline so the first new entry
      # starts on its own line. tail -c 1 yields the last byte; command
      # substitution strips a trailing newline, so a non-empty result means
      # the file has content that does not end with a newline.
      if [[ -f "$auth_keys" ]]; then
         local last_byte
         last_byte="$(tail -c 1 "$auth_keys" 2>/dev/null)" || last_byte=""
         if [[ -n "$last_byte" ]]; then
            printf '\n' >> "$auth_keys"
         fi
      fi
      local entry
      for entry in "${new_entries[@]}"; do
         printf '%s\n' "$entry" >> "$auth_keys" \
            || die "[${section}] failed to write /root/.ssh/authorized_keys"
      done
      log "  Added ${#new_entries[@]} authorized_keys entry/entries"
   fi

   # Enforce SSH-required ownership and permissions (idempotent)
   if [[ -f "$auth_keys" ]]; then
      chmod 0600 "$auth_keys" \
         || die "[${section}] failed to set mode 0600 on /root/.ssh/authorized_keys"
      chown 0:0 "$auth_keys" 2>/dev/null || \
         log "WARNING: failed to chown /root/.ssh/authorized_keys to root"
   fi
   chown 0:0 "$ssh_dir" 2>/dev/null || \
      log "WARNING: failed to chown /root/.ssh to root"
}

# Add an authorized_keys entry for root on a target filesystem.
# Creates /root/.ssh if needed and appends the content (one key per line) to
# /root/.ssh/authorized_keys, skipping entries already present (idempotent).
