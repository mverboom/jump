#!/usr/bin/env bash
# Ensure glob expansion is enabled. Network-booted environments may
# inherit noglob (set -f) from the calling shell (initramfs scripts,
# PXE boot hooks, etc.), which silently breaks every glob pattern in
# the script (for loops over /dev/disk/by-id/*, partition enumeration
# patterns, etc.). Explicitly enable globbing so behavior is predictable
# regardless of the calling environment.
set +f

declare -A CONFIG
declare -A DUPLICATE_KEYS
declare -a SECTIONS
declare -A ANSWERS
declare -a IMPORTED_POOLS=()
declare -a CREATED_MD_DEVICES=()
declare -A IMPORTED_POOL_MOUNTPOINTS=()
declare -a TEMP_FILES=()
declare -a TEMP_DIRS=()
declare -A ACTION_DEVICES=()
# LUKS instances opened during the run (instance name → mapper /dev/mapper/<name>).
# CREATED_CRYPT_DEVICES preserves open order so they can be closed on exit;
# OPENED_CRYPT is an idempotency guard for ensure_crypt_open.
declare -a CREATED_CRYPT_DEVICES=()
declare -A OPENED_CRYPT=()

# Ordered list of action types; iteration order = execution order.
# Adding a new action type: add it here, add its ACTION_DESCRIPTIONS entry,
# and define validate_action_<type> / sanity_check_<type> / run_action_<type>.
# The dispatch helper below picks the right one.
# shellcheck disable=SC2034 # accessed indirectly via loop in action_description
readonly -a ACTION_TYPES=(
   wipe partition crypt zpool zfs extract file filemodify ext4 vfat swap \
   efibootmgr password sshhostkeys mkdir netifrename md mdadm crypttab \
   updateinitramfs authorizedkeys
)

# Per-action-type description template, indexed by ACTION_TYPES. The string
# "__zfs__" is a sentinel handled specially by action_description (it
# substitutes the dataset name for the instance). Other templates are
# printf-style: %s is replaced with the instance name, %% is a literal %.
readonly -a ACTION_DESCRIPTIONS=(
   'Wiping drives (%s)'
   'Partitioning drives (%s)'
   'Creating LUKS device (%s)'
   'Creating ZFS pool "%s"'
   '__zfs__'
   'Extracting "%s"'
   'Writing file "%s"'
   'Modifying file "%s"'
   'Creating ext4 filesystem (%s)'
   'Creating vfat filesystem (%s)'
   'Creating swap (%s)'
   'Creating EFI boot entry (%s)'
   'Setting password (%s)'
   'Generating SSH host keys (%s)'
   'Creating directory (%s)'
   'Renaming network interface (%s)'
   'Creating MD RAID device (%s)'
   'Creating mdadm.conf (%s)'
   'Writing /etc/crypttab (%s)'
   'Updating initramfs (%s)'
   'Adding authorized_keys entry (%s)'
)

VALIDATE_ONLY=false
UNATTENDED=false
UNATTENDED_FILE=""
CONFIG_URL=""
LOG_FILE=""
HAD_ERRORS=false
DONE_FEEDBACK=""
DONE_ACTION=""
DONE_FAILACTION=""
_resolve_result=""
_expand_value_result=""
_resolve_lenient=false
_unit_to_bytes_result=""
_convert_value_result=""
_expand_vars_result=""
_declare_include_vars="declare -A _INCLUDE_VARS"
_fetch_include_result=""
_fetch_config_result=""
_process_includes_result=""
_inject_starturl_result=""
_starturl_injected=false
_startbaseurl_injected=false

# Dispatch to a per-action-type function. Returns the function's exit
# status, or 127 if the type has no such function. Does not print.
# Parameters: $1 verb (validate_action|sanity_check|run_action)
#             $2 section
dispatch_action() {
   local verb="$1" section="$2"
   local type="${section#action.}"; type="${type%%.*}"
   local fn="${verb}_${type}"
   if declare -F "$fn" &>/dev/null; then
      "$fn" "$section"
   else
      return 127
   fi
}

# Clean up temporary files and directories on exit.
# Called via trap to ensure temp resources are removed even on signals.
# Unmounts any mounted filesystems (reverse order for nested mounts) before
# removing directories.
cleanup() {
   local item i
   # Unmount any mounted filesystems in reverse order (handles nested mounts)
   for (( i=${#TEMP_DIRS[@]}-1; i>=0; i-- )); do
      umount "${TEMP_DIRS[$i]}" 2>/dev/null || true
   done
   # Remove temp directories
   for item in "${TEMP_DIRS[@]}"; do
      if [[ -d "$item" ]]; then
         rmdir "$item" 2>/dev/null || true
      fi
   done
   for item in "${TEMP_FILES[@]}"; do
      rm -f "$item" 2>/dev/null || true
   done
}

# Print an error message and exit (or show completion menu in validate mode).
# Parameters: message words (joined as $*)
# Returns: never (exits in validate mode; calls show_completion_menu otherwise)
die() {
   local msg="$*"
   HAD_ERRORS=true

   if [[ -n "$LOG_FILE" ]] && [[ -f "$LOG_FILE" ]]; then
      local err_msg
      err_msg="$(date '+%Y-%m-%d %H:%M:%S') ERROR: $msg"
      printf '%s\n' "$err_msg" >> "$LOG_FILE"
      if [[ "$UNATTENDED" == "true" ]]; then
         printf '%s\n' "$err_msg" >&2
      fi
   else
      printf '%s\n' "error: $msg" >&2
   fi

   [[ "$VALIDATE_ONLY" == "true" ]] && exit 1

   if [[ "$UNATTENDED" == "true" ]]; then
      run_feedback "failure"
      run_done_action "$DONE_FAILACTION"
      exit 1
   fi

   show_completion_menu
}

# Fail a reference resolution. In strict mode (the default) this dies with
# the given message and never returns. In lenient mode (_resolve_lenient=true)
# it clears _resolve_result and returns 1 so the caller can fall back to
# leaving the %ref% text verbatim instead of aborting. Used during prompt
# expansion, where an unresolvable reference (e.g. a variable not yet
# collected) should be shown literally rather than killing input collection.
# Parameters: message words (joined as $*)
# Returns: 1 in lenient mode; never returns in strict mode
_resolve_fail() {
   if [[ "$_resolve_lenient" == "true" ]]; then
      _resolve_result=""
      return 1
   fi
   die "$@"
}

# Check that all required external commands are available.
# Parameters: none
# Returns: exits with error if any dependency is missing
check_deps() {
   local missing=()

   for cmd in curl lsblk tar; do
      if ! command -v "$cmd" &>/dev/null; then
         missing+=("$cmd")
      fi
   done

   # whiptail is only required for interactive mode
   if [[ "$UNATTENDED" == "false" ]]; then
      if ! command -v whiptail &>/dev/null; then
         missing+=("whiptail")
      fi
   fi

   if [[ ${#missing[@]} -gt 0 ]]; then
      die "missing required dependencies: ${missing[*]}"
   fi
}

# Fetch an include URL to a temporary file.
# Fetch an include URL to a temporary file.
# Parameters: $1 - URL to fetch
# Sets _fetch_include_result with the temp file path (not stdout) so
# die() can exit the main process properly.
fetch_include() {
   local url="$1"
   local tmpfile
   tmpfile="$(mktemp)"
   TEMP_FILES+=("$tmpfile")

   if ! curl --silent --show-error --fail --output "$tmpfile" "$url"; then
      rm -f "$tmpfile"
      die "failed to fetch include from ${url}"
   fi

   _fetch_include_result="$tmpfile"
}

# Recursively resolve [include ...] directives in a config file.
# Writes resolved content to the output file, replacing each [include ...]
# line with the contents of the referenced file or URL. Nested includes
# are resolved depth-first up to MAX_INCLUDE_DEPTH (5).
# Parameters: $1 - input file path
#             $2 - base directory for resolving relative paths (empty for URL-fetched files)
#             $3 - current include depth (0 = top level)
#             $4 - output file path (appended to)
resolve_includes() {
   local input_file="$1"
   local base_dir="$2"
   local depth="$3"
   local output_file="$4"
   local max_depth=5
   local line source inc_dir

   if [[ "$depth" -ge "$max_depth" ]]; then
      die "maximum include depth (${max_depth}) exceeded — check for circular includes (while processing ${input_file})"
   fi

   # Track var sections during include resolution so %var% references
   # in include paths can be resolved. Only the var name and value are
   # tracked; full iterative expansion is done in process_user_vars later.
   local current_var_name=""

   while IFS= read -r line || [[ -n "$line" ]]; do
      # Check for [include ...] directives FIRST — these lines also
      # match the section header pattern, so must be checked first.
      # Expand %var% references in the include source path using
      # known vars from previously processed [var.name] sections.
      if [[ "$line" =~ ^\[include[[:space:]]+([^]]+)\]$ ]]; then
         source="$(trim "${BASH_REMATCH[1]}")"

         # Expand %var% references in the include source path
         # using known vars from previously included files.
         # Iteratively expand to resolve inter-var references.
         local changed=true
         local iter=0
         while [[ "$changed" == "true" ]] && [[ $iter -lt 100 ]]; do
            changed=false
            iter=$((iter + 1))
            local vname
            for vname in "${!_INCLUDE_VARS[@]}"; do
               local vval="${_INCLUDE_VARS[$vname]}"
               # Only expand if the source still contains %vname%
               if [[ "$source" == *"%${vname}%"* ]]; then
                  # Use simple string replacement
                  source="${source//%${vname}%/$vval}"
                  changed=true
               fi
            done
         done

         log "Including ${source}"

         if [[ "$source" =~ ^https?:// ]]; then
            fetch_include "$source"
            resolve_includes "$_fetch_include_result" "" "$((depth + 1))" "$output_file"
         else
            # Resolve relative paths against the including file's directory
            if [[ "$source" != /* ]]; then
               if [[ -z "$base_dir" ]]; then
                  die "cannot resolve relative include '${source}' — parent file has no directory context (in ${input_file})"
               fi
               source="${base_dir}/${source}"
            fi
            if [[ ! -f "$source" ]]; then
               die "include file not found: ${source} (in ${input_file})"
            fi
            inc_dir="$(cd "$(dirname "$source")" && pwd)"
            resolve_includes "$source" "$inc_dir" "$((depth + 1))" "$output_file"
         fi
         continue
      fi

      # Check for multiline continuation — these are literal content,
      # not var definitions, so just pass through.
      if [[ -n "$current_var_name" ]] && [[ "$line" =~ ^$'\t' ]]; then
         # Multiline continuation of a var value — append to the value
         local continuation="${line#$'\t'}"
         if [[ -n "${_INCLUDE_VARS[$current_var_name]+x}" ]]; then
            _INCLUDE_VARS["$current_var_name"]+="\n$continuation"
         fi
         printf '%s\n' "$line" >> "$output_file"
         continue
      fi

      # Detect section headers
      if [[ "$line" =~ ^\[([^]]+)\]$ ]]; then
         local section_name="${BASH_REMATCH[1]}"
         local section_trimmed
         section_trimmed="$(trim "$section_name")"

         # Track if we're entering a [var.name] section
         if [[ "$section_trimmed" == var.* ]]; then
            current_var_name="${section_trimmed#var.}"
         else
            current_var_name=""
         fi
         printf '%s\n' "$line" >> "$output_file"
         continue
      fi

      # If we're in a var section, look for value = ... lines
      if [[ -n "$current_var_name" ]] && [[ "$line" =~ ^[a-zA-Z_][a-zA-Z0-9_-]*[[:space:]]*= ]]; then
         local key="${line%%=*}"
         key="$(trim "$key")"
         if [[ "$key" == "value" ]]; then
            local value="${line#*=}"
            value="$(trim "$value")"
            # Strip surrounding quotes (same logic as parse_ini)
            if [[ "$value" == \"*\" ]]; then
               local stripped_quotes
               stripped_quotes="${value//\"/}"
               local quote_count=$(( ${#value} - ${#stripped_quotes} ))
               if [[ $quote_count -eq 2 ]]; then
                  value="${value#\"}"
                  value="${value%\"}"
               fi
            fi
            # Store the raw value (may contain %var% references)
            _INCLUDE_VARS["$current_var_name"]="$value"
         fi
      fi

      # All other lines are written to the output as-is
      printf '%s\n' "$line" >> "$output_file"
   done < "$input_file"
}

# Process all [include ...] directives in a config file.
# Sets _process_includes_result with the path to a temp file containing
# the resolved config (not stdout) so die() can exit the main process
# properly and log() output is not captured by command substitution.
# Parameters: $1 - input file path
process_includes() {
   local input_file="$1"

   local base_dir
   base_dir="$(cd "$(dirname "$input_file")" && pwd)"

   local tmpfile
   tmpfile="$(mktemp)"
   TEMP_FILES+=("$tmpfile")

   # Initialize the include-time variable tracking array.
   # This is populated by resolve_includes as [var.name] sections
   # are encountered, allowing %var% references in include paths.
   eval "$_declare_include_vars"
   _INCLUDE_VARS=()

   resolve_includes "$input_file" "$base_dir" 0 "$tmpfile"

   _process_includes_result="$tmpfile"
}

# Inject [var.starturl] and [var.startbaseurl] sections into the config file
# when the initial configuration was fetched from a URL.
# - starturl: the base URL (URL without the filename) — e.g. http://example.com/js/
# - startbaseurl: the URL up to and including the host — e.g. http://example.com
# For example, if the config was fetched from http://example.com/js/jump,
#   starturl     = http://example.com/js/
#   startbaseurl = http://example.com
# Parameters: $1 - config file path
#             $2 - config URL or path
# Sets _inject_starturl_result with the path to the (possibly modified)
# config file. If no injection is needed (local file), the original path
# is returned unchanged.
inject_starturl() {
   local config_file="$1"
   local config_url="$2"

   # Only inject for HTTP URLs
   if [[ "$config_url" != http://* ]] && [[ "$config_url" != https://* ]]; then
      _inject_starturl_result="$config_file"
      return
   fi

   # Compute starturl: strip after last / and add trailing /
   local starturl="${config_url%/*}/"

   # Compute startbaseurl: extract the scheme://host part
   # Remove the path portion after the host. Handles hostnames with ports.
   # e.g. http://example.com:8080/js/jump -> http://example.com:8080
   local startbaseurl
   startbaseurl="$(echo "$config_url" | sed -E 's#^(https?://[^/]+).*$#\1#')"

   local tmpfile
   tmpfile="$(mktemp)"
   TEMP_FILES+=("$tmpfile")

   # Prepend the var sections to the config file
   {
      printf '[var.starturl]\n'
      printf 'value = %s\n' "$starturl"
      printf '\n'
      printf '[var.startbaseurl]\n'
      printf 'value = %s\n' "$startbaseurl"
      printf '\n'
      cat "$config_file"
   } > "$tmpfile"

   log "Auto-defined variable: starturl=%s" "$starturl"
   log "Auto-defined variable: startbaseurl=%s" "$startbaseurl"

   _starturl_injected=true
   _startbaseurl_injected=true
   _inject_starturl_result="$tmpfile"
}

# Expand user-defined variable references (%varname%) in a string.
# Only replaces references where varname is a known user variable from
# [var.name] sections. Leaves all other %...% references (user input,
# built-ins) and %% escapes untouched for later processing by expand_value().
#
# Supports both scalar references (%varname%) and indexed references
# (%varname[idx]%, %varname[idx]part%) to user-defined variables. An
# indexed reference is expanded only when the variable's value is a
# single %inner% reference to a bare variable name; the index/partition
# suffix is then applied to the inner reference. This allows a user
# variable to act as an alias for a userinput array (e.g.
# var.devboot = %drives% used as %devboot[0]2%).
# Parameters: $1 - text to expand
#             $2 - nameref to associative array of var_name -> var_value
# Sets _expand_vars_result with the expanded string.
_expand_vars_in_string() {
   local text="$1"
   local -n _evs_vars="$2"
   local result="" remaining="$text"

   while [[ -n "$remaining" ]]; do
      # Check for %% (escaped literal percent) - leave untouched
      # for later expand_value() to handle.
      if [[ "$remaining" == %%* ]]; then
         result+="%%"
         remaining="${remaining:2}"
         continue
      fi

      # Check for %ref% where ref is a known user variable
      if [[ "$remaining" =~ ^%([^%]+)% ]]; then
         local ref="${BASH_REMATCH[1]}"
         local match_len=${#BASH_REMATCH[0]}
         if [[ -n "${_evs_vars[$ref]+x}" ]]; then
            # Known var - replace with its value
            result+="${_evs_vars[$ref]}"
            remaining="${remaining:${match_len}}"
            continue
         fi

         # Check for indexed reference %varname[idx]% or %varname[idx]part%
         # where varname is a known user variable whose value is a single
         # %inner% reference to a bare variable name. Rewrite to apply the
         # index/partition to the inner reference.
         local idx_varname idx_part inner_var
         if [[ "$ref" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)\[([0-9]+)\]([0-9]+)$ ]]; then
            idx_varname="${BASH_REMATCH[1]}"
            idx_part="${BASH_REMATCH[2]}]${BASH_REMATCH[3]}"
         elif [[ "$ref" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)\[([0-9]+)\]$ ]]; then
            idx_varname="${BASH_REMATCH[1]}"
            idx_part="${BASH_REMATCH[2]}"
         fi
         if [[ -n "$idx_varname" ]] && [[ -n "${_evs_vars[$idx_varname]+x}" ]]; then
            local idx_value="${_evs_vars[$idx_varname]}"
            if [[ "$idx_value" =~ ^%([a-zA-Z_][a-zA-Z0-9_]*)%$ ]]; then
               inner_var="${BASH_REMATCH[1]}"
               result+="%${inner_var}[${idx_part}%"
               remaining="${remaining:${match_len}}"
               continue
            fi
         fi

         # Unknown reference - leave as-is for later processing
         # by expand_value().
         result+="%${ref}%"
         remaining="${remaining:${match_len}}"
         continue
      fi

      # Check for unmatched % (start of an incomplete reference)
      if [[ "$remaining" =~ ^% ]]; then
         result+="%"
         remaining="${remaining:1}"
         continue
      fi

      # Consume text up to next % or end of string
      local before_pct="${remaining%%\%*}"
      if [[ "$before_pct" == "$remaining" ]]; then
         result+="$remaining"
         break
      fi
      result+="$before_pct"
      remaining="${remaining:${#before_pct}}"
   done

   _expand_vars_result="$result"
}

# Validate a user-defined variable name.
# Parameters: $1 - variable name
#             $2 - source description for error messages (e.g. "[var.foo]" or
#                  "var.foo in [action.zfs.root_debian]")
# Dies if the name is invalid, reserved, or conflicts with a userinput variable.
# Returns 0 on success.
validate_variable_name() {
   local var_name="$1"
   local source="$2"

   if ! [[ "$var_name" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
      die "invalid variable name '${var_name}' in ${source} (must match [a-zA-Z_][a-zA-Z0-9_]*)"
   fi

   # Check for conflicts with built-in and auto-defined references.
   # 'active' is a standalone built-in reference (%active%).
   # 'mac', 'diskid', 'disksize', 'memory' are prefixes for built-in
   # references (%mac:XX:XX:XX:XX:XX:XX%, etc.).
   # 'starturl'/'startbaseurl' are auto-defined when the initial config is
   # fetched from a URL. Using these as var names would shadow
   # built-in/auto-defined references.
   # 'drive' is an action-local variable set during [action.efibootmgr]
   # iteration when the 'drives' key is used.
   case "$var_name" in
      drive)
         die "variable name 'drive' is reserved for the action-local %drive% variable used by [action.efibootmgr] (in ${source})"
         ;;
      active)
         die "variable name 'active' is reserved for built-in reference %active% (in ${source})"
         ;;
      mac)
         die "variable name 'mac' is reserved for built-in reference %mac:XX:XX:XX:XX:XX:XX% (in ${source})"
         ;;
      diskid)
         die "variable name 'diskid' is reserved for built-in reference %diskid:<glob>% (in ${source})"
         ;;
      disksize)
         die "variable name 'disksize' is reserved for built-in reference %disksize:<spec>% (in ${source})"
         ;;
      memory)
         die "variable name 'memory' is reserved for built-in reference %memory:<factor>[,<unit>]% (in ${source})"
         ;;
      starturl)
         if [[ "$_starturl_injected" != "true" ]]; then
            die "variable name 'starturl' is reserved for the auto-defined %starturl% variable (base URL of the initial configuration) (in ${source})"
         fi
         ;;
      startbaseurl)
         if [[ "$_startbaseurl_injected" != "true" ]]; then
            die "variable name 'startbaseurl' is reserved for the auto-defined %startbaseurl% variable (host portion of the initial configuration URL) (in ${source})"
         fi
         ;;
   esac

   # Check for conflicts with userinput variable names
   local sec
   for sec in "${SECTIONS[@]}"; do
      if [[ "$sec" == userinput.* ]] && has_key "$sec" "variable"; then
         local ui_var
         ui_var="$(get_value "$sec" "variable")"
         if [[ "$var_name" == "$ui_var" ]]; then
            die "variable name '${var_name}' conflicts with user input variable in [${sec}] (in ${source})"
         fi
      fi
   done
}

# Process user-defined variables from [var.name] sections and action sections.
# Collects all [var.name] sections and all var.<name> keys in action.* sections,
# validates them, resolves inter-variable references (including forward
# references), expands %varname% references in all CONFIG values, and removes
# [var.name] sections and action var.<name> keys from CONFIG/SECTIONS.
# Must be called after parse_ini() and before validate_config().
# Dies on errors: missing value key, invalid var name, name conflicts,
# or circular references.
process_user_vars() {
   local -A user_vars=()
   local -a var_sections=()
   local -a action_var_keys=()
   local section var_name var_value key

   # Collect var definitions from [var.name] sections.
   for section in "${SECTIONS[@]}"; do
      if [[ "$section" == var.* ]]; then
         var_name="${section#var.}"

         validate_variable_name "$var_name" "[${section}]"

         # Check for duplicate var sections
         if [[ -n "${user_vars[$var_name]+x}" ]]; then
            die "duplicate variable definition '${var_name}' in [${section}]"
         fi

         # Check for required 'value' key
         if ! has_key "$section" "value"; then
            die "[${section}] missing required key 'value'"
         fi

         var_value="$(get_value "$section" "value")"
         user_vars["$var_name"]="$var_value"
         var_sections+=("$section")
      fi
   done

   # Collect var definitions from action sections (var.<name> = value).
   for section in "${SECTIONS[@]}"; do
      [[ "$section" == action.* ]] || continue

      for key in "${!CONFIG[@]}"; do
         local key_section="${key%%:*}"
         [[ "$key_section" != "$section" ]] && continue

         local key_name="${key#*:}"
         [[ "$key_name" == var.* ]] || continue

         var_name="${key_name#var.}"
         [[ -n "$var_name" ]] || continue

         validate_variable_name "$var_name" "${key_name} in [${section}]"

         # Check for duplicate var definitions
         if [[ -n "${user_vars[$var_name]+x}" ]]; then
            die "duplicate variable definition '${var_name}' in [${section}]"
         fi

         # Check for duplicate var.<name> keys within this action section
         if [[ -n "${DUPLICATE_KEYS[$key]+x}" ]]; then
            die "duplicate variable definition '${key_name}' in [${section}]"
         fi

         var_value="${CONFIG[$key]}"
         user_vars["$var_name"]="$var_value"
         action_var_keys+=("$key")
      done

      # Collect legacy-style var definitions (var = name:value).
      # This is an older shorthand supported for compatibility with
      # recipes that predate the var.<name> syntax.
      local legacy_var_key="${section}:var"
      if [[ -n "${CONFIG[$legacy_var_key]+x}" ]]; then
         local legacy_value="${CONFIG[$legacy_var_key]}"
         # Split on the first colon: name:value
         if [[ "$legacy_value" == *:* ]]; then
            local legacy_var_name="${legacy_value%%:*}"
            local legacy_var_value="${legacy_value#*:}"
            legacy_var_name="$(trim "$legacy_var_name")"
            legacy_var_value="$(trim "$legacy_var_value")"

            [[ -n "$legacy_var_name" ]] || die "empty variable name in 'var = ${legacy_value}' in [${section}]"
            validate_variable_name "$legacy_var_name" "var in [${section}]"

            if [[ -n "${user_vars[$legacy_var_name]+x}" ]]; then
               die "duplicate variable definition '${legacy_var_name}' in [${section}]"
            fi

            # Check for duplicate 'var' keys within this action section
            if [[ -n "${DUPLICATE_KEYS[$legacy_var_key]+x}" ]]; then
               die "duplicate variable definition 'var' in [${section}]"
            fi

            user_vars["$legacy_var_name"]="$legacy_var_value"
            action_var_keys+=("$legacy_var_key")
         fi
      fi
   done

   # If no var definitions, nothing to do
   if [[ ${#user_vars[@]} -eq 0 ]]; then
      return 0
   fi

   # Iteratively expand var values that reference other vars.
   # Supports forward references (vars defined later in the config).
   # Detects circular references by limiting iterations.
   local changed=true
   local iteration=0
   local max_iterations=100
   while [[ "$changed" == "true" ]] && [[ $iteration -lt $max_iterations ]]; do
      changed=false
      iteration=$((iteration + 1))
      for var_name in "${!user_vars[@]}"; do
         local old_value="${user_vars[$var_name]}"
         _expand_vars_in_string "$old_value" user_vars
         local new_value="$_expand_vars_result"
         if [[ "$new_value" != "$old_value" ]]; then
            user_vars["$var_name"]="$new_value"
            changed=true
         fi
      done
   done

   # Check for circular references: any var value still containing
   # %varname% where varname is a known var means unresolvable.
   for var_name in "${!user_vars[@]}"; do
      local value="${user_vars[$var_name]}"
      local refs
      refs="$(extract_references "$value")" || refs=""
      while IFS= read -r ref; do
         [[ -z "$ref" ]] && continue
         if [[ -n "${user_vars[$ref]+x}" ]]; then
            die "circular variable reference detected: variable '${var_name}'" \
               "value '${value}' references '${ref}' which cannot be resolved"
         fi
      done <<< "$refs"
   done

   # Expand all CONFIG values using resolved var values
   for key in "${!CONFIG[@]}"; do
      local value="${CONFIG[$key]}"
      _expand_vars_in_string "$value" user_vars
      CONFIG["$key"]="$_expand_vars_result"
   done

   # Remove var sections from SECTIONS and CONFIG
   local -a new_sections=()
   for section in "${SECTIONS[@]}"; do
      if [[ "$section" != var.* ]]; then
         new_sections+=("$section")
      fi
   done
   SECTIONS=("${new_sections[@]}")

   for section in "${var_sections[@]}"; do
      for key in "${!CONFIG[@]}"; do
         local sec="${key%%:*}"
         if [[ "$sec" == "$section" ]]; then
            unset "CONFIG[$key]"
         fi
      done
      # Also clean up DUPLICATE_KEYS entries for this section
      for key in "${!DUPLICATE_KEYS[@]}"; do
         local sec="${key%%:*}"
         if [[ "$sec" == "$section" ]]; then
            unset "DUPLICATE_KEYS[$key]"
         fi
      done
   done

   # Remove action var.<name> keys from CONFIG and DUPLICATE_KEYS
   for key in "${action_var_keys[@]}"; do
      unset "CONFIG[$key]"
      unset "DUPLICATE_KEYS[$key]"
   done
}

# Parse an INI-style configuration file into the CONFIG associative array.
# Parameters: $1 - file path to parse
# Populates global CONFIG and SECTIONS arrays
parse_ini() {
   local file="$1"
   local current_section=""
   local multiline_key=""
   local multiline_section=""
   local multiline_continuation=false

   while IFS= read -r line || [[ -n "$line" ]]; do
      # Check for multiline continuation (raw line starts with a tab).
      # Everything after the leading tab is literal content - no comment
      # stripping or quote processing.
      if [[ -n "$multiline_key" ]] && [[ "$line" =~ ^$'\t' ]]; then
         local continuation="${line#$'\t'}"
         CONFIG["${multiline_section}:${multiline_key}"]+=$'\n'"$continuation"
         multiline_continuation=true
         continue
      fi

      # Preserve multiline state across blank lines (treat as empty
      # continuation lines) to handle editors that strip trailing
      # whitespace. Only when multiline_continuation=true.
      if [[ -n "$multiline_key" ]] && [[ -z "$line" ]]; then
         if [[ "$multiline_continuation" == true ]]; then
            CONFIG["${multiline_section}:${multiline_key}"]+=$'\n'
         fi
         continue
      fi

      # Not a continuation - clear multiline tracking
      multiline_key=""
      multiline_section=""
      multiline_continuation=false

      line="${line%%#*}"
      line="${line%%;*}"
      line="$(trim "$line")"

      [[ -z "$line" ]] && continue

      if [[ "$line" =~ ^\[([^]]+)\]$ ]]; then
         current_section="${BASH_REMATCH[1]}"
         SECTIONS+=("$current_section")
         continue
      fi

      if [[ -n "$current_section" ]] &&  \
         [[ "$line" =~ ^[a-zA-Z_][a-zA-Z0-9_.-]*[[:space:]]*= ]]; then
         local key="${line%%=*}"
         key="$(trim "$key")"
         local value="${line#*=}"
         value="$(trim "$value")"
         # Strip surrounding quotes only when they form a single
         # enclosing pair. If the value contains more than 2 quotes,
         # the quotes are data (e.g. content with embedded quotes)
         # and must be preserved.
         if [[ "$value" == \"*\" ]]; then
            local stripped_quotes
            stripped_quotes="${value//\"/}"
            local quote_count=$(( ${#value} - ${#stripped_quotes} ))
            if [[ $quote_count -eq 2 ]]; then
               value="${value#\"}"
               value="${value%\"}"
            fi
         fi
         local config_key="${current_section}:${key}"
         local prev_val="${CONFIG["${config_key}"]+__set__}"
         if [[ "$prev_val" == "__set__" ]]; then
            local key_count
            key_count="${DUPLICATE_KEYS["${config_key}"]:-0}"
            key_count=$((key_count + 1))
            DUPLICATE_KEYS["${config_key}"]="$key_count"
         fi
         CONFIG["${config_key}"]="$value"
         # Enable multiline continuation for this key
         multiline_key="$key"
         multiline_section="$current_section"
         multiline_continuation=false
      fi
   done < "$file"
}

# Remove leading and trailing whitespace from a string.
# Parameters: $1 - string to trim
# Returns: trimmed string via stdout
trim() {
   local str="$1"
   str="${str#"${str%%[![:space:]]*}"}"
   str="${str%"${str##*[![:space:]]}"}"
   printf '%s' "$str"
}

# Display an error message to the user.
# In interactive mode, shows a whiptail dialog.
# In unattended mode, logs the error.
# Parameters: $* - message text
msg_error() {
   local msg="$*"
   if [[ "$UNATTENDED" == "true" ]]; then
      log "ERROR: $msg"
   else
      whiptail --msgbox "$msg" 8 50
   fi
}

# Validate the parsed configuration for required sections and keys.
# Parameters: none (uses global CONFIG and SECTIONS)
# Returns: 0 if valid, 1 if errors found
validate_config() {
   local errors=0

   # Check for duplicate keys within sections
   for config_key in "${!DUPLICATE_KEYS[@]}"; do
      local section="${config_key%%:*}"
      local key="${config_key#*:}"
      local count=$(( ${DUPLICATE_KEYS[$config_key]} + 1 ))
      printf '%s\n' "error: [${section}] key '${key}' has ${count} duplicates" >&2
      ((errors++))
   done

   if ! has_section "global"; then
      printf '%s\n' "error: missing required section [global]" >&2
      ((errors++))
   else
      if ! has_key "global" "description"; then
         printf '%s\n' "error: [global] missing required key 'description'" >&2
         ((errors++))
      fi
   fi

   local userinput_sections=()
   local action_sections=()
   for section in "${SECTIONS[@]}"; do
      if [[ "$section" == userinput.* ]]; then
         userinput_sections+=("$section")
      elif [[ "$section" == action.* ]]; then
         action_sections+=("$section")
      fi
   done

   if [[ ${#userinput_sections[@]} -eq 0 ]]; then
      printf '%s\n' "error: no [userinput.*] sections found" >&2
      ((errors++))
   fi

   for section in "${userinput_sections[@]}"; do
      local suffix="${section#userinput.}"
      local type="${suffix%%.*}"

      case "$type" in
         password|drives|generic|ipv4address|ipv4netmask|netinterface) ;;
         *)
            printf '%s\n' "error: [${section}] unknown userinput type '${type}'" >&2
            ((errors++))
            continue ;;
      esac

      if ! has_key "$section" "variable"; then
         printf '%s\n' "error: [${section}] missing required key 'variable'" >&2
         ((errors++))
      fi

      if ! has_key "$section" "prompt"; then
         printf '%s\n' "error: [${section}] missing required key 'prompt'" >&2
         ((errors++))
      fi

      if [[ "$type" == "drives" ]]; then
         if ! has_key "$section" "number"; then
            printf '%s\n' "error: [${section}] missing required key 'number'" >&2
            ((errors++))
         else
            local num
            num="$(get_value "$section" "number")"
            if ! [[ "$num" =~ ^[1-9][0-9]*$ ]]; then
               printf '%s\n' "error: [${section}] 'number' must be a positive integer,  \
                  got '${num}'" >&2
               ((errors++))
            fi
         fi
      fi

      if [[ "$type" == "netinterface" ]]; then
         if ! has_key "$section" "number"; then
            printf '%s\n' "error: [${section}] missing required key 'number'" >&2
            ((errors++))
         else
            local num
            num="$(get_value "$section" "number")"
            if ! [[ "$num" =~ ^[1-9][0-9]*$ ]]; then
               printf '%s\n' "error: [${section}] 'number' must be a positive integer,  \
                  got '${num}'" >&2
               ((errors++))
            fi
         fi
      fi

      if [[ "$type" == "generic" ]]; then
         if has_key "$section" "length"; then
            local length
            length="$(get_value "$section" "length")"
            if ! [[ "$length" =~ ^[1-9][0-9]*$ ]]; then
               printf '%s\n' "error: [${section}] 'length' must be a positive integer,  \
                  got '${length}'" >&2
               ((errors++))
            fi
         fi
         if has_key "$section" "type"; then
            local input_type
            input_type="$(get_value "$section" "type")"
            if [[ "$input_type" != "numeric" && "$input_type" != "any" ]]; then
               printf '%s\n' "error: [${section}] 'type' must be 'numeric' or 'any',  \
                  got '${input_type}'" >&2
               ((errors++))
            fi
         fi
      fi
   done

   for section in "${action_sections[@]}"; do
      local suffix="${section#action.}"
      local type="${suffix%%.*}"

      # Skip inactive (when=false) actions entirely: their references are
      # not validated, so a gated action may name devices/sections that
      # only exist in another variant of the config.
      if ! is_action_active "$section"; then
         continue
      fi

      if declare -F "validate_action_${type}" &>/dev/null; then
         validate_action_"${type}" "$section" || ((errors++))
      else
         printf '%s\n' "error: [${section}] unknown action type '${type}'" >&2
         ((errors++))
      fi
   done

   if [[ $errors -gt 0 ]]; then
      return 1
   fi
   return 0
}

# Shared validator for mkfs-style actions (ext4, vfat, swap) with a single
# 'drive' key. $2 is the type label for instance-name error messages.
validate_mkfs_drive() {
   local section="$1" type="$2"
   local valid=0
   validate_instance_name "$section" "$type" || ((valid++))
   validate_drive_reference "$section" "drive" || ((valid++))
   return $valid
}

validate_action_ext4() { validate_mkfs_drive "$1" ext4; }
validate_action_vfat() { validate_mkfs_drive "$1" vfat; }

# Validate a wipe action section has required keys and valid references.
# Parameters: $1 - section name
# Returns: number of errors found
validate_action_wipe() {
   local section="$1"
   local valid=0

   validate_instance_name "$section" "wipe" || ((valid++))

   if ! has_key "$section" "drives"; then
      printf '%s\n' "error: [${section}] missing required key 'drives'" >&2
      ((valid++))
   else
      local drives_val
      drives_val="$(get_value "$section" "drives")"
      local ref
      ref="$(parse_single_reference "$drives_val")" || {
         printf '%s\n' "error: [${section}] 'drives' must be a single variable reference (e.g. \
            %varname%), got '${drives_val}'" >&2
         ((valid++))
         ref=""
      }
      if [[ -n "$ref" ]]; then
         if ! validate_variable "$ref" "drives"; then
            printf '%s\n' "error: [${section}] 'drives' references variable '${ref}' which is \
               not defined by any [userinput.drives.*] section" >&2
            ((valid++))
         fi
      fi
   fi

   return $valid
}

# Validate a partition action section has required keys and valid partition entries.
# Parameters: $1 - section name
# Returns: number of errors found
validate_action_partition() {
   local section="$1" i valid=0

   validate_instance_name "$section" "partition" || ((valid++))

   if ! has_key "$section" "drives"; then
      printf '%s\n' "error: [${section}] missing required key 'drives'" >&2
      ((valid++))
   else
      local drives_val
      drives_val="$(get_value "$section" "drives")"
      local ref
      ref="$(parse_single_reference "$drives_val")" || {
         printf '%s\n' "error: [${section}] 'drives' must be a single variable reference (e.g. \
            %varname%), got '${drives_val}'" >&2
         ((valid++))
         ref=""
      }
      if [[ -n "$ref" ]]; then
         if ! validate_variable "$ref" "drives"; then
            printf '%s\n' "error: [${section}] 'drives' references variable '${ref}' which is \
               not defined by any [userinput.drives.*] section" >&2
            ((valid++))
         fi
      fi
   fi

   if has_key "$section" "type"; then
      local ptype
      ptype="$(get_value "$section" "type")"
      if [[ "$ptype" != "gpt" && "$ptype" != "mbr" ]]; then
         printf '%s\n' "error: [${section}] 'type' must be 'gpt' or 'mbr', \
            got '${ptype}'" >&2
         ((valid++))
      fi
   fi

   local part_keys=()
   for key in "${!CONFIG[@]}"; do
      local sec="${key%%:*}"
      local k="${key#*:}"
      if [[ "$sec" == "$section" ]] && [[ "$k" =~ ^part-([0-9]+)$ ]]; then
         part_keys+=("$k")
      fi
   done

   if [[ ${#part_keys[@]} -eq 0 ]]; then
      printf '%s\n' "error: [${section}] has no part-<n> entries" >&2
      ((valid++))
   fi

   local remain_count=0
   local nums=()
   for pk in "${part_keys[@]}"; do
      local num="${pk#part-}"
      nums+=("$num")

      local val
      val="$(get_value "$section" "$pk")"
      local size="${val%% *}"
      local typecode="${val##* }"

      if [[ "$size" == "remain" ]]; then
         ((remain_count++))
      elif [[ "$size" == *%* ]]; then
         # Variable reference — will be validated at runtime after expansion
         : # skip static size validation
      else
         if ! [[ "$size" =~ ^[0-9]+(\.[0-9]+)?[KMGT]B?$ ]]; then
            printf '%s\n' "error: [${section}] ${pk} has invalid size '${size}' (expected e.g. \
               1.5GB, 512MB, a %variable% reference, or 'remain')" >&2
            ((valid++))
         fi
      fi

      if ! [[ "$typecode" =~ ^[0-9A-Fa-f]{2,4}$ ]]; then
         printf '%s\n' "error: [${section}] ${pk} has invalid type code '${typecode}'" >&2
         ((valid++))
      fi
   done

   if [[ $remain_count -gt 1 ]]; then
      printf '%s\n' "error: [${section}] only one partition can use 'remain'" >&2
      ((valid++))
   fi

   if [[ $remain_count -eq 1 ]]; then
      local max_num
      IFS=$'\n' max_num=$(printf '%s\n' "${nums[@]}" | sort -n | tail -1); unset IFS
      local remain_pk=""
      for pk in "${part_keys[@]}"; do
         local val
         val="$(get_value "$section" "$pk")"
         local size="${val%% *}"
         if [[ "$size" == "remain" ]]; then
            remain_pk="$pk"
            break
         fi
      done
      local remain_num="${remain_pk#part-}"
      if [[ "$remain_num" -ne "$max_num" ]]; then
         printf '%s\n' "error: [${section}] 'remain' can only be used on the last partition \
            (part-${max_num}), but found on part-${remain_num}" >&2
         ((valid++))
      fi
   fi

   readarray -t nums <<< "$(printf '%s\n' "${nums[@]}" | sort -n)"
   for i in "${!nums[@]}"; do
      local expected=$((i + 1))
      if [[ "${nums[$i]}" -ne "$expected" ]]; then
         printf '%s\n' "error: [${section}] partition numbers must be sequential starting at 1, \
            missing part-${expected}" >&2
         ((valid++))
         break
      fi
   done

   return $valid
}

# Validate a zpool action section has required instance name and vdev references.
# Parameters: $1 - section name
# Returns: number of errors found
validate_action_zpool() {
   local section="$1"
   local valid=0

   validate_instance_name "$section" "zpool" || ((valid++))

   if ! has_key "$section" "vdev"; then
      printf '%s\n' "error: [${section}] missing required key 'vdev'" >&2
      ((valid++))
   else
      local vdev_val
      vdev_val="$(get_value "$section" "vdev")"
      local refs
      refs="$(extract_references "$vdev_val")" || {
         printf '%s\n' "error: [${section}] 'vdev' contains an unmatched '%''" >&2
         ((valid++))
      }
      if [[ $valid -eq 0 ]]; then
         while IFS= read -r ref; do
            [[ -z "$ref" ]] && continue
            if [[ "$ref" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)\[([0-9]+)\]([0-9]+)$ ]]; then
               local varname="${BASH_REMATCH[1]}"
               if ! validate_variable "$varname" "drives"; then
                  printf '%s\n' "error: [${section}] vdev references drive variable \
                     '${varname}' not defined by any [userinput.drives.*] section" >&2
                  ((valid++))
               fi
            elif [[ "$ref" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)\[([0-9]+)\]$ ]]; then
               local varname="${BASH_REMATCH[1]}"
               if ! validate_variable "$varname" "drives"; then
                  printf '%s\n' "error: [${section}] vdev references drive variable \
                     '${varname}' not defined by any [userinput.drives.*] section" >&2
                  ((valid++))
               fi
            else
               printf '%s\n' "error: [${section}] vdev reference '%${ref}%' is not a valid \
                  drive reference (expected %varname[idx]part% or %varname[idx]%)" >&2
               ((valid++))
            fi
         done <<< "$refs"

         # Validate crypt.<instance> back-reference tokens. These are literal
         # tokens (not %...% references) so extract_references skips them; scan
         # the raw value (not expanded) to avoid resolving unanswerable drive
         # refs during --validate without an answers file.
         local _tok _arr=()
         read -ra _arr <<< "$vdev_val"
         for _tok in "${_arr[@]}"; do
            if is_crypt_ref "$_tok"; then
               validate_crypt_reference "$section" "$_tok" || ((valid++))
            fi
         done
      fi
   fi

   return $valid
}

# Validate a zfs action section has required instance name and pool reference.
# Parameters: $1 - section name
# Returns: number of errors found
validate_action_zfs() {
   local section="$1"
   local valid=0

   validate_instance_name "$section" "zfs" || ((valid++))

   if ! has_key "$section" "dataset"; then
      printf '%s\n' "error: [${section}] missing required key 'dataset'" >&2
      ((valid++))
   fi

   if ! has_key "$section" "pool"; then
      printf '%s\n' "error: [${section}] missing required key 'pool'" >&2
      ((valid++))
   else
      local pool_name
      pool_name="$(get_value "$section" "pool")"
      find_zpool_section "$pool_name"
      if [[ -z "$_find_result" ]]; then
         printf '%s\n' "error: [${section}] 'pool' references '${pool_name}' which is not \
            defined by any [action.zpool.*] section" >&2
         ((valid++))
      fi
   fi

   return $valid
}

# Validate an extract action section has source, target, and valid references.
