# --- action.crypttab -----------------------------------------------------

# Validate an action.crypttab section.
# Required keys: target (root filesystem target ref), drives (space-separated
# list of crypt.<instance> back-references).
# Optional: remember (true|false, default false).
# Parameters: $1 - section name
# Returns: number of errors found
validate_action_crypttab() {
   local section="$1"
   local valid=0

   validate_instance_name "$section" "crypttab" || ((valid++))

   validate_target_reference "$section" || ((valid++))

   if ! has_key "$section" "drives"; then
      printf '%s\n' "error: [${section}] missing required key 'drives'" >&2
      ((valid++))
   else
      local drives_val _tok _arr=()
      drives_val="$(get_value "$section" "drives")"
      # Scan the raw value: drives entries are literal crypt.<instance> tokens
      # (no %...% references), and expanding would die on unanswerable refs.
      read -ra _arr <<< "$drives_val"
      local _saw_one=false
      for _tok in "${_arr[@]}"; do
         _saw_one=true
         if is_crypt_ref "$_tok"; then
            validate_crypt_reference "$section" "$_tok" || ((valid++))
         else
            printf '%s\n' "error: [${section}] 'drives' entry '${_tok}' is not a crypt reference" \
               "(expected crypt.<instance>)" >&2
            ((valid++))
         fi
      done
      if [[ "$_saw_one" == false ]]; then
         printf '%s\n' "error: [${section}] 'drives' must list at least one crypt.<instance>" \
            >&2
         ((valid++))
      fi
   fi

   if has_key "$section" "remember"; then
      local remember
      remember="$(get_value "$section" "remember")"
      if [[ "$remember" != "true" && "$remember" != "false" ]]; then
         printf '%s\n' "error: [${section}] 'remember' must be 'true' or 'false'," \
            "got '${remember}'" >&2
         ((valid++))
      fi
   fi

   return $valid
}

# Runtime sanity check for action.crypttab.
# Verifies cryptsetup/blkid availability and the target filesystem.
# Parameters: $1 - section name
# Returns: 0 if ok, 1 if dependencies missing or target unavailable
sanity_check_crypttab() {
   local section="$1"

   if ! command -v cryptsetup &>/dev/null; then
      msg_error "cryptsetup is required but not found on this system."
      return 1
   fi
   if ! command -v blkid &>/dev/null; then
      msg_error "blkid is required but not found on this system."
      return 1
   fi

   if has_key "$section" "target"; then
      local target
      target="$(get_value "$section" "target")"
      sanity_check_target_filesystem "$target" "$section" || return 1
   fi

   return 0
}

# Callback body for run_action_crypttab via with_target_mount.
# Writes /etc/crypttab with one line per crypt instance:
#   <instance>  UUID=<uuid>  none  <options>
# where <options> is 'luks,discard' (remember=false) or
# 'luks,discard,initramfs,keyscript=decrypt_keyctl' (remember=true).
# Parameters: $1 mount_point, $2 resolved_name, $3 target_type, $4 section
_do_crypttab() {
   local mount_point="$1" resolved_name="$2" target_type="$3" section="$4"

   local etc_dir="${mount_point}/etc"
   log "  Ensuring ${etc_dir} exists"
   mkdir -p "$etc_dir" || die "[${section}] failed to create ${etc_dir}"

   local crypttab_file="${etc_dir}/crypttab"
   log "  Writing ${crypttab_file}"

   local remember=false
   if has_key "$section" "remember"; then
      remember="$(get_value "$section" "remember")"
   fi
   local options
   if [[ "$remember" == "true" ]]; then
      options="luks,discard,initramfs,keyscript=decrypt_keyctl"
   else
      options="luks,discard"
   fi

   local drives_val _tok _arr=() _exp
   drives_val="$(get_value "$section" "drives")"
   expand_value "$drives_val"; _exp="$_expand_value_result"
   read -ra _arr <<< "$_exp"

   local tmpfile
   tmpfile="$(mktemp)"
   TEMP_FILES+=("$tmpfile")

   for _tok in "${_arr[@]}"; do
      if ! is_crypt_ref "$_tok"; then
         rm -f "$tmpfile"
         die "[${section}] 'drives' entry '${_tok}' is not a crypt reference"
      fi
      local instance
      instance="$(crypt_ref_instance "$_tok")"
      local crypt_section="action.crypt.${instance}"
      if ! has_key "$crypt_section" "drive"; then
         rm -f "$tmpfile"
         die "[${section}] crypt instance '${instance}' has no 'drive' key"
      fi
      local cdrive_val cdrive uuid
      cdrive_val="$(get_value "$crypt_section" "drive")"
      expand_value "$cdrive_val"; cdrive="$_expand_value_result"
      local -a _cd=()
      read -ra _cd <<< "$cdrive"
      cdrive="${_cd[0]:-}"
      if [[ -z "$cdrive" ]]; then
         rm -f "$tmpfile"
         die "[${section}] crypt instance '${instance}' 'drive' is empty"
      fi
      uuid="$(blkid -s UUID -o value "$cdrive" 2>/dev/null)"
      if [[ -z "$uuid" ]]; then
         rm -f "$tmpfile"
         die "[${section}] could not determine UUID for '${cdrive}'" \
            "(crypt instance '${instance}')"
      fi
      printf '%s\n' "${instance} UUID=${uuid} none ${options}" >> "$tmpfile"
      log "    ${instance} UUID=${uuid} none ${options}"
   done

   if ! mv "$tmpfile" "$crypttab_file"; then
      rm -f "$tmpfile"
      die "[${section}] failed to write ${crypttab_file}"
   fi
   chmod 644 "$crypttab_file" 2>/dev/null || true
}

# Write /etc/crypttab onto a target filesystem.
# Parameters: $1 - section name
run_action_crypttab() {
   local section="$1"
   local instance_name="${section#action.crypttab.}"
   if [[ "$instance_name" == "$section" ]]; then
      die "[${section}] has no instance name"
   fi

   if ! has_key "$section" "target"; then
      die "[${section}] missing required key 'target'"
   fi
   local target
   target="$(get_value "$section" "target")"

   with_target_mount "$section" "$target" "Writing /etc/crypttab on" _do_crypttab \
      || die "[${section}] failed to write /etc/crypttab"

   log "/etc/crypttab created successfully."
}

# Validate an updateinitramfs action section.
# Required key: target (filesystem action reference for the root filesystem)
# Optional keys: mountN (additional filesystems to mount inside the chroot)
#   Format: <source> <mountpoint>
#   Source can be: a target reference (e.g. zfs.boot), a %%variable%% reference,
#   or a literal /dev/ path.  Mountpoint must start with /.
validate_action_updateinitramfs() {
   local section="$1"
   local valid=0

   validate_instance_name "$section" "updateinitramfs" || ((valid++))

   validate_target_reference "$section" || ((valid++))

   # Validate mountN entries
   for key in "${!CONFIG[@]}"; do
      local sec="${key%%:*}"
      local k="${key#*:}"
      if [[ "$sec" == "$section" ]] && [[ "$k" =~ ^mount([0-9]+)$ ]]; then
         local val="${CONFIG[$key]}"
         # Value format: <source> <mountpoint>
         local source="${val%% *}"
         local mountpoint="${val#* }"

         if [[ "$source" == "$val" ]] || [[ -z "$mountpoint" ]]; then
            printf '%s\n' "error: [${section}] '${k}' must be \
               '<source> <mountpoint>', got '${val}'" >&2
            ((valid++))
            continue
         fi

         if [[ ! "$mountpoint" =~ ^/ ]]; then
            printf '%s\n' "error: [${section}] '${k}' mountpoint must start \
               with /, got '${mountpoint}'" >&2
            ((valid++))
         fi

         # Validate source
         if [[ "$source" =~ ^%[^%]+%$ ]]; then
            # Single variable reference
            local ref
            ref="$(parse_single_reference "$source")" || {
               printf '%s\n' "error: [${section}] '${k}' source '${source}' is \
                  not a valid variable reference" >&2
               ((valid++))
               ref=""
            }
            if [[ -n "$ref" ]]; then
               # Built-in references are always valid
               if [[ "$ref" != "active" ]] && [[ ! "$ref" =~ ^mac: ]] && \
                  [[ ! "$ref" =~ ^diskid: ]] && [[ ! "$ref" =~ ^disksize: ]]; then
                  # Extract base variable name from drive references
                  # e.g. drives[0]1 -> drives, nics[0] -> nics
                  local varname
                  if [[ "$ref" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)\[ ]]; then
                     varname="${BASH_REMATCH[1]}"
                  else
                     varname="$ref"
                  fi
                  if ! validate_variable "$varname"; then
                     printf '%s\n' "error: [${section}] '${k}' source \
                        references variable '${varname}' which is not defined by \
                        any [userinput.*] section" >&2
                     ((valid++))
                  fi
               fi
            fi
         elif [[ "$source" == /dev/* ]]; then
            # Literal device path - valid
            :
         else
            # Target reference (e.g., zfs.boot, ext4.system, vfat.efi)
            local source_type="${source%%.*}"
            if [[ "$source_type" != "zfs" && "$source_type" != "ext4" && \
               "$source_type" != "vfat" ]]; then
               printf '%s\n' "error: [${section}] '${k}' source '${source}' \
                  must be a target reference (zfs/ext4/vfat.type), \
                  a /dev/ path, or a %%variable%% reference" >&2
               ((valid++))
            else
               local target_section="action.${source}"
               local found=false
               local section_iter
               for section_iter in "${SECTIONS[@]}"; do
                  if [[ "$section_iter" == "$target_section" ]]; then
                     found=true
                     break
                  fi
               done
               if [[ "$found" == "false" ]]; then
                  printf '%s\n' "error: [${section}] '${k}' source '${source}' \
                     does not match any action section" >&2
                  ((valid++))
               fi
            fi
         fi
      fi
   done

   return $valid
}

# Runtime sanity check for updateinitramfs action.
# Verifies chroot is available and the target filesystem exists.
sanity_check_updateinitramfs() {
   local section="$1"

   if ! command -v chroot &>/dev/null; then
      msg_error "chroot is required but not found on this system."
      return 1
   fi

   if has_key "$section" "target"; then
      local target
      target="$(get_value "$section" "target")"
      sanity_check_target_filesystem "$target" "$section" || return 1
   fi

   # Check mountN entries for device existence and filesystem availability
   for key in "${!CONFIG[@]}"; do
      local sec="${key%%:*}"
      local k="${key#*:}"
      if [[ "$sec" == "$section" ]] && [[ "$k" =~ ^mount[0-9]+$ ]]; then
         local val="${CONFIG[$key]}"
         local source="${val%% *}"

         # Only check device existence for /dev/ paths and variable references
         # Target references are checked by sanity_check_target_filesystem
         if [[ "$source" == /dev/* ]]; then
            check_drive_ref_exists "$source" "$section" || return 1
         elif [[ "$source" =~ ^%[^%]+%$ ]]; then
            # Variable reference - only check device existence once the
            # referenced variable is answered. ANSWERS is populated by
            # collect_user_input, which runs after sanity_check in
            # interactive mode, so the check is skipped until then.
            if refs_resolvable "$source"; then
               local expanded
               expand_value "$source"; expanded="$_expand_value_result"
               if [[ -n "$expanded" ]] && [[ "$expanded" == /dev/* ]]; then
                  check_drive_ref_exists "$source" "$section" || return 1
               fi
            fi
         else
            # Target reference - check filesystem availability
            local source_type="${source%%.*}"
            sanity_check_target_filesystem "$source" "$section" || return 1
         fi
      fi
   done

   return 0
}

# Update initramfs images on a target filesystem via chroot.
run_action_updateinitramfs() {
   local section="$1"
   local instance_name="${section#action.updateinitramfs.}"
   if [[ "$instance_name" == "$section" ]]; then
      die "[${section}] has no instance name"
   fi

   if ! has_key "$section" "target"; then
      die "[${section}] missing required key 'target'"
   fi
   local target
   target="$(get_value "$section" "target")"

   local target_type="${target%%.*}"

   local mount_point
   mount_point="$(mktemp -d)"
   TEMP_DIRS+=("$mount_point")

   # Track additional mount points (not root, not pseudofs) for cleanup in
   # reverse order. Pseudofs (/proc, /sys, /sys/firmware/efi/efivars, /dev)
   # are handled by unmount_chroot_stack directly from the root path.
   local -a bind_mounts=()

   local resolved_name
   resolved_name="$(mount_target_filesystem "$target" "$mount_point")"

   case "$target_type" in
      zfs)
         log "Updating initramfs on ZFS dataset '${resolved_name}'"
         ;;
      ext4)
         log "Updating initramfs on ext4 filesystem '${resolved_name}'"
         ;;
      vfat)
         log "Updating initramfs on vfat filesystem '${resolved_name}'"
         ;;
   esac

   # Collect and sort mountN entries by number
   local -a mount_entries=()
   for key in "${!CONFIG[@]}"; do
      local sec="${key%%:*}"
      local k="${key#*:}"
      if [[ "$sec" == "$section" ]] && [[ "$k" =~ ^mount([0-9]+)$ ]]; then
         mount_entries+=("${BASH_REMATCH[1]} ${CONFIG[$key]}")
      fi
   done

   local -a sorted_mount_entries=()
   if [[ ${#mount_entries[@]} -gt 0 ]]; then
      readarray -t sorted_mount_entries <<< \
         "$(printf '%s\n' "${mount_entries[@]}" | sort -n)"
   fi

   # Mount additional filesystems
   local entry
   for entry in "${sorted_mount_entries[@]}"; do
      [[ -z "$entry" ]] && continue
      local entry_val="${entry#* }"  # Remove the index number and space
      local source="${entry_val%% *}"
      local mountpoint="${entry_val#* }"

      local sub_mount="${mount_point}${mountpoint}"

      # Ensure the mount point directory exists
      log "  Creating mount point ${sub_mount}"
      if ! mkdir -p "$sub_mount"; then
         unmount_chroot_stack "$mount_point" "${bind_mounts[@]}"
         die "[${section}] failed to create mount point ${sub_mount}"
      fi

      # Determine how to mount based on source type
      if [[ "$source" =~ ^%[^%]+%$ ]] || [[ "$source" == /dev/* ]]; then
         # Device path (possibly with variable expansion)
         local device
         expand_value "$source"; device="$_expand_value_result"

         log "  Mounting ${device} at ${sub_mount}"
         if ! mount "$device" "$sub_mount"; then
            unmount_chroot_stack "$mount_point" "${bind_mounts[@]}"
            die "[${section}] failed to mount ${device} at ${sub_mount}"
         fi
         bind_mounts+=("$sub_mount")
      else
         # Target reference (zfs/ext4/vfat)
         local sub_resolved
         sub_resolved="$(mount_target_filesystem "$source" "$sub_mount")"
         bind_mounts+=("$sub_mount")

         local mount_source_type="${source%%.*}"
         case "$mount_source_type" in
            zfs)
               log "  Mounted ZFS dataset '${sub_resolved}' at ${sub_mount}"
               ;;
            ext4)
               log "  Mounted ext4 filesystem on '${sub_resolved}' at ${sub_mount}"
               ;;
            vfat)
               log "  Mounted vfat filesystem on '${sub_resolved}' at ${sub_mount}"
               ;;
         esac
      fi
   done

   # Mount essential pseudofilesystems for chroot
   mkdir -p "${mount_point}/proc" "${mount_point}/sys" "${mount_point}/dev"

   if ! mount --bind /proc "${mount_point}/proc"; then
      unmount_chroot_stack "$mount_point" "${bind_mounts[@]}"
      die "[${section}] failed to bind-mount /proc"
   fi

   if ! mount --bind /sys "${mount_point}/sys"; then
      unmount_chroot_stack "$mount_point" "${bind_mounts[@]}"
      die "[${section}] failed to bind-mount /sys"
   fi

   if ! mount --bind /sys/firmware/efi/efivars \
      "${mount_point}/sys/firmware/efi/efivars"; then
      unmount_chroot_stack "$mount_point" "${bind_mounts[@]}"
      die "[${section}] failed to bind-mount /sys/firmware/efi/efivars"
   fi

   if ! mount --bind /dev "${mount_point}/dev"; then
      unmount_chroot_stack "$mount_point" "${bind_mounts[@]}"
      die "[${section}] failed to bind-mount /dev"
   fi

   # Run update-initramfs inside the chroot
   log "  Running: chroot ${mount_point} update-initramfs -u -k all"
   if ! chroot "$mount_point" update-initramfs -u -k all; then
      unmount_chroot_stack "$mount_point" "${bind_mounts[@]}"
      die "[${section}] update-initramfs failed"
   fi

   unmount_chroot_stack "$mount_point" "${bind_mounts[@]}"

   case "$target_type" in
      zfs)
         log "Initramfs update on ZFS dataset '${resolved_name}' complete."
         ;;
      ext4)
         log "Initramfs update on ext4 filesystem '${resolved_name}' complete."
         ;;
      vfat)
         log "Initramfs update on vfat filesystem '${resolved_name}' complete."
         ;;
   esac
}

# Validate an efibootmgr action section has drive (with partition), label, and path.
# Accepts either:
#   drive  = %varname[idx]part%  or  /dev/sda1   (single drive, partition embedded)
#   drives = %varname%           + partition = N (array of drives, one entry per drive)
# Parameters: $1 - section name
# Returns: number of errors found
validate_action_efibootmgr() {
   local section="$1"
   local valid=0

   validate_instance_name "$section" "efibootmgr" || ((valid++))

   local has_drive=false
   local has_drives=false
   if has_key "$section" "drive"; then
      has_drive=true
   fi
   if has_key "$section" "drives"; then
      has_drives=true
   fi

   if [[ "$has_drive" == true && "$has_drives" == true ]]; then
      printf '%s\n' "error: [${section}] cannot specify both 'drive' and 'drives'" >&2
      ((valid++))
   elif [[ "$has_drive" == false && "$has_drives" == false ]]; then
      printf '%s\n' "error: [${section}] missing required key 'drive' or 'drives'" >&2
      ((valid++))
   elif [[ "$has_drive" == true ]]; then
      validate_drive_reference "$section" "drive" "require_partition" || ((valid++))
      if has_key "$section" "partition"; then
         printf '%s\n' "error: [${section}] 'partition' is not allowed when 'drive' is used" >&2
         ((valid++))
      fi
   else
      # drives + partition form
      local drives_val
      drives_val="$(get_value "$section" "drives")"
      local ref
      ref="$(parse_single_reference "$drives_val")" || {
         printf '%s\n' "error: [${section}] 'drives' must be a single variable reference to a drives array (e.g. %drives%), got '${drives_val}'" >&2
         ((valid++))
         ref=""
      }
      if [[ -n "$ref" ]]; then
         if ! validate_variable "$ref" "drives"; then
            printf '%s\n' "error: [${section}] 'drives' references variable '${ref}' which is not defined by any [userinput.drives.*] section" >&2
            ((valid++))
         fi
      fi

      if ! has_key "$section" "partition"; then
         printf '%s\n' "error: [${section}] missing required key 'partition' when 'drives' is used" >&2
         ((valid++))
      else
         local partition
         partition="$(get_value "$section" "partition")"
         if ! [[ "$partition" =~ ^[1-9][0-9]*$ ]]; then
            printf '%s\n' "error: [${section}] 'partition' must be a positive integer, got '${partition}'" >&2
            ((valid++))
         fi
      fi
   fi

   if ! has_key "$section" "label"; then
      printf '%s\n' "error: [${section}] missing required key 'label'" >&2
      ((valid++))
   fi

   if ! has_key "$section" "path"; then
      printf '%s\n' "error: [${section}] missing required key 'path'" >&2
      ((valid++))
   fi

   return $valid
}

# Verify efibootmgr command availability and referenced device existence.
# Parameters: $1 - section name
# Returns: 0 if ok, 1 if efibootmgr missing or device absent
sanity_check_efibootmgr() {
   local section="$1"

   if ! command -v efibootmgr &>/dev/null; then
      msg_error "efibootmgr is required but not found on this system."
      return 1
   fi

   if has_key "$section" "drive"; then
      local drive_val
      drive_val="$(get_value "$section" "drive")"
      check_drive_ref_exists "$drive_val" "$section" "base_only" || return 1
   elif has_key "$section" "drives"; then
      local drives_val
      drives_val="$(get_value "$section" "drives")"

      # Drive references require ANSWERS to be populated; skip the device
      # existence check if any referenced variable is not yet answered.
      # ANSWERS is populated by collect_user_input, which runs after
      # sanity_check in interactive mode.
      if ! refs_resolvable "$drives_val"; then
         return 0
      fi

      local expanded
      expand_value "$drives_val"; expanded="$_expand_value_result"
      local -a drives=()
      read -ra drives <<< "$expanded"
      local drive
      for drive in "${drives[@]}"; do
         check_drive_ref_exists "$drive" "$section" "base_only" || return 1
      done
   fi

   return 0
}

# Create one or more EFI boot manager entries.
# Supports two forms:
#   drive  = %varname[idx]part%  or  /dev/sda1   (single drive)
#   drives = %varname%           + partition = N (array of drives, one entry per drive)
# When 'drives' is used, %drive% expands to the current drive path in 'label'
# and 'path'.
# Parameters: $1 - section name
run_action_efibootmgr() {
   local section="$1"

   if ! has_key "$section" "label"; then
      die "[${section}] missing required key 'label'"
   fi
   if ! has_key "$section" "path"; then
      die "[${section}] missing required key 'path'"
   fi

   local label_template
   label_template="$(get_value "$section" "label")"
   local efi_path_template
   efi_path_template="$(get_value "$section" "path")"

   local -a drives=()
   local partnum=""

   if has_key "$section" "drive"; then
      local drive_val
      drive_val="$(get_value "$section" "drive")"

      # Handle literal device path (e.g. /dev/sda1)
      if [[ "$drive_val" == /dev/* ]]; then
         partnum="$(extract_partition_number "$drive_val")"
         if [[ -z "$partnum" ]]; then
            die "[${section}] 'drive' literal path '${drive_val}' does not include a partition number"
         fi
         drives+=("$(strip_partition "$drive_val")")
      elif is_crypt_ref "$drive_val"; then
         # A LUKS mapper is a whole device with no partition number.
         local _mapper
         _mapper="$(resolve_device_token "$drive_val")"
         partnum=""
         drives+=("$_mapper")
      else
         local ref
         ref="$(parse_single_reference "$drive_val")" || \
            die "[${section}] 'drive' must be a single drive reference with partition (e.g. \
               %varname[0]1% or /dev/sda1), got '${drive_val}'"

         if ! [[ "$ref" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)\[([0-9]+)\]([0-9]+)$ ]]; then
            die "[${section}] 'drive' reference must include a partition number \
               (e.g. %varname[0]1% or /dev/sda1)"
         fi

         local varname="${BASH_REMATCH[1]}"
         local index="${BASH_REMATCH[2]}"
         partnum="${BASH_REMATCH[3]}"

         local -a drives_arr=()
         read -ra drives_arr <<< "${ANSWERS[$varname]}"
         if [[ $index -ge ${#drives_arr[@]} ]]; then
            die "drive variable '${varname}' index ${index} out of range (has ${#drives_arr[@]} \
               drive(s))"
         fi

         drives+=("${drives_arr[$index]}")
      fi
   else
      # drives + partition form
      local drives_val
      drives_val="$(get_value "$section" "drives")"
      local expanded
      expand_value "$drives_val"; expanded="$_expand_value_result"
      read -ra drives <<< "$expanded"

      partnum="$(get_value "$section" "partition")"
   fi

   # Preserve any pre-existing ANSWERS[drive] entry; we temporarily shadow
   # it with the current drive path so %drive% expands per-iteration.
   local saved_drive=""
   local had_drive=false
   if [[ -n "${ANSWERS[drive]+x}" ]]; then
      saved_drive="${ANSWERS[drive]}"
      had_drive=true
   fi

   local drive base_dev
   for drive in "${drives[@]}"; do
      base_dev="$(readlink -f "$drive")"

      # Set action-local %drive% variable for this iteration
      ANSWERS[drive]="$drive"

      local label efi_path
      expand_value "$label_template"; label="$_expand_value_result"
      expand_value "$efi_path_template"; efi_path="$_expand_value_result"

      local -a cmd=(efibootmgr --create --label "$label" --disk "$base_dev")
      if [[ -n "$partnum" ]]; then
         cmd+=(--part "$partnum")
      fi
      cmd+=(--loader "$efi_path")

      if [[ -n "$partnum" ]]; then
         log "Creating EFI boot entry '${label}' on ${base_dev} partition ${partnum}"
      else
         log "Creating EFI boot entry '${label}' on ${base_dev}"
      fi
      log "  Command: ${cmd[*]}"
      run_cmd "${cmd[@]}"
   done

   # Restore ANSWERS[drive]
   if [[ "$had_drive" == true ]]; then
      ANSWERS[drive]="$saved_drive"
   else
      unset 'ANSWERS[drive]'
   fi

   log "EFI boot entries created."
}

# Validate a password action section has user and password references.
# Parameters: $1 - section name
# Returns: number of errors found
validate_action_password() {
   local section="$1"
   local valid=0

   validate_instance_name "$section" "password" || ((valid++))

   validate_target_reference "$section" || ((valid++))

   if ! has_key "$section" "user"; then
      printf '%s\n' "error: [${section}] missing required key 'user'" >&2
      ((valid++))
   fi

   if ! has_key "$section" "password"; then
      printf '%s\n' "error: [${section}] missing required key 'password'" >&2
      ((valid++))
   else
      # Validate that the password key contains at least one variable reference
      local password_val
      password_val="$(get_value "$section" "password")"
      local refs
      refs="$(extract_references "$password_val")"
      if [[ -z "$refs" ]]; then
         printf '%s\n' "error: [${section}] 'password' must reference a userinput variable (e.g. \
            %varname%), got '${password_val}'" >&2
         ((valid++))
      else
         while IFS= read -r ref; do
            [[ -z "$ref" ]] && continue
            if ! validate_variable "$ref"; then
               printf '%s\n' "error: [${section}] 'password' references variable '${ref}' \
                  which is not defined by any [userinput.*] section" >&2
               ((valid++))
            fi
         done <<< "$refs"
      fi
   fi

   return $valid
}

# Verify openssl command and target filesystem availability for password setting.
# Parameters: $1 - section name
# Returns: 0 if ok, 1 if dependencies missing
sanity_check_password() {
   local section="$1"

   if ! command -v openssl &>/dev/null; then
      msg_error "openssl is required for password hashing" \
         "but not found on this system."
      return 1
   fi

   # Check that the target filesystem exists
   if has_key "$section" "target"; then
      local target
      target="$(get_value "$section" "target")"
      sanity_check_target_filesystem "$target" "$section" || return 1
   fi

   return 0
}

# Callback body for run_action_password via with_target_mount.
_do_password() {
   local mount_point="$1" resolved_name="$2" target_type="$3" section="$4"
      user="$5" password="$6"

   local shadow_file="${mount_point}/etc/shadow"
   local passwd_file="${mount_point}/etc/passwd"

   # Verify the user exists in /etc/passwd
   if [[ ! -f "$passwd_file" ]]; then
      die "[${section}] ${passwd_file} not found on target filesystem"
   fi

   if ! grep -q "^${user}:" "$passwd_file"; then
      die "[${section}] user '${user}' not found in ${passwd_file}"
   fi

   # Generate SHA-512 password hash
   local salt
   salt="$(openssl rand -hex 16 2>/dev/null || \
      printf '%s' "fallbacksalt${RANDOM}$(date +%s)")"
   local hash
   hash="$(openssl passwd -6 -salt "$salt" "$password")"
   if [[ -z "$hash" ]]; then
      die "[${section}] failed to generate password hash"
   fi

   if [[ ! -f "$shadow_file" ]]; then
      die "[${section}] ${shadow_file} not found on target filesystem"
   fi

   # Replace the password hash in /etc/shadow
   # The password field is field 2, lines are colon-separated
   local shadow_tmp="${shadow_file}.tmp"
   while IFS= read -r line || [[ -n "$line" ]]; do
      local shadow_user="${line%%:*}"
      if [[ "$shadow_user" == "$user" ]]; then
         local rest="${line#*:}"
         local fields_after="${rest#*:}"
         printf '%s:%s:%s\n' "$shadow_user" "$hash" "$fields_after"
      else
         printf '%s\n' "$line"
      fi
   done < "$shadow_file" > "$shadow_tmp"

   if ! mv "$shadow_tmp" "$shadow_file"; then
      rm -f "$shadow_tmp"
      die "[${section}] failed to update ${shadow_file}"
   fi

   # Preserve shadow file permissions
   chmod 640 "$shadow_file" 2>/dev/null || true

   log "  Password for '${user}' updated successfully."
}

# Set a user password on a target filesystem by modifying /etc/shadow.
run_action_password() {
   local section="$1"
   local instance_name="${section#action.password.}"
   if [[ "$instance_name" == "$section" ]]; then
      die "[${section}] has no instance name"
   fi

   if ! has_key "$section" "target"; then
      die "[${section}] missing required key 'target'"
   fi
   local target
   target="$(get_value "$section" "target")"

   if ! has_key "$section" "user"; then
      die "[${section}] missing required key 'user'"
   fi
   local user
   user="$(get_value "$section" "user")"

   if ! has_key "$section" "password"; then
      die "[${section}] missing required key 'password'"
   fi
   local password_val
   password_val="$(get_value "$section" "password")"
   local password
   expand_value "$password_val"; password="$_expand_value_result"

   with_target_mount "$section" "$target" \
      "Setting password for '${user}' on" _do_password "$user" "$password" \
      || die "[${section}] failed to set password for '${user}'"

   log "Password action for '${user}' complete."
}

# Export any imported ZFS pools whose vdevs reside on the given drives.
# This must happen before wiping so that the pools are cleanly detached
# rather than destroyed mid-operation.

# Collect all basename identifiers for a device: the real device name, the
# original name (if different), and all /dev/disk/by-id symlink names that
# resolve to it. Populates the nameref'd associative set (basenames as keys).
# ZFS vdev config can reference a drive by any of these forms.
_collect_dev_patterns() {
   local -n _cdp_set="$1"
   local dev="$2"
   local real_dev
   real_dev="$(readlink -f "$dev")"
   _cdp_set["$(basename "$real_dev")"]=1
   [[ "$dev" != "$real_dev" ]] && _cdp_set["$(basename "$dev")"]=1
   local link
   for link in /dev/disk/by-id/*; do
      [[ ! -e "$link" ]] && continue
      [[ "$(readlink -f "$link")" == "$real_dev" ]] \
         && _cdp_set["$(basename "$link")"]=1
   done
}

# Force-unmount every dataset in a ZFS pool, children before parents (zfs list
# is parent-first alphabetical; sort -r puts leaves first so unmount succeeds).
# No-op if zfs is unavailable. Used before zpool export/destroy.
_zfs_unmount_pool_datasets() {
   local pool="$1"
   command -v zfs &>/dev/null || return 0
   local ds dataset_list
   dataset_list="$(zfs list -H -o name -r "$pool" 2>/dev/null | sort -r)" || true
   while IFS= read -r ds; do
      [[ -z "$ds" ]] && continue
      run_cmd_allow_fail zfs unmount -f "$ds"
   done <<< "$dataset_list"
}

export_pools_for_drives() {
   local -a drives=("$@")

   if ! command -v zpool &>/dev/null; then
      return
   fi

   # Build a set of real device paths and by-id links for every target drive
   local -A target_devs=()
   local drive
   for drive in "${drives[@]}"; do
      _collect_dev_patterns target_devs "$drive"
   done

   local pool zpool_output
   zpool_output="$(zpool list -H -o name 2>/dev/null || true)"
   while IFS= read -r pool; do
      [[ -z "$pool" ]] && continue

      local pool_uses_target=false
      local vdevs vdev
      vdevs="$(zpool status -P "$pool" 2>/dev/null | \
         awk '/^[[:space:]]+\// {print $1}')"
      for vdev in $vdevs; do
         [[ -z "$vdev" ]] && continue
         local real_vdev
         real_vdev="$(readlink -f "$vdev" 2>/dev/null || printf '%s' "$vdev")"

         # Check direct match (drive or partition on it)
         for target_base in "${!target_devs[@]}"; do
            if [[ "$(basename "$real_vdev")" == "$target_base" ||  \
               "$(basename "$real_vdev")" == "${target_base}"[0-9]* ]]; then
               pool_uses_target=true
               break 2
            fi
            if [[ "$vdev" == *"$target_base"* ]]; then
               pool_uses_target=true
               break 2
            fi
         done
      done

      if [[ "$pool_uses_target" == "true" ]]; then
         log "Exporting ZFS pool ${pool} (uses a drive targeted for wipe)"
         _zfs_unmount_pool_datasets "$pool"
         if ! run_cmd_allow_fail zpool export -f "$pool"; then
            log "WARNING: failed to export pool ${pool}"
         fi
      fi
   done <<< "$zpool_output"
}

# Stop all MD RAID arrays found in /proc/mdstat.
# Called before wiping to ensure arrays are cleanly stopped before erasing
# component devices (similar to export_pools_for_drives for ZFS).
# Uses /proc/mdstat for discovery — the kernel's authoritative list of all MD
# arrays, including broken/degraded ones that may not appear in sysfs or mdadm.
# Two passes handle the case where stopping one array frees another (e.g. nested
# raid).
stop_md_arrays_for_drives() {
   if ! command -v mdadm &>/dev/null; then
      return
   fi

   local md_name md_dev _pass
   for _pass in 1 2; do
      local found=false
      while IFS= read -r md_name; do
         [[ -z "$md_name" ]] && continue
         md_dev="/dev/${md_name}"
         log "Stopping MD array ${md_dev}"
         run_cmd_allow_fail mdadm --stop "$md_dev"
         found=true
      done <<< "$(awk '/^md[0-9]+ /{print $1}' /proc/mdstat 2>/dev/null)"
      [[ "$found" == "true" ]] || break
   done
}

# Wipe all data structures (MD, ZFS, LVM, partition tables) from configured drives.
# Parameters: $1 - section name
run_action_wipe() {
   local section="$1"
   local drives_val
   drives_val="$(get_value "$section" "drives")"
   local expanded
   expand_value "$drives_val"; expanded="$_expand_value_result"
   local -a drives=()
   read -ra drives <<< "$expanded"

   log "Starting wipe of drives: ${drives[*]}"

   # Export any imported ZFS pools on target drives before wiping
   export_pools_for_drives "${drives[@]}"

   # Stop all MD arrays before wiping
   stop_md_arrays_for_drives

   for drive in "${drives[@]}"; do
      log "Wiping ${drive}..."

      wipe_partition_table "${drive}"
      wipe_zfs "${drive}"
      wipe_lvm "${drive}"
   done

   log "Wipe complete."
}

# Destroy ZFS pools on a device and clear ZFS labels.
# Parameters: $1 - device path
wipe_zfs() {
   local dev="$1"

   if ! command -v zpool &>/dev/null; then
      return
   fi

   # Resolve drive to its real /dev/ path (e.g. /dev/sda)
   local real_dev
   real_dev="$(readlink -f "$dev")"

   # Collect all identifiers for this drive: real path, by-id links,
   # and any partition devices on it. ZFS vdev config can reference
   # any of these forms, so we match against all of them.
   local -A dev_patterns=()
   _collect_dev_patterns dev_patterns "$dev"

   # Find and destroy pools that use this drive (or a partition on it).
   # We also collect partition /dev paths for labelclear later.
   local -a labelclear_devs=()
   labelclear_devs+=("$dev" "$real_dev")

   local pool zpool_output
   zpool_output="$(zpool list -H -o name 2>/dev/null || true)"
   while IFS= read -r pool; do
      [[ -z "$pool" ]] && continue

      local pool_uses_dev=false
      local vdevs
      vdevs="$(zpool status -P "$pool" 2>/dev/null | \
         awk '/^[[:space:]]+\// {print $1}')"
      local vdev
      for vdev in $vdevs; do
         [[ -z "$vdev" ]] && continue
         local real_vdev
         real_vdev="$(readlink -f "$vdev" 2>/dev/null || printf '%s' "$vdev")"

         # Check if vdev is the drive itself or a partition on it
         if [[ "$real_vdev" == "$real_dev" ]] || \
            [[ "$real_vdev" == "${real_dev}"[0-9]* ]]; then
            pool_uses_dev=true
            # Collect partition devices for later labelclear
            labelclear_devs+=("$real_vdev" "$vdev")
         else
            # Also match by any of the drive's identifiers (by-id, etc.)
            for pat in "${!dev_patterns[@]}"; do
               if [[ "$vdev" == *"$pat"* ]]; then
                  pool_uses_dev=true
                  break
               fi
            done
         fi
      done

      if [[ "$pool_uses_dev" == "true" ]]; then
         log "Destroying ZFS pool ${pool} (contains ${dev})"
         _zfs_unmount_pool_datasets "$pool"
         if ! run_cmd_allow_fail zpool destroy "$pool"; then
            log "WARNING: failed to destroy pool ${pool}, attempting export"
            # Export as fallback: removes the pool from the system
            # so its name can be reused, even though data remains on disk
            run_cmd_allow_fail zpool export -f "$pool"
         fi
      fi
   done <<< "$zpool_output"

   # Clear ZFS labels on the drive and all discovered partitions
   for label_dev in "${labelclear_devs[@]}"; do
      if [[ -e "$label_dev" ]]; then
         if ! run_cmd_allow_fail zpool labelclear -f "$label_dev" 2>/dev/null; then
            log "WARNING: failed to clear ZFS label on ${label_dev}"
         fi
      fi
   done
   # Use lsblk instead of shell globs: noglob environments and udev
   # timing can prevent glob expansion of /dev/disk/by-id patterns.
   local -a partitions=()
   local part
   while IFS= read -r part; do
      [[ -z "$part" ]] && continue
      partitions+=("$part")
   done <<< "$(lsblk -no PATH "${dev}" 2>/dev/null | tail -n +2)"
   for part in "${partitions[@]}"; do
      [[ -e "$part" ]] && run_cmd_allow_fail zpool labelclear -f "$part"
   done
}

# Remove LVM physical volume signatures from a device.
# Parameters: $1 - device path
wipe_lvm() {
   local dev="$1"

   if ! command -v pvs &>/dev/null; then
      return
   fi

   local basename_dev
   basename_dev="$(basename "$(readlink -f "$dev")")"

   local pv lvm_output
   lvm_output="$(pvs --noheadings -o pv_name 2>/dev/null || true)"
   while IFS= read -r pv; do
      [[ -z "$pv" ]] && continue
      if printf '%s\n' "$pv" | grep -q "$basename_dev"; then
         log "Removing LVM PV ${pv}"
         run_cmd_allow_fail pvremove -ff --yes "$pv"
      fi
   done <<< "$lvm_output"
}

# Wipe the partition table and ZFS label areas on a device.
# Parameters: $1 - device path
wipe_partition_table() {
   local dev="$1"

   # Clear ZFS labels and md superblocks on all existing partitions.
   # Use lsblk to enumerate partitions instead of shell glob patterns.
   # Shell globs are unreliable here: (1) the calling environment may
   # have noglob (set -f) active, preventing expansion, and (2) udev
   # events from earlier wipe operations may have removed /dev/disk/by-id
   # symlinks that haven't been recreated yet.
   log "Wiping partition signatures on ${dev}"
   local -a partitions=()
   local part
   while IFS= read -r part; do
      [[ -z "$part" ]] && continue
      partitions+=("$part")
   done <<< "$(lsblk -no PATH "${dev}" 2>/dev/null | tail -n +2)"

   for part in "${partitions[@]}"; do
      log "wiping partition ${part}"
      [[ -e "$part" ]] && run_cmd_allow_fail zpool labelclear -f "$part"
      [[ -e "$part" ]] && run_cmd_allow_fail mdadm --zero-superblock \
         --metadata=0.90 --force "${part}"
      [[ -e "$part" ]] && run_cmd_allow_fail mdadm --zero-superblock \
         --metadata=1.0 --force "${part}"
      [[ -e "$part" ]] && run_cmd_allow_fail mdadm --zero-superblock \
         --metadata=1.1 --force "${part}"
      [[ -e "$part" ]] && run_cmd_allow_fail mdadm \
         --zero-superblock --force "${part}"
   done
   run_cmd_allow_fail zpool labelclear -f "$dev"
   run_cmd_allow_fail mdadm --zero-superblock --force "$dev"

   log "Wiping partition table on ${dev}"
   if command -v sgdisk &>/dev/null; then
      run_cmd_allow_fail sgdisk --zap-all "${dev}"
   else
      run_cmd_allow_fail dd if=/dev/zero of="${dev}" bs=512 count=1 conv=notrunc
      local sz
      sz="$(blockdev --getsz "${dev}" 2>/dev/null || printf '%s' 0)"
      run_cmd_allow_fail dd if=/dev/zero of="${dev}" bs=512 \
         seek=$((sz - 1)) count=1 conv=notrunc
   fi

   # Wipe ZFS label areas on the whole disk (first 1MB and last 1MB).
   # sgdisk --zap-all only clears the first/last ~17KB, but ZFS labels
   # occupy up to 512KB at each end. Without clearing these, stale labels
   # from whole-disk vdevs can persist after partition table wipe.
   run_cmd_allow_fail dd if=/dev/zero of="${dev}" bs=1M count=1 conv=notrunc
   local pt_size
   pt_size="$(blockdev --getsize64 "${dev}" 2>/dev/null || printf '%s' 0)"
   if [[ "$pt_size" -gt 2097152 ]]; then
      local seek_mb=$(( pt_size / 1048576 - 1 ))
      [[ "$seek_mb" -gt 0 ]] &&  \
         run_cmd_allow_fail dd if=/dev/zero of="${dev}" bs=1M seek="$seek_mb" count=1 conv=notrunc
   fi

}

# Write a timestamped message to the log file or stdout.
# Parameters: $* - message text
log() {
   local msg
   msg="$(date '+%Y-%m-%d %H:%M:%S') $*"
   if [[ -n "$LOG_FILE" ]]; then
      printf '%s\n' "$msg" >> "$LOG_FILE"
      if [[ "$UNATTENDED" == "true" ]]; then
         printf '%s\n' "$msg" >&2
      fi
   else
      printf '%s\n' "$msg"
   fi
}

# Run a command, optionally allowing failure or redirecting stdin.
# Options:
#   --allow-fail   Don't call die() on failure; return the exit code.
#   --stdin SRC    Redirect stdin from SRC (e.g. /dev/null).
# Runs the command with logging. Dies on failure unless --allow-fail is given.
run_cmd() {
   local mode="fail" stdin_source=""
   while [[ "${1:-}" == --* ]]; do
      case "$1" in
         --allow-fail) mode="allow"; shift ;;
         --stdin)      stdin_source="$2"; shift 2 ;;
         --)           shift; break ;;
         *)            break ;;
      esac
   done

   local suffix=""
   [[ -n "$stdin_source" ]] && suffix=" < ${stdin_source}"

   local rc=0
   if [[ -n "$LOG_FILE" ]]; then
      if [[ "$UNATTENDED" == "true" ]]; then
         if [[ -n "$stdin_source" ]]; then
            "$@" < "$stdin_source" 2>&1 | tee -a "$LOG_FILE" >&2
         else
            "$@" 2>&1 | tee -a "$LOG_FILE" >&2
         fi
         rc=${PIPESTATUS[0]}
      else
         if [[ -n "$stdin_source" ]]; then
            "$@" < "$stdin_source" >> "$LOG_FILE" 2>&1 || rc=$?
         else
            "$@" >> "$LOG_FILE" 2>&1 || rc=$?
         fi
      fi
   else
      if [[ -n "$stdin_source" ]]; then
         "$@" < "$stdin_source" || rc=$?
      else
         "$@" || rc=$?
      fi
   fi
   if [[ "$mode" == "fail" && $rc -ne 0 ]]; then
      die "command failed (exit code ${rc}): $*${suffix}"
   fi
   return "$rc"
}

# Run a command but continue on failure.
# Like run_cmd but does not call die() on failure - just returns the exit code.
run_cmd_allow_fail() {
   run_cmd --allow-fail "$@"
}

# Stream URL content via curl and extract with tar.
# Redirects output to LOG_FILE when in progress mode.
run_curl_tar() {
   local source="$1"
   local mount_point="$2"
   if [[ -n "$LOG_FILE" ]]; then
      curl --silent --show-error --fail "$source" 2>>"$LOG_FILE" | tar --extract --gzip --file - \
         --directory "$mount_point" 2>>"$LOG_FILE"
   else
      curl --silent --show-error --fail "$source" | tar --extract --gzip --file - --directory \
         "$mount_point"
   fi
}

# Return a human-readable description for an action section.
action_description() {
   local section="$1"
   local suffix="${section#action.}"
   local type="${suffix%%.*}"
   local instance="${suffix#*.}"

   local idx="" i
   for i in "${!ACTION_TYPES[@]}"; do
      if [[ "${ACTION_TYPES[$i]}" == "$type" ]]; then
         idx="$i"
         break
      fi
   done
   if [[ -z "$idx" ]]; then
      printf 'Running %s (%s)' "$type" "$instance"
      return
   fi
   local tmpl="${ACTION_DESCRIPTIONS[$idx]}"
   if [[ "$tmpl" == "__zfs__" ]]; then
      local ds="$instance"
      if has_key "$section" "dataset"; then
         ds="$(get_value "$section" "dataset")"
      fi
      printf 'Creating ZFS dataset "%s"' "$ds"
   else
      local desc
      # $tmpl is a fixed template from ACTION_DESCRIPTIONS (literal text plus
      # %s), not user input — $instance may in principle contain %, so a
      # string-replace approach would corrupt the output. printf -v handles
      # both correctly.
      # shellcheck disable=SC2059
      printf -v desc "$tmpl" "$instance"
      printf '%s' "$desc"
   fi
}

# Confirm destructive actions (wipe) before starting the progress UI.
# These confirmations are shown as regular whiptail dialogs before the
# gauge takes over the terminal.
confirm_destructive_actions() {
   for section in "${SECTIONS[@]}"; do
      if [[ "$section" != action.wipe.* ]]; then
         continue
      fi
      if ! is_action_active "$section"; then
         continue
      fi

      local drives_val
      drives_val="$(get_value "$section" "drives")"
      local expanded
      expand_value "$drives_val"; expanded="$_expand_value_result"
      local -a drives=()
      read -ra drives <<< "$expanded"

      local drive_list=""
      for d in "${drives[@]}"; do
         drive_list+="  ${d}\n"
      done

      if ! whiptail --yesno "WARNING: Destructive operation!\n\nThe following drives will be \
         completely wiped:\n${drive_list}\nAll data will be lost. Continue?" 14 60; then
         die "wipe action cancelled by user"
      fi
   done
}

# Run all actions with a whiptail progress gauge displayed in the foreground.
# The actions run in a subshell that writes gauge commands to stdout, piped
# into whiptail --gauge. All action output is redirected to a log file.
# After completion the user can view the full log in a scrollable textbox.
run_actions_with_progress() {
   local total=0 section
   for section in "${SECTIONS[@]}"; do
      [[ "$section" == action.* ]] && is_action_active "$section" && ((total++))
   done
   if [[ "$total" -eq 0 ]]; then
      die "no actions to execute"
   fi

   local current=0

   for section in "${SECTIONS[@]}"; do
      if [[ "$section" != action.* ]]; then
         continue
      fi
      if ! is_action_active "$section"; then
         log "Skipping [${section}] (when condition is false)"
         continue
      fi

      local desc
      desc=$(action_description "$section")
      current=$((current + 1))
      local pct=$(( current * 100 / total ))

      whiptail --title "Installing..." --infobox \
         "Step ${current}/${total} (${pct}%):\n\n${desc}" 10 65

      dispatch_action run_action "$section"
   done
}

# --- LUKS / crypt helpers ------------------------------------------------

# Open a crypt instance (cryptsetup luksOpen) if it is not already open.
# Idempotent: once opened the instance stays open for the rest of the run
# and is closed on exit by close_created_crypt_devices (mirroring how MD
# arrays created by action.md are kept assembled until exit).
# The passphrase and underlying device are read from the matching
# [action.crypt.<instance>] section. The passphrase is fed to cryptsetup via
# a temporary key-file (mode 0600) so it never appears in argv or logs.
# Parameters: $1 - crypt instance name
# Returns: 0 on success, dies on failure
ensure_crypt_open() {
   local instance="$1"
   local mapper="/dev/mapper/${instance}"

   # Already open (e.g. by an earlier action in this run).
   if [[ -e "$mapper" ]]; then
      return 0
   fi
   # Defensive guard against re-entry while a failed open is being retried.
   if [[ -n "${OPENED_CRYPT[$instance]+x}" ]]; then
      return 0
   fi

   local section="action.crypt.${instance}"
   local s found=false
   for s in "${SECTIONS[@]}"; do
      [[ "$s" == "$section" ]] && { found=true; break; }
   done
   if [[ "$found" == false ]]; then
      die "crypt instance '${instance}' is not defined by any [action.crypt.*] section"
   fi

   if ! has_key "$section" "drive"; then
      die "[${section}] missing required key 'drive'"
   fi
   if ! has_key "$section" "passphrase"; then
      die "[${section}] missing required key 'passphrase'"
   fi

   local drive_val passphrase_val drive passphrase
   drive_val="$(get_value "$section" "drive")"
   passphrase_val="$(get_value "$section" "passphrase")"
   expand_value "$drive_val"; drive="$_expand_value_result"
   expand_value "$passphrase_val"; passphrase="$_expand_value_result"

   if [[ -z "$drive" ]]; then
      die "[${section}] 'drive' resolves to an empty device path"
   fi
   if [[ -z "$passphrase" ]]; then
      die "[${section}] 'passphrase' resolves to an empty value"
   fi

   # Write the passphrase to a temp key-file without a trailing newline so
   # cryptsetup reads it verbatim via --key-file.
   local keyfile
   keyfile="$(mktemp)"
   TEMP_FILES+=("$keyfile")
   chmod 600 "$keyfile"
   printf '%s' "$passphrase" > "$keyfile"

   log "Opening LUKS device '${instance}' (${drive})"
   run_cmd --stdin /dev/null -- cryptsetup luksOpen --key-file "$keyfile" \
      "$drive" "$instance"

   OPENED_CRYPT["$instance"]=1
   CREATED_CRYPT_DEVICES+=("$instance")
}

# Resolve a single device token to a device path. If the token is a
# 'crypt.<instance>' back-reference, the instance is opened (idempotently)
# and the mapper path /dev/mapper/<instance> is returned; otherwise the
# token is returned unchanged.
# Parameters: $1 - token (already %variable%-expanded)
# Prints: resolved device path
resolve_device_token() {
   local token="$1"
   if is_crypt_ref "$token"; then
      local instance
      instance="$(crypt_ref_instance "$token")"
      ensure_crypt_open "$instance"
      printf '%s' "/dev/mapper/${instance}"
   else
      printf '%s' "$token"
   fi
}

# Expand %variable% references in a drive value and resolve every resulting
# token, opening any crypt.<instance> back-references as needed. Returns the
# resolved device list as a space-separated string via _resolve_drive_value.
# This is the single hook all drive-keyed actions (ext4/vfat/swap/md/zpool/
# efibootmgr) use, so LUKS handling lives in exactly one place.
# Parameters: $1 - raw drive value (e.g. "%drives[0]2% crypt.root")
# Sets _resolve_drive_value with the resolved device list.
resolve_drive_value() {
   local raw="$1"
   local expanded
   expand_value "$raw"; expanded="$_expand_value_result"
   local -a tokens=() out=()
   read -ra tokens <<< "$expanded"
   local t
   for t in "${tokens[@]}"; do
      out+=("$(resolve_device_token "$t")")
   done
   _resolve_drive_value="${out[*]}"
}

# Close every LUKS instance opened during this run. Mirror of
# stop_created_md_devices; called from run_done_action on reboot/poweroff.
# Returns: 0 if all closed (or cryptsetup absent), 1 if any failed
close_created_crypt_devices() {
   if [[ ${#CREATED_CRYPT_DEVICES[@]} -eq 0 ]]; then
      return 0
   fi
   if ! command -v cryptsetup &>/dev/null; then
      return 0
   fi

   local failed=0 instance
   for instance in "${CREATED_CRYPT_DEVICES[@]}"; do
      if [[ -e "/dev/mapper/${instance}" ]]; then
         log "Closing LUKS device ${instance}..."
         if ! cryptsetup luksClose "$instance" 2>/dev/null; then
            log "WARNING: failed to close LUKS device ${instance}"
            failed=1
         fi
      fi
   done
   return $failed
}

# Resolve a drive reference (varname[idx]part) to a device path.
# Parameters: $1 - reference string (e.g. drives[0]3)
# Sets _resolve_result with the device path.
resolve_drive_ref() {
   local ref="$1"
   if [[ "$ref" =~ ^([a-zA-Z_][a-zA-Z0-9_]*)\[([0-9]+)\]([0-9]*)$ ]]; then
      local varname="${BASH_REMATCH[1]}"
      local index="${BASH_REMATCH[2]}"
      local partnum="${BASH_REMATCH[3]}"
      local -a drives_arr=()
      read -ra drives_arr <<< "${ANSWERS[$varname]}"
      if [[ $index -ge ${#drives_arr[@]} ]]; then
         _resolve_fail "drive variable '${varname}' index ${index} out of range (has ${#drives_arr[@]} \
            drive(s))" || return 1
      fi
      local dev="${drives_arr[$index]}"
      if [[ -n "$partnum" ]]; then
         if [[ "$dev" == /dev/disk/by-id/* ]]; then
            dev="${dev}-part${partnum}"
         else
            dev="${dev}${partnum}"
         fi
      fi
      _resolve_result="$dev"
   else
      _resolve_fail "invalid drive reference '${ref}' - expected format: varname[index] or \
         varname[index]partnum" || return 1
   fi
}

# Extract a parameter value from the kernel command line.
# Prints the value and returns 0 if found, returns 1 otherwise.
get_kernel_param() {
   local param="$1"
   local cmdline
   if [[ -r /proc/cmdline ]]; then
      cmdline="$(< /proc/cmdline)"
      local word
      for word in $cmdline; do
         case "$word" in
            "${param}"=*)
               printf '%s' "${word#"${param}"=}"
               return 0
               ;;
         esac
      done
   fi
   return 1
}

# Download a configuration file from a URL.
# Parameters: $1 - URL to fetch
# Sets _fetch_config_result with the temp file path (not stdout) so
# die() can exit the main process properly — calling this function via
# command substitution would otherwise trap die()'s exit inside the
# subshell, letting the caller continue with an empty result.
fetch_config() {
   local url="$1"
   local tmpfile
   tmpfile="$(mktemp)"
   TEMP_FILES+=("$tmpfile")

   if ! curl --silent --show-error --fail --output "$tmpfile" "$url"; then
      rm -f "$tmpfile"
      show_no_config_dialog "Configuration Not Found" \
         "Failed to download configuration from:\n  ${url}\n\n" \
            "Check that the URL is correct and the network is reachable."
      die "failed to fetch configuration from ${url}"
   fi

   _fetch_config_result="$tmpfile"
}

# Print usage information and exit.
usage() {
   printf '%s\n' "usage: jump [--validate] [--unattended [answers]] \
      <config-url-or-path>" >&2
   printf '%s\n' "       jump --validate <config-url-or-path>" >&2
   printf '%s\n' "         Validate config (and answers) without running actions" >&2
   printf '%s\n' "       jump --unattended [answers] <config-url>" >&2
   printf '%s\n' "          Run unattended with answers file" >&2
   printf '%s\n' "       Alternatively, set jumpconfig=<url> \
      on the kernel command line." >&2
   printf '%s\n' "       If jumpunattended=<url> is on the kernel command line," >&2
   printf '%s\n' "       unattended" >&2
   printf '%s\n' "       mode is enabled automatically (no --unattended flag needed)." >&2
   exit 1
}

# Export ZFS pools created by this script before rebooting or exiting.
# Ensures pools are in a clean state for the target OS.
# Datasets are unmounted in reverse alphabetical order (children before
# parents) because zfs unmount fails on a parent while any child is
# still mounted.
# Returns 0 if all pools were exported successfully, 1 if any failed.
export_imported_zpools() {
   if [[ ${#IMPORTED_POOLS[@]} -eq 0 ]]; then
      return 0
   fi

   if ! command -v zpool &>/dev/null; then
      return 0
   fi

   local failed=0

   local pool
   for pool in "${IMPORTED_POOLS[@]}"; do
      log "Unmounting datasets in zpool ${pool}..."
      _zfs_unmount_pool_datasets "$pool"
      log "Exporting zpool ${pool}..."
      local export_err
      export_err="$(zpool export -f "$pool" 2>&1)" || {
         log "WARNING: failed to export zpool ${pool}: ${export_err}"
         failed=1
      }

      # Verify the export actually took effect
      if [[ $failed -eq 0 ]]; then
         if zpool list "$pool" &>/dev/null; then
            log "WARNING: zpool ${pool} still visible after export, retrying..."
            export_err="$(zpool export -f "$pool" 2>&1)" || {
               log "WARNING: second export attempt failed for zpool ${pool}:" \
                  "${export_err}"
               failed=1
            }
            # Final verification
            if zpool list "$pool" &>/dev/null; then
               log "ERROR: zpool ${pool} could not be exported"
               failed=1
            fi
         fi
      fi

      # Remove the mount directory left behind after export.
      # ZFS does not remove the directory when a pool is exported.
      # Child dataset mountpoints create subdirectories under the root
      # mountpoint, so rmdir alone is insufficient - use rm -rf to remove
      # the entire tree, but guard against removing system-critical paths.
      if [[ -v "IMPORTED_POOL_MOUNTPOINTS[$pool]" ]]; then
         local mount_dir="${IMPORTED_POOL_MOUNTPOINTS[$pool]}"
         if [[ -d "$mount_dir" ]]; then
            # Safety check: refuse to remove system-critical directories.
            case "$mount_dir" in
               /|/home|/etc|/var|/usr|/bin|/sbin|/lib|/lib32|/lib64|/boot|\
               /dev|/proc|/sys|/run|/tmp|/opt|/srv|/root|/mnt|/media)
                  log "WARNING: refusing to remove system-critical mount directory" \
                     "${mount_dir} for zpool ${pool}"
                  ;;
               *)
                  log "Removing mount directory ${mount_dir}" \
                     "for exported zpool ${pool}..."
                  local rm_err
                  rm_err="$(rm -rf "$mount_dir" 2>&1)" || {
                     log "WARNING: could not remove mount directory ${mount_dir}:" \
                        "${rm_err}"
                  }
                  ;;
            esac
         fi
      fi
   done

   return $failed
}

# Stop any MD RAID devices that were created by this script.
# Called on exit alongside export_imported_zpools to clean up.
# Returns 0 if all devices were stopped successfully, 1 if any failed.
stop_created_md_devices() {
   if [[ ${#CREATED_MD_DEVICES[@]} -eq 0 ]]; then
      return 0
   fi

   if ! command -v mdadm &>/dev/null; then
      return 0
   fi

   local failed=0
   local device
   for device in "${CREATED_MD_DEVICES[@]}"; do
      if [[ -e "$device" ]]; then
         log "Stopping MD device ${device}..."
         if ! mdadm --stop "$device" 2>/dev/null; then
            log "WARNING: failed to stop MD device ${device}"
            failed=1
         fi
      else
         log "MD device ${device} no longer exists, skipping stop"
      fi
   done

   return $failed
}

# Show a specific dialog when configuration cannot be found or fetched.
# In interactive mode, displays a whiptail messagebox with details.
# In unattended/validate modes, the message is only logged by die().
# Parameters:
#   $1 - dialog title
#   $2 - dialog message (may contain \n for newlines)
show_no_config_dialog() {
   local title="$1"
   local message="$2"

   if [[ "$UNATTENDED" == "false" ]] && \
      [[ "$VALIDATE_ONLY" == "false" ]]; then
      if command -v whiptail &>/dev/null; then
         whiptail --title "$title" --msgbox "$message" 12 70
      fi
   fi
}

# Show a dialog when the configuration file contains validation errors.
# Displays the errors and offers two choices: reload the configuration
# from the same location, or exit the script.
# Returns 0 if the user chooses to reload (caller should
# re-fetch/config/parse/validate).
# Exits the script if the user chooses to exit.
show_config_error_menu() {
   local errors="$1"

   # Display the validation errors in a scrollable textbox
   local error_file
   error_file=$(mktemp)
   TEMP_FILES+=("$error_file")
   printf '%s\n' "$errors" > "$error_file"
   whiptail --title "Error in Configuration File" \
      --textbox "$error_file" 20 70
   rm -f "$error_file"

   # Offer choices to the user
   while true; do
      local choice
      choice=$(whiptail --title "Configuration Error" \
         --menu "The configuration file contains errors.\nChoose an option:" \
         10 60 2 \
         "Reload" "Reload configuration from same location" \
         "Exit"   "Exit the script" \
         3>&1 1>&2 2>&3) || continue

      case "$choice" in
         Reload) return 0 ;;
         Exit)   exit 1 ;;
      esac
   done
}

# Show completion menu after the installation process finishes.
# Presents options to view the log, reboot, or restart.
# The title indicates whether errors occurred.
show_completion_menu() {
   local title desc
   if [[ "$HAD_ERRORS" == "true" ]]; then
      title="Installation Completed with Errors"
      desc="The installation completed with errors.\nChoose an option:"
   else
      title="Installation Complete"
      desc="The installation completed successfully.\nChoose an option:"
   fi

   while true; do
      local choice
      choice=$(whiptail --title "$title" --menu "$desc" 14 50 3 \
         "1" "View log" \
         "2" "Reboot system" \
         "3" "Exit" \
         3>&1 1>&2 2>&3) || choice=""

      case "$choice" in
         1)
            if [[ -n "$LOG_FILE" ]] && [[ -f "$LOG_FILE" ]]; then
               if command -v less &>/dev/null; then
                  less -R "$LOG_FILE"
               else
                  whiptail --title "Installation Log" --textbox "$LOG_FILE" 40 100
               fi
            else
               whiptail --msgbox "No log file available." 8 40
            fi
            ;;
         2)
            if ! export_imported_zpools || ! stop_created_md_devices; then
               whiptail --msgbox \
                  "Failed to export ZFS pools or stop MD devices.\n\n"\
                  "Rebooting now could leave pools in a dirty state\n"\
                  "or MD devices active. Review the log\n"\
                  "for details and resolve the issue before rebooting." 12 65
            else
               reboot -f
            fi
            ;;
         3)
            if ! export_imported_zpools || ! stop_created_md_devices; then
               whiptail --msgbox \
                  "Failed to export ZFS pools or stop MD devices.\n\n"\
                  "Exiting now could leave pools in a dirty state\n"\
                  "or MD devices active. Review the log for details\n"\
                  "and resolve the issue before exiting." 12 65
            else
               exit 0
            fi
            ;;
      esac
   done
}

# Print a summary of the parsed configuration in validate mode.
# Shows all sections, their types, and key values.
print_config_summary() {
   printf '%s\n' ""
   printf '%s\n' "=== Configuration Summary ==="
   printf '%s\n' ""

   if has_section "global" && has_key "global" "description"; then
      printf '%s\n' "Description: $(get_value "global" "description")"
      printf '%s\n' ""
   fi

   printf '%s\n' "Sections:"
   for section in "${SECTIONS[@]}"; do
      local suffix type
      if [[ "$section" == userinput.* ]]; then
         suffix="${section#userinput.}"
         type="${suffix%%.*}"
         local variable=""
         has_key "$section" "variable" && \
            variable="$(get_value "$section" "variable")"
         printf '%s\n' "  [$section] type=${type} variable=${variable}"
      elif [[ "$section" == action.* ]]; then
         suffix="${section#action.}"
         type="${suffix%%.*}"
         local marker=""
         if ! is_action_active "$section"; then
            marker=" [inactive]"
         fi
         printf '%s\n' "  [$section] type=${type}${marker}"
      else
         printf '%s\n' "  [$section]"
      fi
   done

   printf '%s\n' ""
   printf '%s\n' "=== Validation ==="
   printf '%s\n' ""
}

# --- Unattended mode functions ---

# Load answers from the [answers] section of the parsed configuration.
# Populates the ANSWERS array with variable values from the unattended config.
# Validates that every [userinput.*] variable has a corresponding answer.
# Returns: calls die() on error
load_answers() {
   local answer_errors=0

   # Check that the [answers] section exists
   if ! has_section "answers"; then
      die "unattended config requires an [answers] section"
   fi

   for section in "${SECTIONS[@]}"; do
      if [[ "$section" != userinput.* ]]; then
         continue
      fi

      local variable
      variable="$(get_value "$section" "variable")"
      local suffix="${section#userinput.}"
      local type="${suffix%%.*}"

      # Check that the variable has a corresponding answer
      if ! has_key "answers" "$variable"; then
         log "ERROR: no answer provided for variable '${variable}'" \
            "(required by [${section}])"
         ((answer_errors++))
         continue
      fi

      local value
      value="$(get_value "answers" "$variable")"

      # Type-specific validation
      case "$type" in
         password|generic|ipv4address|ipv4netmask)
            # Scalar values
            if [[ -z "$value" ]]; then
               log "ERROR: answer for variable '${variable}' must not be empty"
               ((answer_errors++))
               continue
            fi
            # Validate IPv4 address format
            if [[ "$type" == "ipv4address" ]]; then
               if ! [[ "$value" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]]; then
                  log "ERROR: answer for variable '${variable}'" \
                     "is not a valid IPv4 address: '${value}'"
                  ((answer_errors++))
                  continue
               fi
               local valid_ip=1
               local i
               for i in 1 2 3 4; do
                  local octet="${BASH_REMATCH[$i]}"
                  octet="$((10#$octet))"
                  if (( octet > 255 )); then
                     valid_ip=0
                     break
                  fi
               done
               if [[ "$valid_ip" -eq 0 ]]; then
                  log "ERROR: answer for variable '${variable}'" \
                     "is not a valid IPv4 address: '${value}'"
                  ((answer_errors++))
                  continue
               fi
            fi
            # Validate IPv4 netmask format (CIDR prefix or dotted-decimal).
            # CIDR may be given as a bare number (24) or with a leading slash (/24).
            if [[ "$type" == "ipv4netmask" ]]; then
               if [[ "$value" =~ ^/?([0-9]+)$ ]]; then
                  local prefix=$((10#${BASH_REMATCH[1]}))
                  if (( prefix < 0 || prefix > 32 )); then
                     log "ERROR: answer for variable '${variable}'" \
                        "is not a valid CIDR prefix: '${value}'"
                     ((answer_errors++))
                     continue
                  fi
                  value="$(cidr_to_netmask "$prefix")"
               elif ! [[ "$value" =~ \
                  ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]]; then
                  log "ERROR: answer for variable '${variable}'" \
                     "is not a valid netmask: '${value}'"
                  ((answer_errors++))
                  continue
               fi
            fi
            # Validate generic length and type constraints
            if [[ "$type" == "generic" ]]; then
               if has_key "$section" "length"; then
                  local max_length
                  max_length="$(get_value "$section" "length")"
                  if [[ ${#value} -gt $max_length ]]; then
                     log "ERROR: answer for variable '${variable}'" \
                        "exceeds maximum length ${max_length}"
                     ((answer_errors++))
                     continue
                  fi
               fi
               if has_key "$section" "type"; then
                  local input_type
                  input_type="$(get_value "$section" "type")"
                  if [[ "$input_type" == "numeric" ]] && \
                     ! [[ "$value" =~ ^[0-9]+$ ]]; then
                     log "ERROR: answer for variable '${variable}' must be numeric"
                     ((answer_errors++))
                     continue
                  fi
               fi
            fi
            ANSWERS["$variable"]="$value"
            ;;
         drives)
            # Space-separated device paths, which may include
            # %diskid:...% or %disksize:...% references
            # Resolve references first, then split and validate/adjust count
            local resolved_drives_raw
            expand_value "$value"; resolved_drives_raw="$_expand_value_result"
            local -a drives=()
            read -ra drives <<< "$resolved_drives_raw"
            local required_num
            required_num="$(get_value "$section" "number")"
            if [[ ${#drives[@]} -lt "$required_num" ]]; then
               log "ERROR: answer for variable '${variable}'" \
                  "requires ${required_num} drive(s), got ${#drives[@]}"
               ((answer_errors++))
               continue
            fi
            if [[ ${#drives[@]} -gt "$required_num" ]]; then
               log "NOTE: answer for variable '${variable}'" \
                  "resolved to ${#drives[@]} drive(s), trimming to ${required_num}"
               local -a trimmed=()
               local i
               for (( i=0; i<required_num; i++ )); do
                  trimmed+=("${drives[$i]}")
               done
               drives=("${trimmed[@]}")
            fi
            ANSWERS["$variable"]="${drives[*]}"
            ;;
         netinterface)
            # Space-separated interface names, which may include
            # %active% or %mac:XX:XX:XX:XX:XX:XX% references
            # Resolve references first, then split and validate/adjust count
            local resolved_nics_raw
            expand_value "$value"; resolved_nics_raw="$_expand_value_result"
            local -a nics=()
            read -ra nics <<< "$resolved_nics_raw"
            local required_num
            required_num="$(get_value "$section" "number")"
            if [[ ${#nics[@]} -lt "$required_num" ]]; then
               log "ERROR: answer for variable '${variable}'" \
                  "requires ${required_num} interface(s), got ${#nics[@]}"
               ((answer_errors++))
               continue
            fi
            if [[ ${#nics[@]} -gt "$required_num" ]]; then
               log "NOTE: answer for variable '${variable}'" \
                  "resolved to ${#nics[@]} interface(s), trimming to ${required_num}"
               local -a trimmed=()
               local i
               for (( i=0; i<required_num; i++ )); do
                  trimmed+=("${nics[$i]}")
               done
               nics=("${trimmed[@]}")
            fi
            ANSWERS["$variable"]="${nics[*]}"
            ;;
         *)
            log "ERROR: unknown userinput type '${type}' for variable '${variable}'"
            ((answer_errors++))
            ;;
      esac
   done

   if [[ $answer_errors -gt 0 ]]; then
      die "unattended mode: ${answer_errors} error(s) in answers"
   fi
}

# Validate the [done] section of an unattended configuration.
# Checks that 'action' is present and valid, and that 'failaction' and
# 'feedback' are valid if specified.
# Returns: number of errors found
validate_done_section() {
   local errors=0

   if ! has_section "done"; then
      printf '%s\n' "error: unattended config requires a [done] section" >&2
      ((errors++))
      return $errors
   fi

   if ! has_key "done" "action"; then
      printf '%s\n' "error: [done] missing required key 'action'" >&2
      ((errors++))
   else
      local action
      action="$(get_value "done" "action")"
      if [[ "$action" != "reboot" ]] && \
         [[ "$action" != "poweroff" ]] && \
         [[ "$action" != "wait" ]]; then
         printf '%s\n' "error: [done] 'action' invalid: '${action}' (use reboot/poweroff/wait)" >&2
         ((errors++))
      fi
   fi

   if has_key "done" "failaction"; then
      local failaction
      failaction="$(get_value "done" "failaction")"
      if [[ "$failaction" != "reboot" ]] && \
         [[ "$failaction" != "poweroff" ]] && \
         [[ "$failaction" != "wait" ]]; then
         printf '%s\n' "error: [done] 'failaction' invalid: '${failaction}' (use reboot/poweroff/wait)" >&2
         ((errors++))
      fi
   fi

   # feedback is optional; if specified, validate it's non-empty
   if has_key "done" "feedback"; then
      local feedback
      feedback="$(get_value "done" "feedback")"
      if [[ -z "$feedback" ]]; then
         printf '%s\n' "error: [done] 'feedback' must be a path to an executable script" \
            >&2
         ((errors++))
      fi
   fi

   return $errors
}

# Execute the feedback script with parameters about the run result.
# Parameters: $1 - status ("success" or "failure")
# The script receives: configfile url/path, answersfile url/path,
# status, logfile path
# Does not abort on feedback script failure.
run_feedback() {
   local status="$1"

   if [[ -z "$DONE_FEEDBACK" ]]; then
      return 0
   fi

   log "Running feedback script: $DONE_FEEDBACK"

   if [[ ! -x "$DONE_FEEDBACK" ]]; then
      log "WARNING: feedback script '$DONE_FEEDBACK' is not executable"
      return 1
   fi

   local rc=0
   "$DONE_FEEDBACK" "$CONFIG_URL" "$UNATTENDED_FILE" "$status" "$LOG_FILE" || rc=$?
   if [[ $rc -ne 0 ]]; then
      log "WARNING: feedback script exited with code $rc"
   fi
   return 0
}

# Perform the configured done action (reboot, poweroff, or wait).
# Parameters: $1 - action name ("reboot", "poweroff", or "wait")
# If action is empty, defaults to "wait".
# Before rebooting/powering off, exports any ZFS pools created by this script.
run_done_action() {
   local action="${1:-wait}"

   case "$action" in
      reboot)
         log "Rebooting system..."
         export_imported_zpools || true
         stop_created_md_devices || true
         close_created_crypt_devices || true
         reboot -f
         ;;
      poweroff)
         log "Powering off system..."
         export_imported_zpools || true
         stop_created_md_devices || true
         close_created_crypt_devices || true
         poweroff -f
         ;;
      wait)
         printf '\n%s\n' "Fail action is wait, starting a shell." \
            "Use 'exit' or Ctrl-D when ready."
         if command -v bash &>/dev/null; then
            exec bash
         else
            exec /bin/sh
         fi
         ;;
      *)
         log "WARNING: unknown done action '${action}', defaulting to 'wait'"
         ;;
   esac
}

# Main entry point: parse arguments, fetch config, validate, and execute actions.
main() {
   local config_url=""

   while [[ $# -gt 0 ]]; do
      case "$1" in
         --validate) VALIDATE_ONLY=true; shift ;;
         --unattended)
            UNATTENDED=true; shift
            # Accept an optional argument if the next word exists and
            # doesn't start with -- (i.e. it's a value, not a flag).
            # This allows: --unattended answers.cfg config.cfg
            # as well as: --unattended (uses jumpunattended= from cmdline)
            if [[ $# -gt 0 ]] && [[ "$1" != --* ]]; then
               UNATTENDED_FILE="$1"; shift
            fi
            ;;
         -*) usage ;;
         *) config_url="$1"; shift ;;
      esac
   done

   # Auto-detect unattended mode from kernel command line if not already set.
   if [[ "$UNATTENDED" == "false" ]]; then
      local kernel_unattended
      kernel_unattended="$(get_kernel_param "jumpunattended")" || \
         kernel_unattended=""
      if [[ -n "$kernel_unattended" ]]; then
         UNATTENDED=true
         UNATTENDED_FILE="$kernel_unattended"
      fi
   fi

   if [[ "$UNATTENDED" == "true" ]] && [[ -z "$UNATTENDED_FILE" ]]; then
      UNATTENDED_FILE="$(get_kernel_param "jumpunattended")" || UNATTENDED_FILE=""
      if [[ -z "$UNATTENDED_FILE" ]]; then
         die "--unattended requires an answers file: pass as argument or" \
            "set jumpunattended=<url> on the kernel command line"
      fi
   fi

   if [[ -z "$config_url" ]]; then
      config_url="$(get_kernel_param "jumpconfig")" || config_url=""
      if [[ -z "$config_url" ]]; then
         show_no_config_dialog "No Configuration Found" \
            "No configuration URL was provided.\n\nPass a configuration URL" \
               "as an argument or set jumpconfig=<url> on the kernel command line."
         die "no config URL provided: pass as argument or set jumpconfig=<url> on the \
            kernel command line"
      fi
   fi

   CONFIG_URL="$config_url"

   # --- Validate mode ---
   if [[ "$VALIDATE_ONLY" == "true" ]]; then
      # Clean up fetched temp files on exit. URL configs, URL includes,
      # and inject_starturl all write to TEMP_FILES; without this trap
      # they would leak. No filesystems are mounted in validate mode, so
      # cleanup only removes temp files.
      trap cleanup EXIT

      # Fetch the main config if it's a URL; otherwise use the local
      # file directly. Mirrors the run path so URL configs and their
      # URL includes can be validated. fetch_config sets
      # _fetch_config_result (not stdout) so die() on a fetch failure
      # exits this process rather than a command-substitution subshell.
      local config_file
      if [[ -f "$config_url" ]]; then
         config_file="$config_url"
      else
         if ! command -v curl &>/dev/null; then
            die "curl is required to fetch a URL config but was not found"
         fi
         fetch_config "$config_url"
         config_file="$_fetch_config_result"
      fi

      # Inject [var.starturl]/[var.startbaseurl] for URL-fetched configs
      # so %starturl%/%startbaseurl% references (including in include
      # paths) resolve during validation. No-op for local files.
      inject_starturl "$config_file" "$config_url"
      config_file="$_inject_starturl_result"

      process_includes "$config_file"
      parse_ini "$_process_includes_result"

      # If --unattended is also specified, parse the answers file before
      # processing user variables, so that var references in answers are
      # expanded correctly.
      if [[ "$UNATTENDED" == "true" ]]; then
         local unattended_file="$UNATTENDED_FILE"
         if [[ ! -f "$unattended_file" ]]; then
            if ! command -v curl &>/dev/null; then
               die "curl is required to fetch a URL answers file but was not found"
            fi
            fetch_config "$UNATTENDED_FILE"
            unattended_file="$_fetch_config_result"
         fi

         # Parse the unattended answers file (appending to existing CONFIG/SECTIONS)
         parse_ini "$unattended_file"
      fi

      # Expand user-defined variables from [var.name] sections
      # before validation so references are resolved
      process_user_vars

      print_config_summary
      if ! validate_config; then
         exit 1
      fi

      # If --unattended is also specified, validate the answers file too
      if [[ "$UNATTENDED" == "true" ]]; then
         # Validate the [done] section
         if ! validate_done_section; then
            exit 1
         fi

         # Validate that answers cover all userinput variables
         local answer_errors=0
         for section in "${SECTIONS[@]}"; do
            if [[ "$section" != userinput.* ]]; then
               continue
            fi
            local variable
            variable="$(get_value "$section" "variable")"
            if ! has_key "answers" "$variable"; then
               printf '%s\n' "error: no answer provided for variable '${variable}' \
                  (required by [${section}])" >&2
               ((answer_errors++))
            fi
         done

         if [[ $answer_errors -gt 0 ]]; then
            exit 1
         fi

         printf '%s\n' "Configuration and answers are valid."
      else
         printf '%s\n' "Configuration is valid."
      fi
      exit 0
   fi

   readonly VALIDATE_ONLY UNATTENDED

   # --- Set up logging (before any execution that may call die/log) ---
   LOG_FILE="${TMPDIR:-/tmp}/jump-$(date '+%Y%m%d-%H%M%S').log"
   readonly LOG_FILE
   trap cleanup EXIT
   # In unattended mode, keep the log file after exit for diagnostics.
   if [[ "$UNATTENDED" == "false" ]]; then
      TEMP_FILES+=("$LOG_FILE")
   fi

   if [[ $EUID -ne 0 ]]; then
      die "must run as root"
   fi

   check_deps

   # --- Fetch and parse the unattended answers file (if applicable) ---
   # Parse before main config processing so the [done] section (failaction)
   # is available if die() is called during config fetching, include
   # resolution, or validation.
   if [[ "$UNATTENDED" == "true" ]]; then
      local unattended_file
      if [[ -f "$UNATTENDED_FILE" ]]; then
         unattended_file="$UNATTENDED_FILE"
      else
         fetch_config "$UNATTENDED_FILE"
         unattended_file="$_fetch_config_result"
      fi

      parse_ini "$unattended_file"

      if [[ ! -f "$UNATTENDED_FILE" ]]; then
         rm -f "$unattended_file"
      fi

      # Validate and store the [done] section
      if ! validate_done_section; then
         die "unattended answers [done] section validation failed"
      fi

      DONE_FEEDBACK=""
      DONE_ACTION=""
      DONE_FAILACTION=""
      if has_key "done" "feedback"; then
         DONE_FEEDBACK="$(get_value "done" "feedback")"
      fi
      if has_key "done" "action"; then
         DONE_ACTION="$(get_value "done" "action")"
      fi
      if has_key "done" "failaction"; then
         DONE_FAILACTION="$(get_value "done" "failaction")"
      fi

      # Default failaction to 'wait' if not specified
      if [[ -z "$DONE_FAILACTION" ]]; then
         DONE_FAILACTION="wait"
      fi
   fi

   # --- Fetch and parse the main configuration ---
   local config_file
   if [[ -f "$config_url" ]]; then
      config_file="$config_url"
   else
      fetch_config "$config_url"
      config_file="$_fetch_config_result"
   fi

   inject_starturl "$config_file" "$config_url"
   config_file="$_inject_starturl_result"

   process_includes "$config_file"
   config_file="$_process_includes_result"
   parse_ini "$config_file"

   if [[ ! -f "$config_url" ]]; then
      rm -f "$config_file"
   fi

   # Expand user-defined variables from [var.name] sections.
   # Must run after parse_ini of both the answers file (if unattended) and
   # the main config, and before validate_config, so that var references
   # are resolved before validation and execution.
   process_user_vars

   if ! validate_config; then
      die "configuration validation failed"
   fi

   # --- Interactive mode ---
   if [[ "$UNATTENDED" == "false" ]]; then
      local validation_errors

      while true; do
         CONFIG=()
         SECTIONS=()
         DUPLICATE_KEYS=()

         if [[ -f "$config_url" ]]; then
            config_file="$config_url"
         else
            fetch_config "$config_url"
            config_file="$_fetch_config_result"
         fi

         inject_starturl "$config_file" "$config_url"
         config_file="$_inject_starturl_result"

         process_includes "$config_file"
         config_file="$_process_includes_result"
         parse_ini "$config_file"

         if [[ ! -f "$config_url" ]]; then
            rm -f "$config_file"
         fi

         # Expand user-defined variables from [var.name] sections
         process_user_vars

         if ! validation_errors=$(validate_config 2>&1); then
            show_config_error_menu "$validation_errors"
            continue
         fi
         break
      done

      collect_action_devices
      sanity_check
      confirm_config
      collect_user_input

      confirm_destructive_actions

      run_actions_with_progress

      show_completion_menu
      return
   fi

   # --- Unattended mode ---
   load_answers
   collect_action_devices
   sanity_check

   run_actions

   log "All actions completed successfully."
   run_feedback "success"
   run_done_action "$DONE_ACTION"
}

main "$@"
