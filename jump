# Callback body for run_action_mdadm via with_target_mount.
_do_mdadm() {
   local mount_point="$1" resolved_name="$2" target_type="$3" section="$4"

   # Ensure /etc/mdadm directory exists in the target filesystem
   local mdadm_dir="${mount_point}/etc/mdadm"
